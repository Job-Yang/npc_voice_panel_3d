ight: 24px;\n    padding: 3px 8px;\n    background: rgba(142,190,123,.09);\n    color: rgba(231,244,214,.84);\n    border: 1px solid rgba(142,190,123,.22);\n    border-radius: 7px;\n    cursor: pointer;\n    font-size: 10px;\n    font-weight: 650;\n    white-space: nowrap;\n  }\n  .tour-harvest-toggle:hover,\n  .tour-harvest-toggle[aria-expanded="true"] {\n    background: rgba(142,190,123,.17);\n    border-color: rgba(142,190,123,.46);\n    color: #f1ffe7;\n  }\n  .tour-harvest-details {\n    grid-column: 1 / -1;\n    display: none;\n    gap: 6px;\n  }\n  .tour-harvest-details.show { display: grid; }\n  .tour-stamps-list {\n    display: flex;\n    gap: 5px;\n    min-width: 0;\n    overflow: hidden;\n  }\n  .tour-stamp {\n    min-width: 0;\n    max-width: 128px;\n    padding: 3px 6px;\n    border: 1px solid rgba(255,170,100,.12);\n    border-radius: 999px;\n    background: rgba(255,170,100,.05);\n    color: rgba(232,213,176,.4);\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .tour-stamp.collected {\n    border-color: rgba(255,207,138,.28);\n    background: rgba(255,207,138,.08);\n    color: rgba(255,232,194,.86);\n  }\n  .tour-stamp.active {\n    border-color: rgba(255,119,51,.55);\n    background: rgba(255,119,51,.18);\n    color: #fff1d8;\n  }\n  .tour-receipt {\n    grid-column: 1 / -1;\n    display: none;\n    grid-template-columns: minmax(0, 1fr) auto;\n    align-items: center;\n    gap: 8px;\n    padding: 7px 8px;\n    border-top: 1px solid rgba(142,190,123,.16);\n    background: rgba(142, 190, 123, .08);\n    color: rgba(231,244,214,.86);\n    border-radius: 8px;\n  }\n  .tour-receipt.show { display: grid; }\n  .receipt-summary {\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    font-size: 11px;\n  }\n  .receipt-open {\n    min-height: 26px;\n    padding: 4px 9px;\n    background: rgba(142,190,123,.12);\n    color: #e7f4d6;\n    border: 1px solid rgba(142,190,123,.32);\n    border-radius: 7px;\n    cursor: pointer;\n    font-size: 11px;\n    white-space: nowrap;\n  }\n  .receipt-open:hover { background: rgba(142,190,123,.2); }\n  .leave-ticket {\n    grid-column: 1 / -1;\n    display: none;\n    gap: 7px;\n    padding: 7px 8px;\n    background: rgba(255,207,138,.07);\n    border: 1px solid rgba(255,207,138,.16);\n    border-radius: 8px;\n    color: rgba(255,232,194,.84);\n  }\n  .leave-ticket.show { display: grid; }\n  .leave-ticket-head {\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr);\n    align-items: center;\n    gap: 7px;\n  }\n  .leave-ticket-kicker {\n    color: #ffcf8a;\n    font-size: 10px;\n    font-weight: 650;\n    white-space: nowrap;\n  }\n  .leave-ticket-summary {\n    min-width: 0;\n    color: rgba(255,241,216,.9);\n    font-size: 11px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .leave-ticket-list {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 6px;\n  }\n  .leave-ticket-item {\n    min-width: 0;\n    display: grid;\n    gap: 3px;\n    padding: 6px 7px;\n    background: rgba(20, 14, 10, .24);\n    border: 1px solid rgba(255,170,100,.12);\n    border-radius: 7px;\n  }\n  .leave-ticket-item strong {\n    color: #d6f0bd;\n    font-size: 10px;\n    white-space: nowrap;\n  }\n  .leave-ticket-item span {\n    color: rgba(240,224,200,.74);\n    font-size: 10px;\n    line-height: 1.3;\n  }\n  .station-artifact {\n    grid-column: 1 / -1;\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr) auto;\n    align-items: center;\n    gap: 8px;\n    padding-top: 6px;\n    border-top: 1px solid rgba(255,170,100,.1);\n  }\n  .station-artifact .artifact-name {\n    color: #ffcf8a;\n    font-weight: 650;\n    white-space: nowrap;\n  }\n  .station-artifact .artifact-line {\n    min-width: 0;\n    color: rgba(240,224,200,.74);\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .artifact-actions {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    white-space: nowrap;\n  }\n  .artifact-inspect,\n  .artifact-next {\n    min-height: 26px;\n    padding: 4px 8px;\n    background: rgba(255,170,100,.08);\n    color: rgba(232,213,176,.86);\n    border: 1px solid rgba(255,170,100,.18);\n    border-radius: 7px;\n    cursor: pointer;\n    font-size: 11px;\n    white-space: nowrap;\n  }\n  .artifact-inspect {\n    color: #fff1d8;\n    border-color: rgba(255,207,138,.34);\n    background: rgba(255,119,51,.12);\n  }\n  .artifact-inspect:hover,\n  .artifact-next:hover { background: rgba(255,170,100,.16); }\n  .tour-title {\n    margin: 0;\n    white-space: nowrap;\n    font-size: 12px;\n    color: rgba(255,207,138,.88);\n  }\n  .tour-stop {\n    position: relative;\n    width: 100%;\n    min-height: 52px;\n    margin: 0;\n    display: grid;\n    grid-template-columns: 20px minmax(0, 1fr);\n    align-items: center;\n    gap: 1px 5px;\n    padding: 6px 7px;\n    background: rgba(255,170,100,.08);\n    color: #e8d5b0;\n    border: 1px solid rgba(255,170,100,.16);\n    border-radius: 8px;\n    cursor: pointer;\n    font-size: 12px;\n    text-align: left;\n  }\n  .tour-label,\n  .tour-track {\n    min-width: 0;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .tour-track {\n    grid-column: 2;\n    color: rgba(214,240,189,.62);\n    font-size: 10px;\n    line-height: 1;\n  }\n  .tour-scent {\n    grid-column: 1 / -1;\n    min-width: 0;\n    padding-top: 2px;\n    color: rgba(240,224,200,.58);\n    font-size: 10px;\n    line-height: 1.2;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .tour-stop.active .tour-scent {\n    color: rgba(255,241,216,.82);\n  }\n  .tour-stop:hover { background: rgba(255,170,100,.16); border-color: rgba(255,170,100,.38); }\n  .tour-stop.active {\n    background: rgba(255,119,51,.22);\n    border-color: rgba(255,140,70,.72);\n    color: #fff1d8;\n  }\n  .tour-stop.next:not(.active)::after {\n    content: "下一锤";\n    position: absolute;\n    top: -8px;\n    right: 6px;\n    padding: 1px 5px 2px;\n    background: rgba(20, 14, 10, .92);\n    color: #ffcf8a;\n    border: 1px solid rgba(255,207,138,.38);\n    border-radius: 999px;\n    box-shadow: 0 4px 12px rgba(0,0,0,.28);\n    font-size: 9px;\n    line-height: 1.2;\n    white-space: nowrap;\n  }\n  .tour-stop.next:not(.active) {\n    border-color: rgba(255,207,138,.5);\n    background: rgba(255,170,100,.13);\n    box-shadow: inset 0 0 0 1px rgba(255,207,138,.1);\n  }\n  .tour-stop.visited:not(.active) {\n    border-color: rgba(255,207,138,.34);\n    color: rgba(240,224,200,.9);\n  }\n  .tour-index {\n    display: inline-flex;\n    width: 20px;\n    height: 20px;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    background: rgba(255,170,100,.14);\n    color: #ffcf8a;\n    font-size: 11px;\n    font-variant-numeric: tabular-nums;\n  }\n  .tour-stop.active .tour-index { background: rgba(255,170,100,.28); }\n  .tour-stop.visited:not(.active) .tour-index {\n    background: rgba(142, 190, 123, .18);\n    color: #d6f0bd;\n  }\n  .tour-actions {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 6px;\n    margin: 0;\n  }\n  .tour-actions button {\n    min-height: 28px;\n    background: rgba(255,170,100,.08);\n    color: rgba(232,213,176,.88);\n    border: 1px solid rgba(255,170,100,.16);\n    border-radius: 7px;\n    cursor: pointer;\n    font-size: 12px;\n  }\n  .tour-actions button:hover { background: rgba(255,170,100,.16); }\n\n  /* 右下角对话气泡 */\n  .dialog {\n    position: fixed; right: 24px; bottom: 24px;\n    z-index: 29;\n    max-width: 390px; padding: 16px 20px;\n    max-height: calc(100vh - 48px);\n    overflow: auto;\n    background: rgba(20, 14, 10, .85); backdrop-filter: blur(12px);\n    border-radius: 14px; border: 1px solid rgba(255,170,100,.3);\n    box-shadow: 0 8px 32px rgba(0,0,0,.5);\n    opacity: 0; transform: translateY(20px); pointer-events: none;\n    transition: opacity .25s, transform .25s;\n  }\n  .dialog.show { opacity: 1; transform: translateY(0); pointer-events: auto; }\n  .dialog .name { font-size: 13px; font-weight: 600; color: #ff9955; margin-bottom: 6px; }\n  .dialog .meta {\n    display: none; margin: -2px 0 8px; font-size: 11px; color: rgba(240,224,200,.58);\n    letter-spacing: .3px;\n  }\n  .dialog .meta.show { display: block; }\n  .dialog .line { font-size: 14px; line-height: 1.6; color: #f0e0c8; }\n  .dialog .takeaway-mark {\n    display: none;\n    grid-template-columns: auto minmax(0, 1fr);\n    gap: 8px;\n    align-items: start;\n    margin-top: 10px;\n    padding: 8px 10px;\n    background: rgba(255,207,138,.075);\n    border: 1px solid rgba(255,207,138,.2);\n    border-radius: 8px;\n    color: rgba(255,241,216,.86);\n  }\n  .dialog .takeaway-mark.show { display: grid; }\n  .dialog .takeaway-mark strong {\n    color: #ffcf8a;\n    font-size: 11px;\n    white-space: nowrap;\n  }\n  .dialog .takeaway-mark span {\n    min-width: 0;\n    font-size: 12px;\n    line-height: 1.45;\n  }\n  .dialog .receipt-details {\n    display: none;\n    grid-template-columns: 1fr;\n    gap: 7px;\n    margin-top: 12px;\n  }\n  .dialog .receipt-details.show { display: grid; }\n  .dialog .receipt-detail {\n    display: grid;\n    grid-template-columns: auto minmax(0, 1fr);\n    gap: 7px;\n    align-items: start;\n    padding: 7px 8px;\n    background: rgba(142,190,123,.08);\n    border: 1px solid rgba(142,190,123,.18);\n    border-radius: 8px;\n  }\n  .dialog .receipt-detail strong {\n    color: #d6f0bd;\n    font-size: 11px;\n    white-space: nowrap;\n  }\n  .dialog .receipt-detail span {\n    min-width: 0;\n    color: rgba(240,224,200,.78);\n    font-size: 12px;\n    line-height: 1.45;\n  }\n  .dialog .process-steps {\n    display: none;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    gap: 6px;\n    margin-top: 12px;\n  }\n  .dialog .process-steps.show { display: grid; }\n  .dialog .process-step {\n    min-height: 30px;\n    padding: 5px 6px;\n    background: rgba(255,170,100,.08);\n    color: rgba(232,213,176,.86);\n    border: 1px solid rgba(255,170,100,.18);\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 12px;\n  }\n  .dialog .process-step:hover { background: rgba(255,170,100,.16); }\n  .dialog .process-step.active {\n    color: #fff1d8;\n    background: rgba(255,119,51,.24);\n    border-color: rgba(255,140,70,.72);\n  }\n  .dialog .actions { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }\n  .dialog .actions button {\n    flex: 1 1 42%; padding: 6px 10px; font-size: 12px;\n    background: rgba(255,170,100,.12); color: #e8d5b0;\n    border: 1px solid rgba(255,170,100,.3); border-radius: 6px; cursor: pointer;\n  }\n  .dialog .actions button:hover { background: rgba(255,170,100,.25); }\n  .dialog .actions button.ghost { flex-basis: auto; opacity: .72; }\n\n  /* Hover 名字标签 */\n  .hover-label {\n    position: fixed; padding: 4px 10px;\n    background: rgba(20, 14, 10, .9); color: #ffaa66;\n    border-radius: 6px; font-size: 12px;\n    pointer-events: none; transform: translate(-50%, -130%);\n    border: 1px solid rgba(255,170,100,.3);\n    opacity: 0; transition: opacity .15s;\n    white-space: nowrap;\n  }\n  .hover-label.show { opacity: 1; }\n\n  .station-pin {\n    position: fixed;\n    z-index: 17;\n    min-width: 118px;\n    max-width: min(220px, calc(100vw - 32px));\n    padding: 7px 10px 8px;\n    background: rgba(20, 14, 10, .82);\n    color: #fff1d8;\n    border: 1px solid rgba(var(--station-accent-rgb), .34);\n    border-radius: 8px;\n    box-shadow: 0 8px 22px rgba(0,0,0,.34), 0 0 16px rgba(var(--station-soft-rgb), .18);\n    backdrop-filter: blur(10px);\n    pointer-events: none;\n    opacity: 0;\n    transform: translate(-50%, -120%);\n    transition: opacity .18s, transform .18s;\n  }\n  .station-pin.show {\n    opacity: 1;\n    transform: translate(-50%, -135%);\n  }\n  .station-pin::after {\n    content: "";\n    position: absolute;\n    left: 50%;\n    bottom: -6px;\n    width: 10px;\n    height: 10px;\n    background: rgba(20, 14, 10, .82);\n    border-right: 1px solid rgba(var(--station-accent-rgb), .34);\n    border-bottom: 1px solid rgba(var(--station-accent-rgb), .34);\n    transform: translateX(-50%) rotate(45deg);\n  }\n  .station-pin .pin-step {\n    display: block;\n    margin-bottom: 2px;\n    color: rgba(var(--station-accent-rgb), .78);\n    font-size: 10px;\n    font-variant-numeric: tabular-nums;\n  }\n  .station-pin .pin-title {\n    display: block;\n    color: #fff1d8;\n    font-size: 13px;\n    font-weight: 650;\n    line-height: 1.25;\n    white-space: nowrap;\n  }\n  .station-pin .pin-line {\n    display: block;\n    margin-top: 3px;\n    color: rgba(240,224,200,.68);\n    font-size: 10px;\n    line-height: 1.25;\n  }\n\n  .station-hotspot {\n    position: fixed;\n    z-index: 16;\n    min-width: 74px;\n    min-height: 30px;\n    display: inline-grid;\n    grid-template-columns: 18px auto;\n    align-items: center;\n    gap: 5px;\n    padding: 5px 8px;\n    background: rgba(20, 14, 10, .72);\n    color: rgba(240,224,200,.82);\n    border: 1px solid rgba(255,170,100,.22);\n    border-radius: 8px;\n    box-shadow: 0 6px 18px rgba(0,0,0,.28);\n    backdrop-filter: blur(8px);\n    cursor: pointer;\n    pointer-events: none;\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(.96);\n    transition: opacity .18s, transform .18s, background .18s, border-color .18s, color .18s;\n  }\n  .station-hotspot.show {\n    opacity: .84;\n    pointer-events: auto;\n    transform: translate(-50%, -50%) scale(1);\n  }\n  .station-hotspot:hover,\n  .station-hotspot:focus-visible {\n    opacity: 1;\n    color: #fff1d8;\n    background: rgba(42, 24, 14, .88);\n    border-color: rgba(255,207,138,.58);\n    transform: translate(-50%, -50%) scale(1.04);\n  }\n  .station-hotspot.active {\n    opacity: 1;\n    color: #fff1d8;\n    background: rgba(var(--station-soft-rgb), .22);\n    border-color: rgba(var(--station-accent-rgb), .72);\n    box-shadow: 0 8px 22px rgba(0,0,0,.34), 0 0 18px rgba(var(--station-soft-rgb), .24);\n  }\n  .station-hotspot.next:not(.active) {\n    opacity: .96;\n    color: var(--station-accent);\n    border-color: rgba(var(--station-accent-rgb), .58);\n    background: rgba(var(--station-deep-rgb), .84);\n    box-shadow: 0 8px 22px rgba(0,0,0,.32), 0 0 16px rgba(var(--station-accent-rgb), .18);\n  }\n  .station-hotspot.next:not(.active)::after {\n    content: "下一锤";\n    position: absolute;\n    left: 50%;\n    top: -18px;\n    transform: translateX(-50%);\n    padding: 1px 5px 2px;\n    background: rgba(20, 14, 10, .9);\n    color: var(--station-accent);\n    border: 1px solid rgba(var(--station-accent-rgb), .34);\n    border-radius: 999px;\n    font-size: 9px;\n    line-height: 1.2;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n  .station-hotspot.visited:not(.active) {\n    color: rgba(231,244,214,.9);\n    border-color: rgba(142,190,123,.38);\n  }\n\n  .station-focus-halo {\n    position: fixed;\n    z-index: 15;\n    width: 112px;\n    height: 112px;\n    pointer-events: none;\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(.82);\n    transition: opacity .2s, transform .2s;\n  }\n  .station-focus-halo.show {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1);\n  }\n  .station-focus-halo .focus-ring,\n  .station-focus-halo .focus-core,\n  .station-focus-halo .focus-beam {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    transform: translate(-50%, -50%);\n  }\n  .station-focus-halo .focus-ring {\n    width: 86px;\n    height: 86px;\n    border-radius: 50%;\n    border: 1px solid rgba(var(--station-accent-rgb), .62);\n    box-shadow:\n      0 0 20px rgba(var(--station-soft-rgb), .28),\n      inset 0 0 18px rgba(var(--station-accent-rgb), .13);\n    animation: focusPulse 2.6s ease-in-out infinite;\n  }\n  .station-focus-halo .focus-core {\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: rgba(var(--station-accent-rgb), .24);\n    border: 1px solid rgba(255,239,207,.7);\n    box-shadow: 0 0 16px rgba(var(--station-accent-rgb), .38);\n  }\n  .station-focus-halo .focus-beam {\n    width: 2px;\n    height: 58px;\n    top: 8px;\n    background: linear-gradient(to bottom, rgba(var(--station-accent-rgb), 0), rgba(var(--station-accent-rgb), .48), rgba(var(--station-soft-rgb), 0));\n    border-radius: 999px;\n  }\n  .station-focus-halo .focus-label {\n    position: absolute;\n    left: 50%;\n    top: 96px;\n    transform: translateX(-50%);\n    min-width: 66px;\n    padding: 2px 7px 3px;\n    background: rgba(20, 14, 10, .82);\n    color: var(--station-accent);\n    border: 1px solid rgba(var(--station-accent-rgb), .34);\n    border-radius: 999px;\n    font-size: 10px;\n    line-height: 1.2;\n    text-align: center;\n    white-space: nowrap;\n    box-shadow: 0 6px 14px rgba(0,0,0,.28);\n  }\n  @keyframes focusPulse {\n    0%, 100% { transform: translate(-50%, -50%) scale(.94); opacity: .66; }\n    50% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }\n  }\n  .station-hotspot .hotspot-index {\n    display: inline-flex;\n    width: 18px;\n    height: 18px;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    background: rgba(255,170,100,.16);\n    color: #ffcf8a;\n    font-size: 10px;\n    font-variant-numeric: tabular-nums;\n  }\n  .station-hotspot.active .hotspot-index {\n    background: rgba(255,207,138,.24);\n    color: #fff1d8;\n  }\n  .station-hotspot.visited:not(.active) .hotspot-index {\n    background: rgba(142,190,123,.18);\n    color: #d6f0bd;\n  }\n  .station-hotspot .hotspot-title {\n    min-width: 0;\n    font-size: 11px;\n    font-weight: 650;\n    white-space: nowrap;\n  }\n\n  .tour-path {\n    position: fixed;\n    inset: 0;\n    z-index: 15;\n    width: 100vw;\n    height: 100vh;\n    pointer-events: none;\n    overflow: visible;\n  }\n  .tour-path-line {\n    stroke: rgba(255,207,138,.2);\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-dasharray: 3 8;\n    fill: none;\n  }\n  .tour-path-line.visited {\n    stroke: rgba(142,190,123,.36);\n    stroke-dasharray: 1 0;\n  }\n  .tour-path-line.next {\n    stroke: rgba(var(--station-accent-rgb), .76);\n    stroke-width: 3;\n    stroke-dasharray: 7 7;\n    filter: drop-shadow(0 0 6px rgba(var(--station-soft-rgb), .36));\n  }\n  .tour-path-node {\n    fill: rgba(20,14,10,.78);\n    stroke: rgba(255,170,100,.34);\n    stroke-width: 2;\n  }\n  .tour-path-node.visited {\n    fill: rgba(57,84,42,.88);\n    stroke: rgba(142,190,123,.72);\n  }\n  .tour-path-node.active {\n    fill: rgb(var(--station-soft-rgb));\n    stroke: #fff1d8;\n    filter: drop-shadow(0 0 8px rgba(var(--station-soft-rgb), .58));\n  }\n  .tour-path-node.next {\n    fill: var(--station-accent);\n    stroke: rgba(255,255,255,.9);\n    filter: drop-shadow(0 0 8px rgba(var(--station-accent-rgb), .5));\n  }\n  .tour-path-label {\n    fill: rgba(255,241,216,.92);\n    font-size: 10px;\n    font-weight: 650;\n    paint-order: stroke;\n    stroke: rgba(20,14,10,.9);\n    stroke-width: 3px;\n    stroke-linejoin: round;\n  }\n\n  .npc-bubble {\n    position: fixed;\n    min-width: 170px;\n    max-width: min(320px, calc(100vw - 32px));\n    padding: 12px 16px;\n    background: rgba(20, 14, 10, .92);\n    color: #f0e0c8;\n    border: 1px solid rgba(255,170,100,.48);\n    border-radius: 16px;\n    font-size: 15px;\n    font-weight: 500;\n    line-height: 1.5;\n    letter-spacing: .2px;\n    text-align: center;\n    overflow-wrap: break-word;\n    pointer-events: none;\n    transform: translate(-50%, -120%);\n    opacity: 0;\n    transition: opacity .18s, transform .18s;\n    box-shadow: 0 10px 28px rgba(0,0,0,.45), 0 0 18px rgba(255,150,70,.18);\n    z-index: 30;\n  }\n  .npc-bubble::after {\n    content: "";\n    position: absolute;\n    left: 50%;\n    bottom: -7px;\n    width: 14px;\n    height: 14px;\n    background: rgba(20, 14, 10, .92);\n    border-right: 1px solid rgba(255,170,100,.48);\n    border-bottom: 1px solid rgba(255,170,100,.48);\n    transform: translateX(-50%) rotate(45deg);\n  }\n  .npc-bubble.show {\n    opacity: 1;\n    transform: translate(-50%, -135%);\n  }\n\n  /* 底部操作提示 */\n  .hint {\n    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);\n    font-size: 12px; opacity: .5; pointer-events: none;\n  }\n\n  /* 加载遮罩 */\n  .loader {\n    position: fixed; inset: 0; background: #0d0905;\n    display: flex; align-items: center; justify-content: center;\n    flex-direction: column; gap: 16px; z-index: 100;\n    transition: opacity .5s;\n  }\n  .loader.hide { opacity: 0; pointer-events: none; }\n  .loader .spinner {\n    width: 40px; height: 40px;\n    border: 3px solid rgba(255,170,100,.2);\n    border-top-color: #ff7733;\n    border-radius: 50%;\n    animation: spin 1s linear infinite;\n  }\n  .loader .text { font-size: 13px; color: #ffaa66; }\n  @keyframes spin { to { transform: rotate(360deg); } }\n\n  @media (prefers-reduced-motion: reduce) {\n    .loader .spinner {\n      animation: none;\n    }\n  }\n  .motion-reduced .loader .spinner {\n    animation: none;\n  }\n  .motion-reduced .station-pin,\n  .motion-reduced .station-focus-halo,\n  .motion-reduced .station-hotspot,\n  .motion-reduced .tour-path-line,\n  .motion-reduced .tour-path-node,\n  .motion-reduced .npc-bubble,\n  .motion-reduced .dialog,\n  .motion-reduced .panel,\n  .motion-reduced .tour-progress-fill {\n    transition-duration: .01ms;\n  }\n  .motion-reduced .station-hotspot:hover,\n  .motion-reduced .station-hotspot:focus-visible,\n  .motion-reduced .station-hotspot.show,\n  .motion-reduced .station-hotspot.active,\n  .motion-reduced .station-hotspot.next:not(.active) {\n    transform: translate(-50%, -50%) scale(1);\n  }\n  .motion-reduced .station-focus-halo .focus-ring {\n    animation: none;\n    opacity: .82;\n    transform: translate(-50%, -50%) scale(1);\n  }\n  .motion-reduced .station-pin.show,\n  .motion-reduced .npc-bubble.show {\n    transform: translate(-50%, -130%);\n  }\n\n  @media (max-width: 640px) {\n    .topbar {\n      top: 10px;\n      width: calc(100vw - 24px);\n      justify-content: center;\n      padding: 8px 12px;\n      gap: 8px;\n      font-size: 12px;\n      white-space: nowrap;\n    }\n    .topbar .tagline {\n      max-width: 48vw;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      padding-left: 8px;\n      font-size: 10px;\n    }\n    .panel-toggle,\n    .motion-toggle,\n    .mode-toggle,\n    .bgm-toggle {\n      min-height: 40px;\n      padding: 0 10px;\n      justify-content: center;\n      border-radius: 10px;\n      font-size: 12px;\n      white-space: nowrap;\n    }\n    .panel-toggle {\n      top: 54px;\n      left: 12px;\n      max-width: calc(100vw - 120px);\n    }\n    .bgm-toggle {\n      top: 54px;\n      right: 12px;\n      min-width: 78px;\n    }\n    .mode-toggle {\n      top: 98px;\n      right: 12px;\n      min-width: 86px;\n    }\n    .motion-toggle {\n      top: 98px;\n      left: 12px;\n      right: auto;\n      min-width: 82px;\n    }\n    .sound-status {\n      top: 142px;\n      right: 12px;\n      left: 12px;\n      max-width: none;\n      padding: 6px 8px;\n      font-size: 10px;\n    }\n    .panel { top: 174px; left: 12px; max-width: calc(100vw - 24px); }\n    .tour-rail {\n      left: 12px;\n      right: 12px;\n      bottom: 58px;\n      transform: none;\n      width: auto;\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n      gap: 6px;\n      padding: 8px;\n    }\n    .tour-title { display: none; }\n    .first-guide {\n      min-height: 34px;\n      grid-template-columns: auto 1fr auto;\n      gap: 5px 7px;\n      padding: 5px 6px;\n      font-size: 10px;\n    }\n    .first-guide-text {\n      grid-column: 1 / -1;\n      white-space: normal;\n      line-height: 1.3;\n    }\n    .first-guide-start,\n    .first-guide-skip {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .station-cue {\n      min-height: 36px;\n      grid-template-columns: auto 1fr auto auto auto;\n      gap: 4px 8px;\n      padding: 5px 6px 7px;\n      font-size: 11px;\n    }\n    .station-cue .station-line {\n      grid-column: 1 / -1;\n      white-space: normal;\n      line-height: 1.35;\n    }\n    .station-details-toggle {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .tour-slate-toggle {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .view-home-button {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .station-brief {\n      grid-template-columns: 1fr;\n      gap: 4px;\n      padding-top: 5px;\n    }\n    .station-brief-item {\n      padding: 5px 6px;\n    }\n    .station-brief-text {\n      font-size: 10px;\n      white-space: normal;\n      line-height: 1.25;\n    }\n    .station-action {\n      grid-template-columns: 1fr;\n      gap: 5px;\n      padding: 6px;\n    }\n    .station-action-hint {\n      white-space: normal;\n      font-size: 10px;\n    }\n    .station-action-button {\n      width: 100%;\n      min-height: 26px;\n      padding: 4px 8px;\n      font-size: 10px;\n    }\n    .station-thread {\n      grid-template-columns: auto 1fr;\n      gap: 4px 6px;\n      padding: 5px 6px;\n    }\n    .station-thread-trail {\n      gap: 3px;\n    }\n    .thread-mark {\n      padding: 2px 4px;\n      font-size: 9px;\n    }\n    .station-thread-focus {\n      grid-column: 1 / -1;\n      white-space: normal;\n      line-height: 1.25;\n      font-size: 10px;\n    }\n    .forge-beat {\n      grid-template-columns: 1fr;\n      gap: 5px;\n    }\n    .forge-beat-card {\n      grid-template-columns: auto 1fr;\n      padding: 5px 6px;\n    }\n    .forge-beat-text {\n      white-space: normal;\n      line-height: 1.25;\n      font-size: 10px;\n    }\n    .forge-echo {\n      grid-template-columns: auto 1fr;\n      gap: 4px 6px;\n      padding: 5px 6px;\n    }\n    .forge-echo-line,\n    .forge-echo-next {\n      white-space: normal;\n      line-height: 1.25;\n      font-size: 10px;\n    }\n    .forge-echo-next {\n      grid-column: 1 / -1;\n    }\n    .station-relay {\n      gap: 5px;\n      padding: 5px 6px;\n    }\n    .station-relay-text {\n      white-space: normal;\n      font-size: 10px;\n      line-height: 1.25;\n    }\n    .station-progress {\n      grid-template-columns: auto 1fr;\n      gap: 5px 8px;\n      font-size: 10px;\n    }\n    .tour-next-cue {\n      grid-column: 1 / -1;\n      white-space: normal;\n      line-height: 1.25;\n    }\n    .tour-gains {\n      grid-template-columns: 1fr;\n      gap: 4px;\n    }\n    .tour-gains-list {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 4px;\n    }\n    .tour-gain {\n      max-width: none;\n      padding: 4px 6px;\n      font-size: 10px;\n    }\n    .tour-stamps {\n      grid-template-columns: 1fr auto;\n      gap: 4px;\n      padding: 6px;\n    }\n    .tour-stamps-label {\n      align-self: center;\n    }\n    .tour-stamps-current {\n      grid-column: 1 / -1;\n      white-space: normal;\n    }\n    .tour-harvest-toggle {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .tour-stamps-list {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 4px;\n    }\n    .tour-stamp {\n      max-width: none;\n      padding: 3px 6px;\n      font-size: 10px;\n    }\n    .tour-receipt {\n      grid-template-columns: 1fr auto;\n      gap: 5px 8px;\n      padding: 6px;\n    }\n    .leave-ticket {\n      gap: 5px;\n      padding: 6px;\n    }\n    .leave-ticket-head {\n      grid-template-columns: 1fr;\n      gap: 3px;\n    }\n    .leave-ticket-summary {\n      white-space: normal;\n      line-height: 1.25;\n      font-size: 10px;\n    }\n    .leave-ticket-list {\n      grid-template-columns: 1fr;\n      gap: 4px;\n    }\n    .leave-ticket-item {\n      padding: 5px 6px;\n    }\n    .receipt-summary {\n      white-space: normal;\n      line-height: 1.25;\n      font-size: 10px;\n    }\n    .receipt-open {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .station-artifact {\n      grid-template-columns: 1fr auto;\n      gap: 5px 8px;\n      padding-top: 5px;\n      font-size: 10px;\n    }\n    .station-artifact .artifact-line {\n      grid-column: 1 / -1;\n      white-space: normal;\n      line-height: 1.25;\n    }\n    .artifact-actions {\n      grid-row: 1;\n      grid-column: 2;\n      gap: 4px;\n    }\n    .artifact-inspect,\n    .artifact-next {\n      min-height: 24px;\n      padding: 3px 7px;\n      font-size: 10px;\n    }\n    .tour-stop {\n      min-height: 44px;\n      margin: 0;\n      grid-template-columns: 18px 1fr;\n      gap: 4px;\n      padding: 5px 6px;\n      font-size: 11px;\n    }\n    .tour-track {\n      display: none;\n    }\n    .tour-index {\n      width: 18px;\n      height: 18px;\n      font-size: 10px;\n    }\n    .tour-scent {\n      display: none;\n    }\n    .tour-actions { display: none; }\n    .dialog {\n      right: 12px;\n      top: 174px;\n      bottom: auto;\n      left: 12px;\n      max-width: none;\n      max-height: min(42vh, 260px);\n      padding: 14px 16px;\n    }\n    .dialog .process-steps {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n    .station-pin {\n      min-width: 104px;\n      max-width: 176px;\n      padding: 6px 8px 7px;\n    }\n    .station-pin .pin-title {\n      font-size: 12px;\n    }\n    .station-pin .pin-line {\n      display: none;\n    }\n    .station-hotspot {\n      min-width: 32px;\n      min-height: 30px;\n      grid-template-columns: 18px;\n      justify-content: center;\n      padding: 5px 6px;\n    }\n    .station-focus-halo {\n      width: 86px;\n      height: 86px;\n    }\n    .station-focus-halo .focus-ring {\n      width: 64px;\n      height: 64px;\n    }\n    .station-focus-halo .focus-beam {\n      height: 44px;\n    }\n    .station-focus-halo .focus-label {\n      top: 74px;\n    }\n    .station-hotspot .hotspot-title {\n      display: none;\n    }\n    .hint {\n      bottom: 10px;\n      width: calc(100vw - 24px);\n      text-align: center;\n      font-size: 10px;\n    }\n  }\n</style>\n</head>\n<body>\n<canvas id="viewer"></canvas>\n<div class="station-pin" id="stationPin" aria-live="polite">\n  <span class="pin-step" id="pinStep">第 1 站</span>\n  <strong class="pin-title" id="pinTitle">老杨</strong>\n  <span class="pin-line" id="pinLine">主人在这里</span>\n</div>\n<div class="station-focus-halo" id="stationFocusHalo" aria-hidden="true">\n  <span class="focus-beam"></span>\n  <span class="focus-ring"></span>\n  <span class="focus-core"></span>\n  <span class="focus-label" id="stationFocusLabel">身份落锤</span>\n</div>\n<div class="station-hotspots" id="stationHotspots" aria-label="铺内可点击站点"></div>\n\n<div class="loader" id="loader">\n  <div class="spinner"></div>\n  <div class="text">正在生火 · 加载铁匠铺...</div>\n</div>\n\n<div class="topbar">\n  <span class="dot"></span>\n  <span class="brand">老杨的铁匠铺</span>\n  <span class="tagline">iOS 工程师 · AI 工具匠 · iLoop</span>\n</div>\n\n<button class="panel-toggle" id="panelToggle">⚙️ 控制面板</button>\n<button class="motion-toggle" id="motionToggle" type="button" aria-pressed="false" title="降低持续动效">稳火</button>\n<button class="mode-toggle" id="modeToggle" title="场景模式">🕯️ 舒缓</button>\n<button class="bgm-toggle" id="bgmToggle" type="button" aria-pressed="false" title="背景音乐">🔇 音乐</button>\n<div class="sound-status" id="soundStatus" role="status" aria-live="polite">\n  <span class="sound-dot" aria-hidden="true"></span>\n  <span class="sound-line" id="soundStatusLine">炉声待点亮：首次点击后可听舒缓曲。</span>\n</div>\n\n<svg class="tour-path" id="tourPath" aria-hidden="true"></svg>\n\n<nav class="tour-rail" aria-label="巡铺路线">\n  <div class="first-guide" id="firstGuide" aria-live="polite">\n    <span class="first-guide-kicker">首锤</span>\n    <span class="first-guide-text" id="firstGuideText">第一次进铺，先走老杨、iLoop、近况、火炉四站；也可以直接拖拽自由看。</span>\n    <button class="first-guide-start" id="firstGuideStart" type="button">开始巡铺</button>\n    <button class="first-guide-skip" id="firstGuideSkip" type="button">跳过</button>\n  </div>\n  <div class="station-cue" id="stationCue" aria-live="polite">\n    <span class="station-step" id="stationStep">第 1 站</span>\n    <strong class="station-name" id="stationName">老杨</strong>\n    <span class="station-line" id="stationLine">先认识这间铺子的主人：iOS 工程师、AI 工具匠和 iLoop 手艺人。</span>\n    <button class="station-details-toggle" id="stationDetailsToggle" type="button" aria-expanded="false" aria-controls="stationDetails">读牌</button>\n    <button class="tour-slate-toggle" id="tourSlateToggle" type="button" aria-expanded="false" aria-controls="tourSlate">炉牌<span class="slate-count" id="tourSlateCount">1/4</span></button>\n    <button class="view-home-button" id="viewHome" type="button">回铺心</button>\n    <div class="station-action" aria-label="本站下一步">\n      <span class="station-action-hint" id="stationActionHint">读完这一站，先听主人开场。</span>\n      <button class="station-action-button" id="stationAction" type="button">敲这一锤</button>\n    </div>\n    <div class="forge-echo" id="forgeEcho" aria-live="polite" aria-label="炉边回声：等你落第一锤" hidden>\n      <span class="forge-echo-kicker">回声</span>\n      <span class="forge-echo-line" id="forgeEchoLine">等你落第一锤。</span>\n      <span class="forge-echo-next" id="forgeEchoNext">点人物、火炉或下方站点后，这里会留下刚刚锻出的结论。</span>\n    </div>\n    <div class="tour-slate" id="tourSlate">\n      <div class="forge-beat" id="forgeBeat" role="status" aria-live="polite" aria-label="炉前三拍：当前身份，刚刚等你落第一锤，下一锤 iLoop">\n        <span class="forge-beat-card is-now">\n          <span class="forge-beat-kicker">当前</span>\n          <span class="forge-beat-text" id="forgeBeatNow">身份 · 老杨</span>\n        </span>\n        <span class="forge-beat-card is-echo">\n          <span class="forge-beat-kicker">刚刚</span>\n          <span class="forge-beat-text" id="forgeBeatEcho">等你落第一锤。</span>\n        </span>\n        <span class="forge-beat-card is-next">\n          <span class="forge-beat-kicker">下一步</span>\n          <span class="forge-beat-text" id="forgeBeatNext">去 iLoop 看方法。</span>\n        </span>\n      </div>\n      <div class="station-thread" id="stationThread" aria-label="巡铺炉脉：当前在身份，下一锤到方法">\n        <span class="station-thread-kicker">炉脉</span>\n        <span class="station-thread-trail" id="stationThreadTrail"></span>\n        <span class="station-thread-focus" id="stationThreadFocus">当前：身份 · 下一锤：方法</span>\n      </div>\n      <div class="station-relay" id="stationRelay" aria-label="巡铺接力">\n        <span class="station-relay-kicker" id="stationRelayKicker">锻出</span>\n        <span class="station-relay-text" id="stationRelayText">身份落点，下一锤去看方法。</span>\n      </div>\n      <div class="station-progress">\n        <span id="tourProgressText">已看 1/4</span>\n        <span class="tour-progress-track" id="tourProgressBar" role="progressbar" aria-label="巡铺进度" aria-valuemin="0" aria-valuemax="4" aria-valuenow="1" aria-valuetext="已看 1 站，共 4 站">\n          <span class="tour-progress-fill" id="tourProgressFill"></span>\n        </span>\n        <span class="tour-next-cue" id="tourNextCue">下一站：iLoop</span>\n      </div>\n      <div class="tour-stamps" aria-label="锤后炉印便签" aria-live="polite">\n        <span class="tour-stamps-label">锤后炉印</span>\n        <span class="tour-stamps-current" id="tourStampCurrent">刚锻出：老杨把 iOS 手艺和 AI 协作放进同一间铺子。</span>\n        <button class="tour-harvest-toggle" id="tourHarvestToggle" type="button" aria-expanded="false" aria-controls="tourHarvestDetails">收获袋</button>\n        <span class="tour-harvest-details" id="tourHarvestDetails">\n          <span class="tour-gains" aria-label="已收下的巡铺结论">\n            <span class="tour-gains-label">炉屑袋</span>\n            <span class="tour-gains-list" id="tourGainsList"></span>\n          </span>\n          <span class="tour-stamps-list" id="tourStampsList"></span>\n        </span>\n      </div>\n      <div class="tour-receipt" id="tourReceipt" aria-live="polite">\n        <span class="receipt-summary" id="receiptSummary">四站已齐：老杨、iLoop、近况和火炉合成一枚炉印。</span>\n        <button class="receipt-open" id="receiptOpen" type="button">看炉印</button>\n      </div>\n      <div class="leave-ticket" id="leaveTicket" aria-live="polite" aria-label="离铺炉票" hidden>\n        <div class="leave-ticket-head">\n          <span class="leave-ticket-kicker">离铺炉票</span>\n          <span class="leave-ticket-summary" id="leaveTicketSummary">四站走完后，这里会留下可带走的三条炉印。</span>\n        </div>\n        <div class="leave-ticket-list" id="leaveTicketList"></div>\n      </div>\n    </div>\n    <div class="station-details" id="stationDetails">\n      <div class="station-brief" aria-label="本站问题和带走结论">\n        <span class="station-brief-item">\n          <span class="station-brief-kicker">问</span>\n          <span class="station-brief-text" id="stationQuestion">这间铺子的主人是谁？</span>\n        </span>\n        <span class="station-brief-item">\n          <span class="station-brief-kicker">带走</span>\n          <span class="station-brief-text" id="stationTakeaway">老杨把 iOS 手艺和 AI 协作放进同一间铺子。</span>\n        </span>\n      </div>\n      <div class="station-artifact" aria-live="polite">\n        <strong class="artifact-name" id="artifactName">磨亮的锤柄</strong>\n        <span class="artifact-line" id="artifactLine">握痕说明主人长期亲自下场：把移动端经验和 AI 协作一起磨顺。</span>\n        <span class="artifact-actions">\n          <button class="artifact-inspect" id="artifactInspect" type="button">鉴定</button>\n          <button class="artifact-next" id="artifactNext" type="button">换一枚</button>\n        </span>\n      </div>\n    </div>\n  </div>\n  <p class="tour-title">巡铺路线</p>\n  <button class="tour-stop active visited" data-tour="profile" aria-label="第 1 站 老杨，身份，主人是谁，已看">\n    <span class="tour-index">1</span><span class="tour-label">老杨</span><span class="tour-track">身份</span><span class="tour-scent">主人是谁</span>\n  </button>\n  <button class="tour-stop" data-tour="iloop" aria-label="第 2 站 iLoop，方法，五锤怎么跑">\n    <span class="tour-index">2</span><span class="tour-label">iLoop</span><span class="tour-track">方法</span><span class="tour-scent">五锤怎么跑</span>\n  </button>\n  <button class="tour-stop" data-tour="latest" aria-label="第 3 站 近况，试火，今天试什么">\n    <span class="tour-index">3</span><span class="tour-label">近况</span><span class="tour-track">试火</span><span class="tour-scent">今天试什么</span>\n  </button>\n  <button class="tour-stop" data-tour="forge" aria-label="第 4 站 火炉，反馈，点了会怎样">\n    <span class="tour-index">4</span><span class="tour-label">火炉</span><span class="tour-track">反馈</span><span class="tour-scent">点了会怎样</span>\n  </button>\n  <div class="tour-actions" aria-label="巡铺切换">\n    <button id="tourPrev" type="button">上一站</button>\n    <button id="tourNext" type="button">下一站</button>\n  </div>\n</nav>\n\n<div class="panel" id="sidePanel">\n  <h2>🔨 认识老杨</h2>\n  <button class="npc-btn" data-npc="master">老杨是谁</button>\n  <button class="npc-btn" data-npc="apprentice">最近在做什么</button>\n  <button class="npc-btn" data-npc="yq">iLoop / YQ</button>\n\n  <h2 style="margin-top: 16px;">🎥 视角</h2>\n  <div class="row">\n    <label>视角距离</label>\n    <input type="range" id="cameraDistance" min="6" max="14" step="0.1" value="9.5" style="width: 100px;" />\n  </div>\n  <div class="row">\n    <label>炉火强度</label>\n    <input type="range" id="fireIntensity" min="0" max="4" step="0.1" value="2.2" style="width: 100px;" />\n  </div>\n  <button class="npc-btn" id="resetView" style="margin-top: 8px;">🔄 重置视角</button>\n</div>\n\n<div class="dialog" id="dialog">\n  <div class="name" id="dlgName">老杨的铁匠铺</div>\n  <div class="meta" id="dlgMeta">点击人物认识 Job Yang.</div>\n  <div class="line" id="dlgLine">欢迎来到老杨的铁匠铺，也可以叫我老羊。要打把什么家伙？</div>\n  <div class="takeaway-mark" id="dlgTakeaway" aria-label="匠印短句">\n    <strong>匠印</strong>\n    <span id="dlgTakeawayText"></span>\n  </div>\n  <div class="receipt-details" id="receiptDetails" aria-label="巡铺炉印带走结论"></div>\n  <div class="process-steps" id="processSteps" aria-label="iLoop 五锤工序"></div>\n  <div class="actions">\n    <button id="btnPrimary">老杨是谁</button>\n    <button id="btnSecondary">锻造欢迎语</button>\n    <button class="ghost" id="btnPlay">🔊 语音</button>\n    <button id="btnClose">关闭</button>\n  </div>\n</div>\n\n<div class="hover-label" id="hoverLabel"></div>\n<div class="npc-bubble" id="npcBubble"></div>\n<div class="hint">左键拖拽 · 滚轮缩放 · 点击人物或火炉 · 输入 iLoop 有彩蛋</div>\n\n<script type="importmap">\n{\n  "imports": {\n    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",\n    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"\n  }\n}\n</script>\n\n<script type="module">\nimport * as THREE from \'three\';\nimport { OrbitControls } from \'three/addons/controls/OrbitControls.js\';\nimport { GLTFLoader } from \'three/addons/loaders/GLTFLoader.js\';\nimport { DRACOLoader } from \'three/addons/loaders/DRACOLoader.js\';\nimport { KTX2Loader } from \'three/addons/loaders/KTX2Loader.js\';\nimport { MeshoptDecoder } from \'three/addons/libs/meshopt_decoder.module.js\';\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\nimport { CharacterMotion } from \'./character-motion.js?v=behavior-3\';\n\n// ============== NPC 配置（替换 url 为你的真实 GLB 路径即可） ==============\n// 地板高度（背景 GLB 的地板表面 y 值，按实际穿模程度微调）\nconst FLOOR_Y = 0.35;\nconst DEFAULT_BG_SCALE = 12;\nconst DEFAULT_CAMERA_TARGET = new THREE.Vector3(0, 1.3, 0.95);\nconst DEFAULT_CAMERA_DISTANCE = 8.2;\nconst CAMERA_YAW = 0;\nconst CAMERA_PITCH = 0.22;\n// War3 语音文件列表（随机播放）\nconst voiceFiles = {\n  // 兽族苦工：用 War3 苦工语音，声音更粗\n  master: [\n    \'./assets/voice/peonpissed1.wav\',\n    \'./assets/voice/peonpissed2.wav\',\n    \'./assets/voice/peonpissed3.wav\',\n    \'./assets/voice/peonpissed4.wav\',\n    \'./assets/voice/peonready1.wav\',\n    \'./assets/voice/peonwarcry1.wav\',\n    \'./assets/voice/peonwhat1.wav\',\n    \'./assets/voice/peonwhat2.wav\',\n    \'./assets/voice/peonwhat3.wav\',\n    \'./assets/voice/peonwhat4.wav\',\n    \'./assets/voice/peonyes1.wav\',\n    \'./assets/voice/peonyes2.wav\',\n  ],\n  // 人族农民：用 War3 农民语音\n  apprentice: [\n    \'./assets/voice/peasantpissed1.wav\',\n    \'./assets/voice/peasantpissed2.wav\',\n    \'./assets/voice/peasantpissed3.wav\',\n    \'./assets/voice/peasantpissed4.wav\',\n    \'./assets/voice/peasantpissed5.wav\',\n    \'./assets/voice/peasantready1.wav\',\n    \'./assets/voice/peasantwarcry1.wav\',\n    \'./assets/voice/peasantwhat1.wav\',\n    \'./assets/voice/peasantwhat2.wav\',\n    \'./assets/voice/peasantwhat3.wav\',\n    \'./assets/voice/peasantwhat4.wav\',\n    \'./assets/voice/peasantyes1.wav\',\n    \'./assets/voice/peasantyes2.wav\',\n  ],\n  yq: null, // YQ 无语音，只显示台词\n};\n\n// YQ 随机台词池\nconst yqLines = [\n  \'AI的地震来了,可我却测不出震级(狗头)\',\n  \'AI比我更懂这个项目\',\n  \'我负责拍脑袋,AI 负责拍键盘\',\n  \'AI 说"你说得对",我心里一紧\',\n  \'又被 AI 一本正经地骗了\',\n  \'AI 把 TODO 实现了,逻辑是错的\',\n  \'我现在的工作是给AI当小弟\',\n  \'AI 给的方案太通用了,像没说\',\n  \'让它简化一下,它给我重写了\',\n  \'问它"为什么",它开始道歉\',\n  \'Diff 太长,AI 自己都不看了\',\n  \'幻觉是它的,背锅是我的\',\n  \'今天的灵感来自一次 retry\',\n  \'我不是在摸鱼,我在等GPT 5.5\',\n  \'能跑就别动,动了就别问我\',\n  \'有什么需求,跟我的Agent去说吧\',\n  \'让它解释代码,它先道了个歉\',\n  \'AI 写的注释比代码长\',\n  \'我让它再想想,它换了个错法\',\n  \'回滚到 AI 介入之前\',\n  \'AI时代我还是苦工,只是挖矿的方式不一样了\',\n];\n\nconst ILOOP_STEPS = [\n  {\n    key: \'plan\',\n    label: \'计划\',\n    line: \'先把一句模糊需求压成可执行的炉前计划：目标、边界、风险和验收点都摆到台面上。\',\n  },\n  {\n    key: \'evidence\',\n    label: \'取证\',\n    line: \'再去看日志、截图、diff 和运行结果。没有证据的判断，只能算炉边闲聊。\',\n  },\n  {\n    key: \'change\',\n    label: \'改动\',\n    line: \'落锤时只打一块铁：围绕当前主题改最关键的地方，避免顺手把整间铺子拆掉重装。\',\n  },\n  {\n    key: \'verify\',\n    label: \'验证\',\n    line: \'火候要现场看：本地跑通、截图对照、线上无痕确认，让“能跑”变成可复查的证据。\',\n  },\n  {\n    key: \'close\',\n    label: \'收口\',\n    line: \'最后把为什么这么打、打成什么样、哪里没做到写进手记，下一轮才能接着同一块铁继续锻。\',\n  },\n];\n\nconst GUIDE_CARDS = {\n  profile: {\n    name: \'老杨是谁\',\n    meta: \'iOS 工程师 · AI 工具匠\',\n    line: \'老杨，也叫老羊。资深 iOS 工程师，正在把 AI 协作锻成能持续交付的工程方法。\',\n    actions: [\n      { label: \'最近项目\', type: \'projects\' },\n    ],\n  },\n  projects: {\n    name: \'最近在锻造\',\n    meta: \'铺内主线\',\n    line: \'主线是 iLoop：让 Agent 不只会写代码，还能按计划、取证、改动、验证、收口五锤闭环交付。\',\n    actions: [\n      { label: \'看五锤工序\', type: \'iloop\' },\n      { label: \'看近况\', type: \'latest\' },\n    ],\n  },\n  iloop: {\n    name: \'iLoop\',\n    meta: \'i + 反馈闭环 Loop\',\n    line: \'iLoop 是这间铺子的主炉：把 AI 协作拆成五锤工序，每一步都留下能复查的火候。\',\n    steps: ILOOP_STEPS,\n    activeStep: \'plan\',\n    actions: [\n      { label: \'启动闭环彩蛋\', type: \'iloop_easter\' },\n      { label: \'锻造欢迎语\', type: \'forge\' },\n    ],\n  },\n  latest: {\n    name: \'近况\',\n    meta: \'近期火候\',\n    line: \'最近这间铺子在做两件事：把 AI 开发流程打磨成闭环，也把欢迎页自己放进每日迭代里试火。\',\n    actions: [\n      { label: \'随便逛逛\', type: \'wander\' },\n    ],\n  },\n  contact: {\n    name: \'找老杨协作\',\n    meta: \'怎么开始\',\n    line: \'最省事的方式：直接带着目标、截图、链接或报错来。需求可以粗糙，证据最好具体；剩下的交给铁匠铺慢慢敲。\',\n    actions: [\n      { label: \'老杨是谁\', type: \'profile\' },\n      { label: \'随便逛逛\', type: \'wander\' },\n    ],\n  },\n  wander: {\n    name: \'随便逛逛\',\n    meta: \'随机吐槽\',\n    line: \'这间铺子现在先说清主人，再展示手感。点三个人物认识老杨、看 iLoop 和近况，或者到火炉边锻一句。\',\n    actions: [\n      { label: \'再来一句\', type: \'wander\' },\n      { label: \'锻造欢迎语\', type: \'forge\' },\n    ],\n  },\n};\n\nconst WELCOME_LINES = [\n  \'欢迎来到老杨的铁匠铺，需求放这里，bug 也放这里，别放我脑子里。\',\n  \'这里不写长篇自我介绍，这里直接开炉。\',\n  \'如果一个问题值得反复解释，它就值得被做成工具。\',\n  \'进门先别急着夸 AI，先看它有没有把活跑通。\',\n  \'老杨也可以叫老羊，反正都是负责把硬东西一点点磨顺。\',\n];\n\nconst YQ_EASTER_LINES = [\n  \'你连点我五次，是想触发彩蛋，还是在复现线上事故？\',\n  \'YQ 已进入发疯模式：计划、取证、改动、构建、验证、收口，一个都别少。\',\n  \'别问我为什么知道你会连点，做工具的人都懂这种手痒。\',\n];\n\nconst TOUR_STOPS = {\n  profile: {\n    npc: \'master\',\n    pin: [-3.15, FLOOR_Y + 2.35, 2.95],\n    hotspotOffset: [0.12, -0.04, 0],\n    step: \'第 1 站\',\n    title: \'老杨\',\n    track: \'身份\',\n    scent: \'主人是谁\',\n    cue: \'先认识这间铺子的主人：iOS 工程师、AI 工具匠和 iLoop 手艺人。\',\n    question: \'这间铺子的主人是谁？\',\n    takeaway: \'老杨把 iOS 手艺和 AI 协作放进同一间铺子。\',\n    mark: \'记住老杨：亲自下场的 iOS 工程师，把 AI 当成要验收的工具同伴。\',\n    gain: \'收下身份：iOS 手艺 + AI 工具匠\',\n    stamp: \'身份落印：老杨把 iOS 手艺和 AI 协作锻在一起。\',\n    relay: \'锻出身份落点：先知道是谁，再去看他怎样把 AI 协作锻成方法。\',\n    actionHint: \'读完这一站，先听主人开场。\',\n    actionLabel: \'敲主人锤\',\n    actionType: \'profile\',\n    pinLine: \'主人站位\',\n    receipt: \'认识主人：iOS 手艺、AI 工具和亲自下场的工作方式。\',\n    artifacts: [\n      {\n        name: \'磨亮的锤柄\',\n        line: \'握痕说明主人长期亲自下场：把移动端经验和 AI 协作一起磨顺。\',\n        label: \'常用件 · 炉前主锤\',\n        reading: \'这不是奖杯，而是每天都要拿起来的工具。它把老杨的身份落在“亲自下场解决问题”上。\',\n        next: \'读完后适合去 iLoop 站，看这些手感怎样被整理成闭环工序。\',\n      },\n      {\n        name: \'炉前便签\',\n        line: \'便签只留目标、证据和验收点，像老杨做工具时先把混乱压成可执行小块。\',\n        label: \'纸面痕迹 · 开工前\',\n        reading: \'便签刻意很短，说明铁匠铺不靠长篇设定撑场，而靠目标、证据和验收把活往前推。\',\n        next: \'读完后适合点“最近项目”，把抽象身份接到 iLoop 主线。\',\n      },\n    ],\n  },\n  iloop: {\n    npc: \'yq\',\n    pin: [0.3, FLOOR_Y + 2.35, 3.2],\n    hotspotOffset: [0.62, -0.02, 0],\n    step: \'第 2 站\',\n    title: \'iLoop\',\n    track: \'方法\',\n    scent: \'五锤怎么跑\',\n    cue: \'主炉在这里：把 AI 协作拆成计划、取证、改动、验证、收口五锤。\',\n    question: \'AI 协作怎样从试试看变成交付流程？\',\n    takeaway: \'五锤闭环把计划、证据、改动、验证和收口扣在一起。\',\n    mark: \'记住 iLoop：每一锤都要有计划、有证据、有验收，AI 才算真正交付。\',\n    gain: \'收下方法：五锤闭环\',\n    stamp: \'方法落印：五锤闭环让 AI 交付有证据可复查。\',\n    relay: \'锻出方法骨架：五锤闭环成形后，下一站看它每天怎样试火。\',\n    actionHint: \'进入主炉，按顺序看五锤工序。\',\n    actionLabel: \'看五锤\',\n    actionType: \'iloop\',\n    pinLine: \'闭环主炉\',\n    receipt: \'看清主炉：计划、取证、改动、验证、收口缺一不可。\',\n    artifacts: [\n      {\n        name: \'闭环铁环\',\n        line: \'五道刻线首尾相扣，提醒 Agent 每一锤都要回到证据和验收。\',\n        label: \'工序样件 · 五锤闭环\',\n        reading: \'铁环的重点不是造型，而是首尾相扣：计划、取证、改动、验证、收口缺一锤都不算出炉。\',\n        next: \'读完后可以点“五锤工序”，逐步查看 iLoop 怎样约束 Agent 交付。\',\n      },\n      {\n        name: \'淬火夹钳\',\n        line: \'夹钳夹住的是风险边界：先控住范围，再让 AI 落锤。\',\n        label: \'控火工具 · 风险边界\',\n        reading: \'夹钳把热铁固定住，像工程里的范围控制。AI 可以用力，但每次只打一块铁。\',\n        next: \'读完后适合去近况站，看每日自迭代怎样小步试火。\',\n      },\n    ],\n  },\n  latest: {\n    npc: \'apprentice\',\n    pin: [2.2, FLOOR_Y + 2.35, 1.0],\n    hotspotOffset: [0.1, -0.04, 0],\n    step: \'第 3 站\',\n    title: \'近况\',\n    track: \'试火\',\n    scent: \'今天试什么\',\n    cue: \'看这间铺子最近试什么火候，以及每日自迭代怎样继续磨手感。\',\n    question: \'这间铺子最近在试什么火？\',\n    takeaway: \'每日只打一题，截图、日志和失败原因都留下来。\',\n    mark: \'记住近况：这间铺子每天只打一题，改动、截图和失败都留成下一轮证据。\',\n    gain: \'收下试火：一轮一题留证据\',\n    stamp: \'试火落印：每日一题，小步改完并留下截图日志。\',\n    relay: \'锻出当日火候：每日一题留下证据，最后回到火炉看现场反馈。\',\n    actionHint: \'看近期火候，理解这间铺子如何每日试火。\',\n    actionLabel: \'看近况\',\n    actionType: \'latest\',\n    pinLine: \'今日试火\',\n    receipt: \'摸到近况：每日只打一题，失败和截图都留作下一锤证据。\',\n    artifacts: [\n      {\n        name: \'今日试火单\',\n        line: \'单子上只记一轮主题，说明这间铺子每天小步试火，不靠一次性堆满。\',\n        label: \'当日记录 · 一轮一题\',\n        reading: \'试火单把“每天变好一点”变成可检查的样本：今天做什么、为什么做、怎么验证。\',\n        next: \'读完后适合继续看火炉站，感受这套记录怎样回到可见反馈。\',\n      },\n      {\n        name: \'复盘煤灰\',\n        line: \'灰里留着昨天的截图、日志和失败原因，下一锤从证据继续。\',\n        label: \'余料 · 失败也留痕\',\n        reading: \'煤灰不是垃圾，是下一轮判断火候的证据。它提醒这间铺子允许失败，但不能没有复盘。\',\n        next: \'读完后适合回老杨站，理解主人为什么把工程手艺看得比热闹更重。\',\n      },\n    ],\n  },\n  forge: {\n    object: \'forge\',\n    pin: [0, FLOOR_Y + 1.75, 1.05],\n    hotspotOffset: [-0.72, -0.18, 0.05],\n    step: \'第 4 站\',\n    title: \'火炉\',\n    track: \'反馈\',\n    scent: \'点了会怎样\',\n    cue: \'到炉边锻一句欢迎语，感受老杨式的短句和火候反馈。\',\n    question: \'访客动手后，铺子会怎样回应？\',\n    takeaway: \'点击火炉会触发短句、灯光和声音，把介绍变成现场反馈。\',\n    mark: \'记住火炉：访客一落锤，短句、火光和声音会立刻给出现场反馈。\',\n    gain: \'收下反馈：点击、火光和短句\',\n    stamp: \'反馈落印：点击火炉，短句、火光和声音一起回锤。\',\n    relay: \'锻出现场反馈：身份、方法和试火都回到一次可听可看的落锤。\',\n    actionHint: \'到炉边亲手锻一句欢迎语。\',\n    actionLabel: \'锻一句\',\n    actionType: \'forge\',\n    pinLine: \'火候入口\',\n    receipt: \'回到火候：点击、声音、灯光和短句把介绍变成现场反馈。\',\n    artifacts: [\n      {\n        name: \'炉膛回声\',\n        line: \'每次锻出的短句都带一点老杨式吐槽，火候轻但能让铺子有声气。\',\n        label: \'互动残响 · 欢迎语\',\n        reading: \'回声把页面从静态介绍拉回现场：访客点一下火炉，铺子就用老杨式短句回应一次。\',\n        next: \'读完后可以再锻一句，或回 iLoop 站看这类反馈怎样被纳入验证。\',\n      },\n      {\n        name: \'余温刻度\',\n        line: \'火光强弱对应当前模式：舒缓时看铺，开炉时让人物和欢迎语更有反馈。\',\n        label: \'火候读数 · 场景模式\',\n        reading: \'刻度说明这里的氛围不是装饰。舒缓模式方便参观，火炉模式让声音、灯光和反馈更像开工。\',\n        next: \'读完后可以切换右上角场景模式，对照炉火和人物反馈的差异。\',\n      },\n    ],\n  },\n};\nconst TOUR_ORDER = Object.keys(TOUR_STOPS);\nconst TOUR_RECEIPT_SUMMARY = \'四站合炉：身份、方法、近况和反馈都已看过。\';\nconst TOUR_RECEIPT_DETAILS = [\n  {\n    label: \'记住老杨\',\n    text: \'他不是把 AI 当噱头展示，而是把 iOS 工程手艺放进一套能复查的协作流程里。\',\n  },\n  {\n    label: \'记住 iLoop\',\n    text: \'主炉的五锤是计划、取证、改动、验证、收口；每一步都要留下证据。\',\n  },\n  {\n    label: \'下一锤\',\n    text: \'带着一个目标、一张截图或一段日志进门，铺子会把混乱问题锻成能跑的工具。\',\n  },\n];\n\nconst STATION_TONES = {\n  profile: {\n    name: \'身份炉色\',\n    accent: \'#ffcf8a\',\n    accentRgb: \'255, 207, 138\',\n    softRgb: \'255, 119, 51\',\n    deepRgb: \'31, 18, 10\',\n    light: 0xffb35c,\n    label: \'身份火候\',\n    line: \'暖金火候：先看主人和手艺底色。\',\n  },\n  iloop: {\n    name: \'方法炉色\',\n    accent: \'#9fd6ff\',\n    accentRgb: \'159, 214, 255\',\n    softRgb: \'67, 139, 215\',\n    deepRgb: \'9, 21, 34\',\n    light: 0x74bfff,\n    label: \'方法蓝火\',\n    line: \'蓝白火候：把 AI 协作锻成五锤流程。\',\n  },\n  latest: {\n    name: \'试火炉色\',\n    accent: \'#d6f0bd\',\n    accentRgb: \'214, 240, 189\',\n    softRgb: \'118, 174, 95\',\n    deepRgb: \'17, 29, 14\',\n    light: 0xb6f08c,\n    label: \'试火余绿\',\n    line: \'青绿火候：看每日小步试火留下的证据。\',\n  },\n  forge: {\n    name: \'反馈炉色\',\n    accent: \'#ff9b57\',\n    accentRgb: \'255, 155, 87\',\n    softRgb: \'255, 86, 32\',\n    deepRgb: \'38, 12, 6\',\n    light: 0xff5f2a,\n    label: \'反馈赤焰\',\n    line: \'赤橙火候：点击火炉，让短句、声音和灯光回锤。\',\n  },\n};\n\nconst STATION_SOUNDPRINTS = {\n  profile: {\n    name: \'身份轻锤\',\n    line: \'身份轻锤：一声短响，把主人和手艺敲清楚。\',\n    hits: [\n      { time: 0.00, frequency: 185, duration: 0.16, gain: 0.11 },\n      { time: 0.11, frequency: 268, duration: 0.12, gain: 0.055 },\n    ],\n  },\n  iloop: {\n    name: \'方法双锤\',\n    line: \'方法双锤：两下相扣，像五锤闭环扣回证据。\',\n    hits: [\n      { time: 0.00, frequency: 244, duration: 0.12, gain: 0.09 },\n      { time: 0.16, frequency: 328, duration: 0.12, gain: 0.072 },\n    ],\n  },\n  latest: {\n    name: \'试火淬响\',\n    line: \'试火淬响：轻亮一闪，像当天样本进水看火候。\',\n    hits: [\n      { time: 0.00, frequency: 392, duration: 0.09, gain: 0.052, type: \'triangle\' },\n      { time: 0.09, frequency: 560, duration: 0.14, gain: 0.035, type: \'sine\' },\n    ],\n  },\n  forge: {\n    name: \'反馈炉鸣\',\n    line: \'反馈炉鸣：低响带火，提醒点击已经回到现场反馈。\',\n    hits: [\n      { time: 0.00, frequency: 126, duration: 0.20, gain: 0.12, type: \'sawtooth\' },\n      { time: 0.08, frequency: 214, duration: 0.16, gain: 0.055 },\n    ],\n  },\n};\n\nconst OBJECT_CONFIG = {\n  forge: {\n    name: \'火炉 · 欢迎语锻造机\',\n    meta: \'点击火炉\',\n    line: \'火炉不讲道理，只负责把一句普通欢迎语烧得更像老杨。\',\n    actions: [\n      { label: \'锻造一句\', type: \'forge\' },\n      { label: \'看 iLoop\', type: \'iloop\' },\n    ],\n  },\n};\n\nfunction pickRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }\n\nlet currentAudio = null;\nlet currentAudioKey = null;\nlet bubbleTimer = null;\nlet bubbleKey = null;\nlet bubbleRoot = null;\nlet lastAutoTalkAt = 0;\nlet bgRoot = null;\nlet bgFitBase = null;\nlet furnaceFireMesh = null;\nlet fireVtxFrame = 0;   // 火焰顶点动画隔帧计数器（性能）\nlet furnaceFireBasePositions = null;\nlet forgePulseUntil = 0;\nlet dialogActions = [];\nlet currentProcessSteps = [];\nlet selectedObjectKey = null;\nlet activeTourType = \'profile\';\nlet activeArtifactIndex = 0;\nlet lastStationSoundType = \'\';\nlet lastStationSoundAt = 0;\nlet yqClickCount = 0;\nlet typedSecret = \'\';\nconst reducedMotionQuery = window.matchMedia?.(\'(prefers-reduced-motion: reduce)\');\nlet reducedMotion = reducedMotionQuery?.matches || false;\n\nconst NPC_CONFIG = {\n  master:     { name: \'老杨是谁\', url: \'./assets/rigged/npc_master.glb?v=behavior-3\',     position: [-3.15, 0, 2.95], scale: 1.0, color: 0x884422,\n                line: GUIDE_CARDS.profile.line,\n                meta: \'iOS 工程师 · AI 工具匠\',\n                actions: [\n                  { label: \'最近项目\', type: \'projects\' },\n                ],\n                rotY: 0.05,\n                prop: null },\n  apprentice: { name: \'最近在做什么\',   url: \'./assets/rigged/npc_apprentice.glb?v=behavior-3\', position: [2.2, 0, 1.0],   scale: 0.9, color: 0xaa6633,\n                line: GUIDE_CARDS.latest.line,\n                meta: \'近期火候\',\n                actions: [\n                  { label: \'看近况\', type: \'latest\' },\n                  { label: \'最近项目\', type: \'projects\' },\n                ],\n                rotY: -0.6,                // 侧身朝炉火\n                prop: null },\n  yq:         { name: \'iLoop / YQ\',         url: \'./assets/rigged/npc_yq.glb?v=behavior-3\',         position: [0.3, 0, 3.2],   scale: 1.0, color: 0x2266aa,\n                line: GUIDE_CARDS.iloop.line,\n                meta: \'Agent 工作流\',\n                actions: [\n                  { label: \'看 iLoop\', type: \'iloop\' },\n                  { label: \'触发彩蛋\', type: \'yq_easter\' },\n                ],\n                rotY: -0.2,                // 微微侧身\n                prop: null }\n};\n\nconst BG_URL = \'./assets/bg_smithy.glb\'; // 铁匠铺背景\n\n// ============== 基础场景 ==============\nconst canvas = document.getElementById(\'viewer\');\nconst renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: \'high-performance\' });\n// 性能：像素比封顶 1.75，避免 Retina/高分屏下 4~9 倍像素填充拖慢帧率（嵌入小窗时尤其无谓）\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.1;\nrenderer.outputColorSpace = THREE.SRGBColorSpace;\nrenderer.shadowMap.enabled = true;\n// 性能：基础 PCF 软阴影即可，PCFSoft 在小窗里几乎看不出差别但开销翻倍\nrenderer.shadowMap.type = THREE.PCFShadowMap;\nrenderer.shadowMap.autoUpdate = false;   // 静态场景：阴影只渲一次，之后冻结\nrenderer.shadowMap.needsUpdate = true;\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x0d0905);\nscene.fog = new THREE.Fog(0x0d0905, 8, 20);\n\n// 环境反射（让 PBR 材质有反射）\nconst pmrem = new THREE.PMREMGenerator(renderer);\nscene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\n\nconst camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 100);\n\nfunction getCameraPosition(distance = DEFAULT_CAMERA_DISTANCE, target = DEFAULT_CAMERA_TARGET) {\n  const x = target.x + Math.sin(CAMERA_YAW) * distance;\n  const z = target.z + Math.cos(CAMERA_YAW) * distance;\n  const y = target.y + Math.sin(CAMERA_PITCH) * distance * 0.6;\n  return new THREE.Vector3(x, y, z);\n}\n\ncamera.position.copy(getCameraPosition());\n\nconst controls = new OrbitControls(camera, canvas);\ncontrols.target.copy(DEFAULT_CAMERA_TARGET);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.08;\ncontrols.minDistance = 6;\ncontrols.maxDistance = 14;\ncontrols.enablePan = false;\ncontrols.minAzimuthAngle = -Infinity;\ncontrols.maxAzimuthAngle = Infinity;\ncontrols.minPolarAngle = 0.68;\ncontrols.maxPolarAngle = 1.42;\ncontrols.update();\n\n// ============== 灯光（铁匠铺炉火氛围）==============\nconst ambient = new THREE.AmbientLight(0xffaa66, 0.4);\nscene.add(ambient);\n\n// 主光：从前上方的暖黄\nconst keyLight = new THREE.DirectionalLight(0xffd9a0, 1.35);\nkeyLight.position.set(3, 5, 4);\nkeyLight.castShadow = true;\nkeyLight.shadow.mapSize.set(1024, 1024);\nkeyLight.shadow.camera.near = 1;\nkeyLight.shadow.camera.far = 20;\nkeyLight.shadow.camera.left = -5; keyLight.shadow.camera.right = 5;\nkeyLight.shadow.camera.top = 5;   keyLight.shadow.camera.bottom = -5;\nscene.add(keyLight);\n\n// 炉火光：主炉正前方的橙红\nconst fireLight = new THREE.PointLight(0xff6a2a, 2.2, 10, 1.7);\nfireLight.position.set(0, 1.75, 1.25);\nscene.add(fireLight);\n\n// 炉膛内部补一盏更集中的暖光\nconst furnaceCoreLight = new THREE.PointLight(0xffaa55, 1.4, 4.5, 2.0);\nfurnaceCoreLight.position.set(0, 1.45, 0.95);\nscene.add(furnaceCoreLight);\n\n// 当前站位的火候补光：只改变既有场景气质，不新增最终模型。\nconst stationToneLight = new THREE.PointLight(STATION_TONES.profile.light, 0.0, 5.2, 2.1);\nstationToneLight.position.set(-3.15, FLOOR_Y + 1.6, 2.95);\nscene.add(stationToneLight);\n\n// 右侧工作台补一点暖反射，避免只有中间亮\nconst benchFillLight = new THREE.PointLight(0xff8a45, 0.65, 6, 2.0);\nbenchFillLight.position.set(2.8, 1.2, 0.8);\nscene.add(benchFillLight);\n\n// 补光：背后冷蓝（拉对比）\nconst rimLight = new THREE.DirectionalLight(0x4477aa, 0.22);\nrimLight.position.set(-2, 3, -4);\nscene.add(rimLight);\n\n// ============== NPC 头顶氛围光（真 3D 光源，随模式调强弱）==============\n// 每个 NPC 头顶一盏暖色 PointLight；光源本身不可见，避免误读成对白气泡。\nconst npcHaloLights = {};   // key -> { light, glow }\nfunction createNpcHalo(key, position) {\n  const x = position[0], z = position[2];\n  const y = FLOOR_Y + 2.35;  // 头顶上方\n  const light = new THREE.PointLight(0xffb060, 0.0, 4.2, 2.0);\n  light.position.set(x, y, z);\n  scene.add(light);\n\n  // 保留占位 mesh 兼容模式切换逻辑，但不渲染出来。\n  const glow = new THREE.Mesh(\n    new THREE.SphereGeometry(0.07, 16, 16),\n    new THREE.MeshBasicMaterial({ color: 0xffcf8a, transparent: true, opacity: 0.0 })\n  );\n  glow.visible = false;\n  glow.position.set(x, y, z);\n  scene.add(glow);\n\n  npcHaloLights[key] = { light, glow };\n}\nObject.entries(NPC_CONFIG).forEach(([k, v]) => createNpcHalo(k, v.position));\n\n/* ============================================================\n   场景模式预设(状态定义需早于 animate() 渲染循环,避免 TDZ)\n   - calm  舒缓: 温馨柔光、弱火、NPC 静音(只冒泡)、舒缓 BGM、头顶柔和暖光\n   - forge 火炉: 强暖光、旺火、NPC 开口说话、酒馆 BGM、头顶强亮暖光\n   ============================================================ */\nconst SCENE_PRESETS = {\n  calm: {\n    label: \'🕯️ 舒缓\',\n    ambient: 0.34,\n    keyLight: 1.05,\n    fireBase: 1.3,        // 火光基准强度\n    furnaceFactor: 0.5,\n    haloIntensity: 0.85,  // 头顶氛围光\n    haloGlow: 0.0,\n    bg: 0x0d0905,\n    npcVoice: false,      // 静音,只冒泡\n    bgmStyle: \'calm\',\n  },\n  forge: {\n    label: \'🔥 火炉\',\n    ambient: 0.52,\n    keyLight: 1.6,\n    fireBase: 2.7,\n    furnaceFactor: 0.75,\n    haloIntensity: 2.2,\n    haloGlow: 0.0,\n    bg: 0x140a05,\n    npcVoice: true,       // 开口说话\n    bgmStyle: \'tavern\',\n  },\n};\nlet SCENE_MODE = \'calm\';\nlet fireBaseIntensity = SCENE_PRESETS.calm.fireBase;   // 给火光闪烁动画当基准\nlet audioUnlocked = false;\n\n// ============== 地面（在背景 GLB 没加载前的兜底）==============\nconst ground = new THREE.Mesh(\n  new THREE.CircleGeometry(8, 64),\n  new THREE.MeshStandardMaterial({ color: 0x2a1a10, roughness: 0.9, metalness: 0.05 })\n);\nground.rotation.x = -Math.PI / 2;\nground.receiveShadow = true;\nscene.add(ground);\n\n// ============== 加载器 ==============\n// Draco 几何解压（压缩脚本 compress.sh 会用到 draco）\nconst dracoLoader = new DRACOLoader();\ndracoLoader.setDecoderPath(\'https://www.gstatic.com/draco/v1/decoders/\');\n// KTX2 贴图解压（如果之后启用 ktx2 压缩，提前接好）\nconst ktx2Loader = new KTX2Loader();\nktx2Loader.setTranscoderPath(\'https://unpkg.com/three@0.160.0/examples/jsm/libs/basis/\');\nktx2Loader.detectSupport(renderer);\n\nconst loader = new GLTFLoader();\nloader.setDRACOLoader(dracoLoader);\nloader.setKTX2Loader(ktx2Loader);\nloader.setMeshoptDecoder(MeshoptDecoder);\n\nconst npcs = {}; // { key: { root, originalEmissive, config } }\nconst interactiveObjects = {}; // { key: { root, config } }\nlet loadCount = 0;\nconst TOTAL = Object.keys(NPC_CONFIG).length + 1; // +1 for bg\ncreateHotspot(\'forge\', [0, FLOOR_Y + 0.7, 1.05], [1.8, 1.5, 1.3]);\nwindow.__SCENE_DEBUG__ = {\n  interactiveKeys: () => Object.keys(interactiveObjects),\n  npcKeys: () => Object.keys(npcs),\n  rigs: () => Object.fromEntries(Object.entries(npcs).map(([key, npc]) => {\n    const skins = [];\n    npc.root.traverse(o => {\n      if (o.isSkinnedMesh) skins.push({\n        bones: o.skeleton.bones.length,\n        vertices: o.geometry.attributes.position.count,\n        headQuaternion: o.skeleton.bones.find(b => b.name === \'head\')?.quaternion.toArray(),\n        jointPositions: Object.fromEntries([\'head\', \'hand.L\', \'hand.R\', \'foot.L\', \'foot.R\'].map(name => {\n          const bone = o.skeleton.bones.find(b => b.name === THREE.PropertyBinding.sanitizeNodeName(name));\n          return [name, bone?.getWorldPosition(new THREE.Vector3()).toArray()];\n        })),\n        motionRevision: o.userData.motionRevision || 1,\n      });\n    });\n    return [key, {\n      skins, clips: npc.clips || [], mixerTime: npc.mixer?.time || 0,\n      fittedHeight: npc.fittedHeight, floorY: FLOOR_Y, baseY: npc.baseY,\n      clipDuration: npc.idleAction?.getClip().duration || 0,\n      clipTime: npc.idleAction?.time || 0,\n      position: npc.root.position.toArray(),\n      rotation: npc.root.quaternion.toArray(),\n      scale: npc.root.scale.toArray(),\n      motion: npc.motion?.snapshot() || null,\n      screen: (() => {\n        const point = npc.root.position.clone().add(new THREE.Vector3(0, npc.fittedHeight * 0.63, 0)).project(camera);\n        return [(point.x * 0.5 + 0.5) * innerWidth, (-point.y * 0.5 + 0.5) * innerHeight];\n      })(),\n    }];\n  })),\n  stationPin: () => {\n    const rect = stationPin?.getBoundingClientRect();\n    return {\n      activeTourType,\n      text: stationPin?.textContent?.replace(/\\s+/g, \' \').trim() || \'\',\n      visible: stationPin?.classList.contains(\'show\') || false,\n      rect: rect ? {\n        left: rect.left,\n        top: rect.top,\n        right: rect.right,\n        bottom: rect.bottom,\n        width: rect.width,\n        height: rect.height,\n      } : null,\n    };\n  },\n  stationHotspots: () => Object.fromEntries(\n    Object.entries(stationHotspotButtons).map(([key, btn]) => {\n      const rect = btn.getBoundingClientRect();\n      return [key, {\n        text: btn.textContent.replace(/\\s+/g, \' \').trim(),\n        visible: btn.classList.contains(\'show\'),\n        active: btn.classList.contains(\'active\'),\n        next: btn.classList.contains(\'next\'),\n        visited: btn.classList.contains(\'visited\'),\n        rect: {\n          left: rect.left,\n          top: rect.top,\n          right: rect.right,\n          bottom: rect.bottom,\n          width: rect.width,\n          height: rect.height,\n        },\n      }];\n    }),\n  ),\n  firstGuide: () => {\n    const rect = firstGuide?.getBoundingClientRect();\n    return {\n      visible: firstGuideVisible,\n      hiddenClass: firstGuide?.classList.contains(\'hide\') || false,\n      text: firstGuide?.textContent?.replace(/\\s+/g, \' \').trim() || \'\',\n      rect: rect ? {\n        left: rect.left,\n        top: rect.top,\n        right: rect.right,\n        bottom: rect.bottom,\n        width: rect.width,\n        height: rect.height,\n      } : null,\n    };\n  },\n  tourPath: () => ({\n    activeTourType,\n    nextTourType: getNextTourKey(),\n    lineCount: tourPathLines.length,\n    visibleLines: tourPathLines.filter(line => line.style.display !== \'none\').map(line => ({\n      from: line.dataset.from,\n      to: line.dataset.to,\n      next: line.classList.contains(\'next\'),\n      visited: line.classList.contains(\'visited\'),\n      x1: Number(line.getAttribute(\'x1\') || 0),\n      y1: Number(line.getAttribute(\'y1\') || 0),\n      x2: Number(line.getAttribute(\'x2\') || 0),\n      y2: Number(line.getAttribute(\'y2\') || 0),\n    })),\n    nodes: Object.fromEntries(Object.entries(tourPathNodes).map(([key, parts]) => [\n      key,\n      {\n        visible: parts.group.style.display !== \'none\',\n        active: parts.node.classList.contains(\'active\'),\n        next: parts.node.classList.contains(\'next\'),\n        visited: parts.node.classList.contains(\'visited\'),\n        label: parts.label.textContent || \'\',\n        transform: parts.group.getAttribute(\'transform\') || \'\',\n      },\n    ])),\n  }),\n  stationFocus: () => {\n    const rect = stationFocusHalo?.getBoundingClientRect();\n    const tone = STATION_TONES[activeTourType] || STATION_TONES.profile;\n    return {\n      activeTourType,\n      tone: {\n        key: activeTourType,\n        name: tone.name,\n        label: tone.label,\n        accent: tone.accent,\n        accentRgb: tone.accentRgb,\n        light: tone.light,\n        line: tone.line,\n      },\n      label: stationFocusLabel?.textContent || \'\',\n      visible: stationFocusHalo?.classList.contains(\'show\') || false,\n      rect: rect ? {\n        left: rect.left,\n        top: rect.top,\n        right: rect.right,\n        bottom: rect.bottom,\n        width: rect.width,\n        height: rect.height,\n      } : null,\n      focusedNpc: TOUR_STOPS[activeTourType]?.npc || \'\',\n      focusedObject: TOUR_STOPS[activeTourType]?.object || \'\',\n      toneLight: {\n        color: `#${stationToneLight.color.getHexString()}`,\n        intensity: Number(stationToneLight.intensity.toFixed(3)),\n        position: stationToneLight.position.toArray().map(v => Number(v.toFixed(3))),\n      },\n    };\n  },\n  stationBrief: () => ({\n    activeTourType,\n    nextTourType: getNextTourKey(),\n    reducedMotion,\n    routeScent: Array.from(document.querySelectorAll(\'.tour-stop\')).map(stop => ({\n      key: stop.dataset.tour,\n      label: stop.querySelector(\'.tour-label\')?.textContent || \'\',\n      track: stop.querySelector(\'.tour-track\')?.textContent || \'\',\n      scent: stop.querySelector(\'.tour-scent\')?.textContent || \'\',\n      aria: stop.getAttribute(\'aria-label\') || \'\',\n    })),\n    stationMarks: Object.fromEntries(Object.entries(TOUR_STOPS).map(([key, station]) => [key, station.mark || \'\'])),\n    question: stationQuestion?.textContent || \'\',\n    takeaway: stationTakeaway?.textContent || \'\',\n    cue: stationLine?.textContent || \'\',\n    actionHint: stationActionHint?.textContent || \'\',\n    actionLabel: stationAction?.textContent || \'\',\n    relayKicker: stationRelayKicker?.textContent || \'\',\n    relay: stationRelayText?.textContent || \'\',\n    gains: Array.from(document.querySelectorAll(\'#tourGainsList .tour-gain\')).map(item => ({\n      text: item.textContent || \'\',\n      collected: item.classList.contains(\'collected\'),\n      active: item.classList.contains(\'active\'),\n    })),\n    stamps: Array.from(document.querySelectorAll(\'#tourStampsList .tour-stamp\')).map(item => ({\n      text: item.textContent || \'\',\n      collected: item.classList.contains(\'collected\'),\n      active: item.classList.contains(\'active\'),\n    })),\n    leaveTicketVisible: leaveTicket?.classList.contains(\'show\') || false,\n    leaveTicketHidden: leaveTicket?.hidden || false,\n    leaveTicketSummary: leaveTicketSummary?.textContent || \'\',\n    leaveTicketItems: Array.from(document.querySelectorAll(\'#leaveTicketList .leave-ticket-item\')).map(item => ({\n      label: item.querySelector(\'strong\')?.textContent || \'\',\n      text: item.querySelector(\'span\')?.textContent || \'\',\n    })),\n    stampCurrent: tourStampCurrent?.textContent || \'\',\n    slateOpen: tourSlateOpen,\n    slateVisible: tourSlate?.classList.contains(\'show\') || false,\n    slateToggle: tourSlateToggle?.textContent || \'\',\n    slateToggleAria: tourSlateToggle?.getAttribute(\'aria-label\') || \'\',\n    slateProgressVisible: tourSlateToggle?.classList.contains(\'has-progress\') || false,\n    harvestOpen: tourHarvestOpen,\n    harvestVisible: tourHarvestDetails?.classList.contains(\'show\') || false,\n    harvestToggle: tourHarvestToggle?.textContent || \'\',\n    threadText: stationThread?.textContent?.replace(/\\s+/g, \' \').trim() || \'\',\n    threadAria: stationThread?.getAttribute(\'aria-label\') || \'\',\n    threadMarks: Array.from(document.querySelectorAll(\'#stationThreadTrail .thread-mark\')).map(item => ({\n      text: item.textContent || \'\',\n      active: item.classList.contains(\'active\'),\n      visited: item.classList.contains(\'visited\'),\n      next: item.classList.contains(\'next\'),\n    })),\n    echoText: forgeEcho?.textContent?.replace(/\\s+/g, \' \').trim() || \'\',\n    echoAria: forgeEcho?.getAttribute(\'aria-label\') || \'\',\n    echoActive: forgeEcho?.classList.contains(\'active\') || false,\n    beatVisible: !!(forgeBeat?.offsetParent),\n    beatText: forgeBeat?.textContent?.replace(/\\s+/g, \' \').trim() || \'\',\n    beatAria: forgeBeat?.getAttribute(\'aria-label\') || \'\',\n    beatNow: forgeBeatNow?.textContent || \'\',\n    beatEcho: forgeBeatEcho?.textContent || \'\',\n    beatNext: forgeBeatNext?.textContent || \'\',\n    detailsOpen: stationDetailsOpen,\n    detailsVisible: stationDetails?.classList.contains(\'show\') || false,\n    railHeight: Math.round(tourRail?.getBoundingClientRect().height || 0),\n    detailsHeight: Math.round(stationDetails?.getBoundingClientRect().height || 0),\n  }),\n  cameraState: () => ({\n    position: camera.position.toArray(),\n    target: controls.target.toArray(),\n    defaultPosition: getCameraPosition(DEFAULT_CAMERA_DISTANCE, DEFAULT_CAMERA_TARGET).toArray(),\n    defaultTarget: DEFAULT_CAMERA_TARGET.toArray(),\n    distanceToDefaultPosition: camera.position.distanceTo(getCameraPosition(DEFAULT_CAMERA_DISTANCE, DEFAULT_CAMERA_TARGET)),\n    distanceToDefaultTarget: controls.target.distanceTo(DEFAULT_CAMERA_TARGET),\n  }),\n  receiptDetails: () => Array.from(receiptDetails?.querySelectorAll(\'.receipt-detail\') || []).map(item => ({\n    label: item.querySelector(\'strong\')?.textContent || \'\',\n    text: item.querySelector(\'span\')?.textContent || \'\',\n  })),\n  dialogTakeaway: () => ({\n    visible: dlgTakeaway?.classList.contains(\'show\') || false,\n    text: dlgTakeawayText?.textContent || \'\',\n    aria: dlgTakeaway?.getAttribute(\'aria-label\') || \'\',\n  }),\n  motion: () => ({\n    reducedMotion,\n    bodyClass: document.body.classList.contains(\'motion-reduced\'),\n    buttonPressed: motionBtn?.getAttribute(\'aria-pressed\') === \'true\',\n    fireBaseIntensity,\n    sceneMode: SCENE_MODE,\n    activeMotionStates: Object.fromEntries(Object.entries(npcs).map(([key, npc]) => [\n      key,\n      npc.motion?.snapshot() || null,\n    ])),\n  }),\n  sound: () => ({\n    mode: SCENE_MODE,\n    unlocked: audioUnlocked,\n    bgmPlaying: window.__BGM_DEBUG__?.state()?.playing || false,\n    bgmStyle: window.__BGM_DEBUG__?.state()?.style || \'\',\n    title: window.__BGM_DEBUG__?.state()?.title || \'\',\n    npcVoice: !!SCENE_PRESETS[SCENE_MODE]?.npcVoice,\n    stationSound: window.__STATION_SOUND_DEBUG__?.state?.() || null,\n    statusText: soundStatusLine?.textContent || \'\',\n    statusClass: soundStatus?.className || \'\',\n    bgmButtonText: bgmBtn?.textContent || \'\',\n    bgmButtonTitle: bgmBtn?.title || \'\',\n    modeButtonText: modeBtn?.textContent || \'\',\n  }),\n  mobileControls: () => {\n    const names = {\n      panel: panelToggle,\n      motion: motionBtn,\n      mode: modeBtn,\n      bgm: bgmBtn,\n      sound: soundStatus,\n      topbar: document.querySelector(\'.topbar\'),\n    };\n    const rects = Object.fromEntries(Object.entries(names).map(([key, el]) => {\n      const rect = el?.getBoundingClientRect();\n      return [key, rect ? {\n        left: Math.round(rect.left),\n        top: Math.round(rect.top),\n        right: Math.round(rect.right),\n        bottom: Math.round(rect.bottom),\n        width: Math.round(rect.width),\n        height: Math.round(rect.height),\n      } : null];\n    }));\n    const pairs = [\n      [\'panel\', \'bgm\'],\n      [\'panel\', \'motion\'],\n      [\'panel\', \'mode\'],\n      [\'motion\', \'mode\'],\n      [\'bgm\', \'sound\'],\n      [\'mode\', \'sound\'],\n      [\'topbar\', \'panel\'],\n    ];\n    const overlaps = pairs.filter(([a, b]) => {\n      const ra = rects[a];\n      const rb = rects[b];\n      return ra && rb && !(ra.right <= rb.left || rb.right <= ra.left || ra.bottom <= rb.top || rb.bottom <= ra.top);\n    }).map(pair => pair.join(\':\'));\n    return { rects, overlaps };\n  },\n};\n\nfunction tickLoad() {\n  loadCount++;\n  if (loadCount >= TOTAL) {\n    document.getElementById(\'loader\').classList.add(\'hide\');\n    // 全部模型就位后渲一次阴影并冻结（静态场景无需逐帧更新阴影贴图）\n    renderer.shadowMap.needsUpdate = true;\n  }\n}\n\n// 加载背景\nloader.load(BG_URL, gltf => {\n  const bg = gltf.scene;\n  bgRoot = bg;\n  bg.traverse(o => { if (o.isMesh) { o.receiveShadow = true; o.castShadow = true; }});\n  const box = new THREE.Box3().setFromObject(bg);\n  const size = box.getSize(new THREE.Vector3());\n  bgFitBase = { x: size.x, z: size.z, minY: box.min.y };\n  const scale = DEFAULT_BG_SCALE / Math.max(size.x, size.z);\n  bg.scale.setScalar(scale);\n  bg.position.y = -box.min.y * scale;\n  scene.add(bg);\n  hideCoalPiles();\n  ground.visible = false;\n  tickLoad();\n}, undefined, () => {\n  console.warn(\'背景 GLB 未找到，使用兜底地面\');\n  tickLoad();\n});\n\nfunction setCameraDistance(distance) {\n  camera.position.copy(getCameraPosition(distance, controls.target.clone()));\n  controls.update();\n}\n\nfunction resetOverview() {\n  animateCamera(getCameraPosition(DEFAULT_CAMERA_DISTANCE, DEFAULT_CAMERA_TARGET), DEFAULT_CAMERA_TARGET.clone(), reducedMotion ? 0 : 600);\n  showContextBubble(\'回到铺心：从这里重新看老杨、iLoop、近况和火炉。\', 3200);\n}\n\nfunction hideCoalPiles() {\n  if (!bgRoot) return;\n  bgRoot.traverse(o => {\n    if (!o.isMesh) return;\n    const name = (o.name || \'\').toLowerCase();\n    const matName = (o.material?.name || \'\').toLowerCase();\n    if (/coal|char|rock|stone|ember|pile/.test(name) || /coal|char|rock|stone|ember|pile/.test(matName)) {\n      o.visible = false;\n    }\n    if (!furnaceFireMesh && /fire|flame|ember|burn|lava/.test(name + \' \' + matName)) {\n      furnaceFireMesh = o;\n      if (o.geometry?.attributes?.position) {\n        furnaceFireBasePositions = o.geometry.attributes.position.array.slice();\n      }\n      if (o.material) {\n        o.material = o.material.clone();\n        if (\'emissiveIntensity\' in o.material) o.material.emissiveIntensity = 1.6;\n      }\n    }\n  });\n}\n\n// 场景只保留已有 GLB 资产；内容入口由人物与火炉承担。\nfunction registerInteractive(root, key, config = OBJECT_CONFIG[key]) {\n  if (!root || !config) return root;\n  root.userData.interactiveKey = key;\n  root.traverse?.(o => {\n    if (o.isMesh || o.isGroup) o.userData.interactiveKey = key;\n  });\n  interactiveObjects[key] = { root, config };\n  return root;\n}\n\nfunction createHotspot(key, position, size) {\n  const hit = new THREE.Mesh(\n    new THREE.BoxGeometry(size[0], size[1], size[2]),\n    new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.0, depthWrite: false })\n  );\n  hit.position.set(position[0], position[1], position[2]);\n  hit.visible = true;\n  scene.add(hit);\n  return registerInteractive(hit, key);\n}\n\nfunction createNpcHitbox(root, key) {\n  root.updateMatrixWorld(true);\n  const box = new THREE.Box3().setFromObject(root, true);\n  const size = box.getSize(new THREE.Vector3());\n  const hitbox = new THREE.Mesh(\n    new THREE.BoxGeometry(size.x, size.y, size.z),\n    new THREE.MeshBasicMaterial({\n      transparent: true,\n      opacity: 0,\n      depthWrite: false,\n      colorWrite: false,\n    }),\n  );\n  hitbox.position.copy(box.getCenter(new THREE.Vector3()));\n  hitbox.userData.npcKey = key;\n  scene.add(hitbox);\n  return hitbox;\n}\n\n// 加载 NPC\nfunction loadNPC(key, cfg) {\n  loader.load(cfg.url, gltf => {\n    const root = gltf.scene;\n    // 1. 归一化高度到 1.8m\n    // 先更新整棵骨骼树，再计算蒙皮顶点，避免读取尚未更新的骨骼矩阵。\n    root.updateMatrixWorld(true);\n    let box = new THREE.Box3().setFromObject(root, true);\n    const size = box.getSize(new THREE.Vector3());\n    const scale = (1.8 / size.y) * cfg.scale;\n    root.scale.setScalar(scale);\n\n    // 2. 绑定姿势已在 Blender 校准；不能再按骨骼名字猜旋转角度。\n    let rigged = false;\n    root.traverse(o => { if (o.isSkinnedMesh) rigged = true; });\n    if (!rigged) {\n      // 没骨骼的兜底：整体微微前倾 3 度\n      root.rotation.x = 0.05;\n    }\n\n    // 3. 朝向\n    if (cfg.rotY !== undefined) root.rotation.y = cfg.rotY;\n\n    // 4. 重新计算 box 并把脚底贴地（FLOOR_Y 是背景地板的高度）\n    root.updateMatrixWorld(true);\n    box = new THREE.Box3().setFromObject(root, true);\n    root.position.set(cfg.position[0], FLOOR_Y - box.min.y, cfg.position[2]);\n    root.userData.npcKey = key;\n    root.traverse(o => {\n      if (o.isMesh) {\n        o.castShadow = true;\n        o.receiveShadow = true;\n        o.userData.npcKey = key;\n      }\n    });\n    scene.add(root);\n    const hitbox = createNpcHitbox(root, key);\n\n    const idle = THREE.AnimationClip.findByName(gltf.animations, \'Idle\');\n    const phase = Object.keys(NPC_CONFIG).indexOf(key) * 3.7;\n    const motion = rigged && idle ? new CharacterMotion(root, gltf.animations, phase) : null;\n    const mixer = motion?.mixer || null;\n    const idleAction = motion?.actions.Idle || null;\n    npcs[key] = {\n      root, hitbox, config: cfg, baseY: root.position.y, mixer, idleAction, motion,\n      fittedHeight: box.max.y - box.min.y,\n      clips: gltf.animations.map(clip => clip.name),\n    };\n    tickLoad();\n  }, undefined, () => {\n    console.warn(`${cfg.name} GLB 未找到,使用占位胶囊`);\n    const mesh = new THREE.Mesh(\n      new THREE.CapsuleGeometry(0.35, 1.0, 8, 16),\n      new THREE.MeshStandardMaterial({ color: cfg.color, roughness: 0.6 })\n    );\n    mesh.position.set(cfg.position[0], FLOOR_Y + 0.9, cfg.position[2]);\n    mesh.castShadow = true;\n    mesh.userData.npcKey = key;\n    scene.add(mesh);\n    npcs[key] = { root: mesh, config: cfg, baseY: mesh.position.y };\n    tickLoad();\n  });\n}\nObject.entries(NPC_CONFIG).forEach(([k, v]) => loadNPC(k, v));\n\n// ============== 交互：射线检测 hover/click ==============\nconst raycaster = new THREE.Raycaster();\nconst pointer = new THREE.Vector2();\nlet hoverKey = null;\nlet activeKey = null;\nlet pointerGesture = null;\nconst activePointers = new Set();\nconst hoverLabel = document.getElementById(\'hoverLabel\');\nconst dialog = document.getElementById(\'dialog\');\nconst npcBubble = document.getElementById(\'npcBubble\');\nconst sidePanel = document.getElementById(\'sidePanel\');\nconst panelToggle = document.getElementById(\'panelToggle\');\nconst tourRail = document.querySelector(\'.tour-rail\');\nconst firstGuide = document.getElementById(\'firstGuide\');\nconst firstGuideStart = document.getElementById(\'firstGuideStart\');\nconst firstGuideSkip = document.getElementById(\'firstGuideSkip\');\nconst tourPath = document.getElementById(\'tourPath\');\nconst tourStops = document.querySelectorAll(\'.tour-stop\');\nconst tourPrev = document.getElementById(\'tourPrev\');\nconst tourNext = document.getElementById(\'tourNext\');\nconst stationStep = document.getElementById(\'stationStep\');\nconst stationName = document.getElementById(\'stationName\');\nconst stationLine = document.getElementById(\'stationLine\');\nconst stationQuestion = document.getElementById(\'stationQuestion\');\nconst stationTakeaway = document.getElementById(\'stationTakeaway\');\nconst stationActionHint = document.getElementById(\'stationActionHint\');\nconst stationAction = document.getElementById(\'stationAction\');\nconst stationThread = document.getElementById(\'stationThread\');\nconst stationThreadTrail = document.getElementById(\'stationThreadTrail\');\nconst stationThreadFocus = document.getElementById(\'stationThreadFocus\');\nconst forgeBeat = document.getElementById(\'forgeBeat\');\nconst forgeBeatNow = document.getElementById(\'forgeBeatNow\');\nconst forgeBeatEcho = document.getElementById(\'forgeBeatEcho\');\nconst forgeBeatNext = document.getElementById(\'forgeBeatNext\');\nconst forgeEcho = document.getElementById(\'forgeEcho\');\nconst forgeEchoLine = document.getElementById(\'forgeEchoLine\');\nconst forgeEchoNext = document.getElementById(\'forgeEchoNext\');\nconst stationRelayKicker = document.getElementById(\'stationRelayKicker\');\nconst stationRelayText = document.getElementById(\'stationRelayText\');\nconst stationPin = document.getElementById(\'stationPin\');\nconst stationFocusHalo = document.getElementById(\'stationFocusHalo\');\nconst stationFocusLabel = document.getElementById(\'stationFocusLabel\');\nconst stationHotspots = document.getElementById(\'stationHotspots\');\nconst pinStep = document.getElementById(\'pinStep\');\nconst pinTitle = document.getElementById(\'pinTitle\');\nconst pinLine = document.getElementById(\'pinLine\');\nconst tourProgressText = document.getElementById(\'tourProgressText\');\nconst tourProgressBar = document.getElementById(\'tourProgressBar\');\nconst tourProgressFill = document.getElementById(\'tourProgressFill\');\nconst tourNextCue = document.getElementById(\'tourNextCue\');\nconst tourGainsList = document.getElementById(\'tourGainsList\');\nconst tourStampCurrent = document.getElementById(\'tourStampCurrent\');\nconst tourStampsList = document.getElementById(\'tourStampsList\');\nconst tourSlateToggle = document.getElementById(\'tourSlateToggle\');\nconst tourSlate = document.getElementById(\'tourSlate\');\nconst viewHome = document.getElementById(\'viewHome\');\nconst tourHarvestToggle = document.getElementById(\'tourHarvestToggle\');\nconst tourHarvestDetails = document.getElementById(\'tourHarvestDetails\');\nconst tourReceipt = document.getElementById(\'tourReceipt\');\nconst receiptSummary = document.getElementById(\'receiptSummary\');\nconst receiptOpen = document.getElementById(\'receiptOpen\');\nconst receiptDetails = document.getElementById(\'receiptDetails\');\nconst leaveTicket = document.getElementById(\'leaveTicket\');\nconst leaveTicketSummary = document.getElementById(\'leaveTicketSummary\');\nconst leaveTicketList = document.getElementById(\'leaveTicketList\');\nconst stationDetails = document.getElementById(\'stationDetails\');\nconst stationDetailsToggle = document.getElementById(\'stationDetailsToggle\');\nconst artifactName = document.getElementById(\'artifactName\');\nconst artifactLine = document.getElementById(\'artifactLine\');\nconst artifactInspect = document.getElementById(\'artifactInspect\');\nconst artifactNext = document.getElementById(\'artifactNext\');\nconst dlgTakeaway = document.getElementById(\'dlgTakeaway\');\nconst dlgTakeawayText = document.getElementById(\'dlgTakeawayText\');\nconst visitedTourStops = new Set([\'profile\']);\nconst stationHotspotButtons = {};\nconst tourPathNodes = {};\nconst tourPathLines = [];\nlet firstGuideVisible = true;\nlet stationDetailsOpen = false;\nlet tourSlateOpen = false;\nlet tourHarvestOpen = false;\nlet forgeEchoState = {\n  active: false,\n  line: \'等你落第一锤。\',\n  next: \'点人物、火炉或下方站点后，这里会留下刚刚锻出的结论。\',\n};\n\nfunction createStationHotspots() {\n  TOUR_ORDER.forEach((key, index) => {\n    const station = TOUR_STOPS[key];\n    const btn = document.createElement(\'button\');\n    btn.type = \'button\';\n    btn.className = \'station-hotspot\';\n    btn.dataset.tour = key;\n    btn.innerHTML = `<span class="hotspot-index">${index + 1}</span><span class="hotspot-title">${station.title}</span>`;\n    btn.setAttribute(\'aria-label\', `${station.step} ${station.title}，进入铺内站点`);\n    btn.addEventListener(\'click\', (event) => {\n      event.stopPropagation();\n      goTourStop(key);\n    });\n    stationHotspots.appendChild(btn);\n    stationHotspotButtons[key] = btn;\n  });\n}\n\nfunction svgEl(tag) {\n  return document.createElementNS(\'http://www.w3.org/2000/svg\', tag);\n}\n\nfunction createTourPath() {\n  if (!tourPath) return;\n  TOUR_ORDER.slice(0, -1).forEach((key, index) => {\n    const line = svgEl(\'line\');\n    line.classList.add(\'tour-path-line\');\n    line.dataset.from = key;\n    line.dataset.to = TOUR_ORDER[index + 1];\n    tourPath.appendChild(line);\n    tourPathLines.push(line);\n  });\n  TOUR_ORDER.forEach((key, index) => {\n    const group = svgEl(\'g\');\n    group.dataset.tour = key;\n    const node = svgEl(\'circle\');\n    node.setAttribute(\'r\', \'5\');\n    node.classList.add(\'tour-path-node\');\n    const label = svgEl(\'text\');\n    label.classList.add(\'tour-path-label\');\n    label.textContent = `${index + 1}`;\n    label.setAttribute(\'text-anchor\', \'middle\');\n    label.setAttribute(\'dominant-baseline\', \'central\');\n    group.append(node, label);\n    tourPath.appendChild(group);\n    tourPathNodes[key] = { group, node, label };\n  });\n}\n\nfunction pickTarget(event) {\n  pointer.x = (event.clientX / innerWidth) * 2 - 1;\n  pointer.y = -(event.clientY / innerHeight) * 2 + 1;\n  raycaster.setFromCamera(pointer, camera);\n  const roots = [\n    ...Object.values(npcs).map(n => n.hitbox || n.root),\n    ...Object.values(interactiveObjects).map(o => o.root),\n  ].filter(Boolean);\n  const hits = raycaster.intersectObjects(roots, true);\n  for (const h of hits) {\n    let o = h.object;\n    while (o && !o.userData.npcKey && !o.userData.interactiveKey) o = o.parent;\n    if (o?.userData.npcKey) {\n      const key = o.userData.npcKey;\n      return { type: \'npc\', key, label: NPC_CONFIG[key].name };\n    }\n    if (o?.userData.interactiveKey) {\n      const key = o.userData.interactiveKey;\n      return { type: \'object\', key, label: OBJECT_CONFIG[key]?.name || \'可点击物件\' };\n    }\n  }\n  return null;\n}\n\ncanvas.addEventListener(\'pointerdown\', e => {\n  hoverKey = null;\n  hoverLabel.classList.remove(\'show\');\n  activePointers.add(e.pointerId);\n  if (activePointers.size === 1) {\n    pointerGesture = { x: e.clientX, y: e.clientY, button: e.button, dragged: false };\n  } else if (pointerGesture) {\n    pointerGesture.dragged = true;\n  }\n});\ncanvas.addEventListener(\'pointerup\', e => activePointers.delete(e.pointerId));\ncanvas.addEventListener(\'pointercancel\', e => {\n  activePointers.delete(e.pointerId);\n  if (pointerGesture) pointerGesture.dragged = true;\n});\ncanvas.addEventListener(\'pointerleave\', () => {\n  hoverKey = null;\n  hoverLabel.classList.remove(\'show\');\n});\ncanvas.addEventListener(\'pointermove\', e => {\n  if (activePointers.size && pointerGesture &&\n      Math.hypot(e.clientX - pointerGesture.x, e.clientY - pointerGesture.y) > 6) {\n    pointerGesture.dragged = true;\n  }\n  if (activePointers.size || e.pointerType === \'touch\') {\n    hoverKey = null;\n    hoverLabel.classList.remove(\'show\');\n    return;\n  }\n  const target = pickTarget(e);\n  const hoverId = target ? `${target.type}:${target.key}` : null;\n  if (hoverId !== hoverKey) {\n    hoverKey = hoverId;\n    canvas.style.cursor = target ? \'pointer\' : \'grab\';\n  }\n  if (target) {\n    hoverLabel.textContent = target.label;\n    hoverLabel.style.left = e.clientX + \'px\';\n    hoverLabel.style.top = e.clientY + \'px\';\n    hoverLabel.classList.add(\'show\');\n  } else {\n    hoverLabel.classList.remove(\'show\');\n  }\n});\n\ncanvas.addEventListener(\'click\', e => {\n  const gesture = pointerGesture;\n  pointerGesture = null;\n  if (!gesture || gesture.dragged || gesture.button !== 0) return;\n  const target = pickTarget(e);\n  if (!target) return;\n  if (target.type === \'npc\') {\n    selectNPC(target.key);\n  } else {\n    selectObject(target.key);\n  }\n});\ncanvas.addEventListener(\'dblclick\', e => {\n  if (pickTarget(e)) return;\n  resetOverview();\n});\n\nfunction respondNPC(key, selected = false) {\n  if (reducedMotion && !selected) return false;\n  npcs[key]?.motion?.respond(selected);\n}\n\nfunction showBubble(id, root, text, duration = 3200) {\n  bubbleKey = id;\n  bubbleRoot = root;\n  npcBubble.textContent = text;\n  npcBubble.classList.add(\'show\');\n  updateNPCBubblePosition();\n  clearTimeout(bubbleTimer);\n  bubbleTimer = setTimeout(() => {\n    hideNPCBubble(id);\n  }, duration);\n}\n\nfunction showNPCBubble(key, text, duration = 3200) {\n  showBubble(`npc:${key}`, npcs[key]?.root, text, duration);\n}\n\nfunction showObjectBubble(key, text, duration = 3200) {\n  showBubble(`object:${key}`, interactiveObjects[key]?.root, text, duration);\n}\n\nfunction hideNPCBubble(key = null) {\n  if (key && bubbleKey && key !== bubbleKey && `npc:${key}` !== bubbleKey && `object:${key}` !== bubbleKey) return;\n  npcBubble.classList.remove(\'show\');\n  if (!key || key === bubbleKey || `npc:${key}` === bubbleKey || `object:${key}` === bubbleKey) {\n    bubbleKey = null;\n    bubbleRoot = null;\n  }\n}\n\nfunction updateNPCBubblePosition() {\n  if (!bubbleKey || !bubbleRoot) return;\n  const box = new THREE.Box3().setFromObject(bubbleRoot);\n  const top = box.getCenter(new THREE.Vector3());\n  top.y = box.max.y + 0.2;\n  top.project(camera);\n  const x = (top.x * 0.5 + 0.5) * innerWidth;\n  const y = (-top.y * 0.5 + 0.5) * innerHeight;\n  const w = npcBubble.offsetWidth || 300;\n  const h = npcBubble.offsetHeight || 64;\n  const margin = 16;\n  npcBubble.style.left = Math.max(w / 2 + margin, Math.min(innerWidth - w / 2 - margin, x)) + \'px\';\n  npcBubble.style.top = Math.max(h * 1.35 + margin, Math.min(innerHeight - margin, y)) + \'px\';\n}\n\nfunction worldToViewport(position) {\n  const point = position.clone();\n  point.project(camera);\n  return {\n    x: (point.x * 0.5 + 0.5) * innerWidth,\n    y: (-point.y * 0.5 + 0.5) * innerHeight,\n    behind: point.z > 1,\n  };\n}\n\nfunction getStationPinPosition(type = activeTourType) {\n  const station = TOUR_STOPS[type] || TOUR_STOPS.profile;\n  const root = station.npc ? npcs[station.npc]?.root : interactiveObjects[station.object]?.root;\n  if (root) {\n    const box = new THREE.Box3().setFromObject(root);\n    const pos = box.getCenter(new THREE.Vector3());\n    pos.y = box.max.y + (station.object ? 0.18 : 0.26);\n    return pos;\n  }\n  return new THREE.Vector3(...(station.pin || TOUR_STOPS.profile.pin));\n}\n\nfunction getStationHotspotPosition(type) {\n  const pos = getStationPinPosition(type);\n  const station = TOUR_STOPS[type] || TOUR_STOPS.profile;\n  pos.y -= station.object ? 0.32 : 0.58;\n  if (station.hotspotOffset) {\n    pos.x += station.hotspotOffset[0] || 0;\n    pos.y += station.hotspotOffset[1] || 0;\n    pos.z += station.hotspotOffset[2] || 0;\n  }\n  return pos;\n}\n\nfunction getStationFocusPosition(type = activeTourType) {\n  const station = TOUR_STOPS[type] || TOUR_STOPS.profile;\n  const root = station.npc ? npcs[station.npc]?.root : interactiveObjects[station.object]?.root;\n  if (root) {\n    const box = new THREE.Box3().setFromObject(root);\n    const pos = box.getCenter(new THREE.Vector3());\n    pos.y = station.object\n      ? box.min.y + Math.max(0.42, (box.max.y - box.min.y) * 0.45)\n      : box.min.y + Math.max(0.95, (box.max.y - box.min.y) * 0.5);\n    return pos;\n  }\n  const fallback = new THREE.Vector3(...(station.pin || TOUR_STOPS.profile.pin));\n  fallback.y -= station.object ? 0.48 : 0.68;\n  return fallback;\n}\n\nfunction applyStationTone(type = activeTourType) {\n  const toneKey = STATION_TONES[type] ? type : \'profile\';\n  const tone = STATION_TONES[toneKey];\n  const rootStyle = document.documentElement.style;\n  rootStyle.setProperty(\'--station-accent\', tone.accent);\n  rootStyle.setProperty(\'--station-accent-rgb\', tone.accentRgb);\n  rootStyle.setProperty(\'--station-soft-rgb\', tone.softRgb);\n  rootStyle.setProperty(\'--station-deep-rgb\', tone.deepRgb);\n  document.body.dataset.stationTone = toneKey;\n  stationToneLight.color.setHex(tone.light);\n  stationToneLight.position.copy(getStationFocusPosition(toneKey));\n  stationToneLight.userData.tone = toneKey;\n}\n\nfunction updateStationPinPosition() {\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const screen = worldToViewport(getStationPinPosition(activeTourType));\n  const width = stationPin.offsetWidth || 150;\n  const height = stationPin.offsetHeight || 54;\n  const margin = 14;\n  const hiddenByRail = innerWidth <= 640 && screen.y > innerHeight - 330;\n  const visible = !screen.behind && !hiddenByRail;\n  stationPin.classList.toggle(\'show\', visible);\n  if (!visible) return;\n  stationPin.style.left = Math.max(width / 2 + margin, Math.min(innerWidth - width / 2 - margin, screen.x)) + \'px\';\n  stationPin.style.top = Math.max(height * 1.35 + margin, Math.min(innerHeight - margin, screen.y)) + \'px\';\n}\n\nfunction updateStationHotspots() {\n  const nextKey = getNextTourKey();\n  Object.entries(stationHotspotButtons).forEach(([key, btn]) => {\n    const screen = worldToViewport(getStationHotspotPosition(key));\n    const width = btn.offsetWidth || 74;\n    const height = btn.offsetHeight || 30;\n    const margin = 12;\n    const hiddenByRail = innerWidth <= 640 && screen.y > innerHeight - 318;\n    const visible = !screen.behind && !hiddenByRail;\n    btn.classList.toggle(\'show\', visible);\n    btn.classList.toggle(\'active\', key === activeTourType);\n    btn.classList.toggle(\'next\', key === nextKey);\n    btn.classList.toggle(\'visited\', visitedTourStops.has(key));\n    btn.setAttribute(\'aria-current\', key === activeTourType ? \'step\' : \'false\');\n    if (!visible) return;\n    btn.style.left = Math.max(width / 2 + margin, Math.min(innerWidth - width / 2 - margin, screen.x)) + \'px\';\n    btn.style.top = Math.max(height / 2 + margin, Math.min(innerHeight - height / 2 - margin, screen.y)) + \'px\';\n  });\n}\n\nfunction updateStationFocusHalo() {\n  if (!stationFocusHalo || !stationFocusLabel) return;\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const tone = STATION_TONES[activeTourType] || STATION_TONES.profile;\n  stationToneLight.position.copy(getStationFocusPosition(activeTourType));\n  let screen = worldToViewport(getStationFocusPosition(activeTourType));\n  let forceVisible = false;\n  if (innerWidth <= 640) {\n    const hotspotRect = stationHotspotButtons[activeTourType]?.getBoundingClientRect();\n    if (hotspotRect?.width && hotspotRect?.height) {\n      screen = {\n        x: hotspotRect.left + hotspotRect.width / 2,\n        y: hotspotRect.top + hotspotRect.height / 2,\n        behind: false,\n      };\n      forceVisible = true;\n    } else {\n      screen = worldToViewport(getStationPinPosition(activeTourType));\n    }\n  }\n  const railTop = tourRail?.getBoundingClientRect().top ?? innerHeight;\n  const hiddenByRail = innerWidth <= 640 && screen.y > railTop - 40;\n  const visible = (forceVisible || !screen.behind) && !hiddenByRail;\n  stationFocusHalo.classList.toggle(\'show\', visible);\n  stationFocusLabel.textContent = tone.label || `${station.track}落锤`;\n  stationFocusHalo.setAttribute(\'title\', tone.line);\n  stationFocusHalo.setAttribute(\'data-tour\', activeTourType);\n  if (!visible) return;\n  const margin = innerWidth <= 640 ? 44 : 56;\n  stationFocusHalo.style.left = Math.max(margin, Math.min(innerWidth - margin, screen.x)) + \'px\';\n  stationFocusHalo.style.top = Math.max(margin, Math.min(innerHeight - margin, screen.y)) + \'px\';\n}\n\nfunction getTourPathPoint(type) {\n  const screen = worldToViewport(getStationHotspotPosition(type));\n  const railTop = tourRail?.getBoundingClientRect().top ?? innerHeight;\n  const hiddenByRail = innerWidth <= 640 && screen.y > railTop - 24;\n  return {\n    ...screen,\n    visible: !screen.behind && !hiddenByRail,\n    x: Math.max(16, Math.min(innerWidth - 16, screen.x)),\n    y: Math.max(18, Math.min(innerHeight - 18, screen.y)),\n  };\n}\n\nfunction updateTourPath() {\n  if (!tourPath) return;\n  const nextKey = getNextTourKey();\n  const points = {};\n  TOUR_ORDER.forEach(key => {\n    points[key] = getTourPathPoint(key);\n  });\n  tourPathLines.forEach(line => {\n    const fromKey = line.dataset.from;\n    const toKey = line.dataset.to;\n    const from = points[fromKey];\n    const to = points[toKey];\n    const visible = from?.visible && to?.visible;\n    line.style.display = visible ? \'\' : \'none\';\n    if (!visible) return;\n    line.setAttribute(\'x1\', from.x);\n    line.setAttribute(\'y1\', from.y);\n    line.setAttribute(\'x2\', to.x);\n    line.setAttribute(\'y2\', to.y);\n    const visited = visitedTourStops.has(fromKey) && visitedTourStops.has(toKey);\n    line.classList.toggle(\'visited\', visited);\n    line.classList.toggle(\'next\', fromKey === activeTourType && toKey === nextKey);\n  });\n  Object.entries(tourPathNodes).forEach(([key, parts]) => {\n    const point = points[key];\n    parts.group.style.display = point?.visible ? \'\' : \'none\';\n    if (!point?.visible) return;\n    parts.group.setAttribute(\'transform\', `translate(${point.x} ${point.y})`);\n    const active = key === activeTourType;\n    const next = key === nextKey;\n    const visited = visitedTourStops.has(key);\n    parts.node.classList.toggle(\'active\', active);\n    parts.node.classList.toggle(\'next\', next);\n    parts.node.classList.toggle(\'visited\', visited && !active && !next);\n    parts.label.textContent = active ? \'锤\' : (next ? \'下\' : String(TOUR_ORDER.indexOf(key) + 1));\n  });\n}\n\nfunction togglePanel(force) {\n  const show = typeof force === \'boolean\' ? force : !sidePanel.classList.contains(\'show\');\n  sidePanel.classList.toggle(\'show\', show);\n  panelToggle.textContent = show ? \'✕ 收起面板\' : \'⚙️ 控制面板\';\n}\n\nfunction setFirstGuideVisible(visible, announce = false) {\n  firstGuideVisible = !!visible;\n  firstGuide?.classList.toggle(\'hide\', !firstGuideVisible);\n  firstGuide?.setAttribute(\'aria-hidden\', firstGuideVisible ? \'false\' : \'true\');\n  if (announce) {\n    showContextBubble(firstGuideVisible\n      ? \'首锤引导已展开：四站逛完就知道这间铺子的火候。\'\n      : \'首锤引导已收起：直接按四站路线或拖拽看铺子。\', 3000);\n  }\n}\n\nfunction startFirstGuide() {\n  setFirstGuideVisible(false);\n  goTourStop(\'profile\');\n  setForgeEcho(\'刚刚：从老杨站开始巡铺。\', \'下一锤：去 iLoop 看五锤闭环。\');\n  showContextBubble(\'第一锤从老杨开始：先看主人，再看主炉 iLoop。\', 3800);\n}\n\nfunction getRandomTalkDelay() {\n  return 7000 + Math.random() * 7000;\n}\n\nfunction setActiveNpcButton(key) {\n  document.querySelectorAll(\'.npc-btn[data-npc]\').forEach(b => {\n    b.classList.toggle(\'active\', b.dataset.npc === key);\n  });\n}\n\nfunction setStationDetailsOpen(open, announce = false) {\n  stationDetailsOpen = !!open;\n  stationDetails.classList.toggle(\'show\', stationDetailsOpen);\n  stationDetailsToggle.setAttribute(\'aria-expanded\', stationDetailsOpen ? \'true\' : \'false\');\n  stationDetailsToggle.textContent = stationDetailsOpen ? \'收起读牌\' : \'读牌\';\n  stationDetailsToggle.setAttribute(\n    \'aria-label\',\n    `${stationDetailsOpen ? \'收起\' : \'展开\'}${TOUR_STOPS[activeTourType]?.title || \'本站\'}的问题、带走结论和物证`\n  );\n  if (announce) {\n    showContextBubble(stationDetailsOpen ? \'读牌展开：先看问题、再看物证。\' : \'读牌收起：先看铺子，再按站点走。\', 2800);\n  }\n}\n\nfunction renderTourSlateToggle() {\n  const visitedCount = visitedTourStops.size;\n  const totalCount = TOUR_ORDER.length;\n  const label = tourSlateOpen ? \'收起炉牌\' : \'炉牌\';\n  const countText = `${visitedCount}/${totalCount}`;\n  tourSlateToggle.classList.toggle(\'has-progress\', visitedCount > 1 || tourSlateOpen);\n  tourSlateToggle.innerHTML = `${label}<span class="slate-count" id="tourSlateCount">${countText}</span>`;\n}\n\nfunction setTourSlateOpen(open, announce = false) {\n  tourSlateOpen = !!open;\n  tourSlate.classList.toggle(\'show\', tourSlateOpen);\n  tourSlateToggle.setAttribute(\'aria-expanded\', tourSlateOpen ? \'true\' : \'false\');\n  renderTourSlateToggle();\n  tourSlateToggle.setAttribute(\n    \'aria-label\',\n    `${tourSlateOpen ? \'收起\' : \'展开\'}炉前三拍、巡铺进度、接力、锤后炉印和收获袋`\n  );\n  if (announce) {\n    showContextBubble(tourSlateOpen ? \'炉牌展开：三拍、进度和炉印都在这里。\' : \'炉牌收起：先看当前站和铺子主体。\', 2800);\n  }\n}\n\nfunction renderStationArtifact() {\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const artifacts = station.artifacts || [];\n  const artifact = artifacts[activeArtifactIndex % Math.max(1, artifacts.length)];\n  artifactName.textContent = artifact?.name || \'铺内物证\';\n  artifactLine.textContent = artifact?.line || \'这枚痕迹还在等下一轮补充。\';\n  artifactInspect.setAttribute(\'aria-label\', `鉴定${station.title}的${artifact?.name || \'铺内物证\'}`);\n  artifactNext.hidden = artifacts.length < 2;\n  artifactNext.setAttribute(\'aria-label\', `切换${station.title}的铺内物证`);\n}\n\nfunction renderTourGains() {\n  tourGainsList.innerHTML = \'\';\n  TOUR_ORDER.forEach(key => {\n    const station = TOUR_STOPS[key];\n    const collected = visitedTourStops.has(key);\n    const item = document.createElement(\'span\');\n    item.className = `tour-gain${collected ? \' collected\' : \'\'}${key === activeTourType ? \' active\' : \'\'}`;\n    item.textContent = collected ? station.gain : `${station.track}待收`;\n    item.setAttribute(\'aria-label\', `${station.title}：${collected ? station.gain : \'还没有访问\'}`);\n    tourGainsList.appendChild(item);\n  });\n}\n\nfunction renderTourStamps() {\n  const activeStation = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  tourStampCurrent.textContent = `刚锻出：${activeStation.stamp || activeStation.takeaway}`;\n  tourStampsList.innerHTML = \'\';\n  TOUR_ORDER.forEach(key => {\n    const station = TOUR_STOPS[key];\n    const collected = visitedTourStops.has(key);\n    const item = document.createElement(\'span\');\n    item.className = `tour-stamp${collected ? \' collected\' : \'\'}${key === activeTourType ? \' active\' : \'\'}`;\n    item.textContent = collected ? station.stamp : `${station.track}待落锤`;\n    item.setAttribute(\'aria-label\', `${station.title}：${collected ? station.stamp : \'还没有留下炉印便签\'}`);\n    tourStampsList.appendChild(item);\n  });\n}\n\nfunction renderLeaveTicket(complete) {\n  if (!leaveTicket || !leaveTicketSummary || !leaveTicketList) return;\n  leaveTicket.hidden = !complete;\n  leaveTicket.classList.toggle(\'show\', complete);\n  leaveTicketSummary.textContent = complete\n    ? \'带走三件事：认识主人、记住闭环、带着证据来开炉。\'\n    : \'四站走完后，这里会留下可带走的三条炉印。\';\n  leaveTicketList.innerHTML = \'\';\n  TOUR_RECEIPT_DETAILS.forEach(detail => {\n    const item = document.createElement(\'span\');\n    item.className = \'leave-ticket-item\';\n    const label = document.createElement(\'strong\');\n    label.textContent = detail.label;\n    const text = document.createElement(\'span\');\n    text.textContent = detail.text;\n    item.append(label, text);\n    leaveTicketList.appendChild(item);\n  });\n  leaveTicket.setAttribute(\n    \'aria-label\',\n    complete ? `离铺炉票：${leaveTicketSummary.textContent}` : \'离铺炉票：四站完成后显示\'\n  );\n}\n\nfunction renderStationThread() {\n  if (!stationThreadTrail || !stationThreadFocus) return;\n  const nextKey = getNextTourKey();\n  stationThreadTrail.innerHTML = \'\';\n  TOUR_ORDER.forEach((key, index) => {\n    const station = TOUR_STOPS[key];\n    const mark = document.createElement(\'span\');\n    const active = key === activeTourType;\n    const next = key === nextKey;\n    const visited = visitedTourStops.has(key);\n    mark.className = `thread-mark${visited ? \' visited\' : \'\'}${active ? \' active\' : \'\'}${next ? \' next\' : \'\'}`;\n    mark.textContent = station.track;\n    mark.setAttribute(\n      \'aria-label\',\n      `${station.title}：${station.track}${active ? \'，当前站\' : \'\'}${visited ? \'，已看\' : \'\'}${next ? \'，下一锤\' : \'\'}`\n    );\n    stationThreadTrail.appendChild(mark);\n    if (index < TOUR_ORDER.length - 1) {\n      const separator = document.createElement(\'span\');\n      separator.className = \'thread-separator\';\n      separator.setAttribute(\'aria-hidden\', \'true\');\n      separator.textContent = \'>\';\n      stationThreadTrail.appendChild(separator);\n    }\n  });\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const nextText = nextKey ? `下一锤：${TOUR_STOPS[nextKey].track}` : \'四站已合炉\';\n  stationThreadFocus.textContent = `当前：${station.track} · ${nextText}`;\n  stationThread?.setAttribute(\'aria-label\', `巡铺炉脉：当前在${station.track}，${nextText}`);\n}\n\nfunction renderForgeEcho() {\n  if (!forgeEcho || !forgeEchoLine || !forgeEchoNext) return;\n  forgeEchoLine.textContent = forgeEchoState.line;\n  forgeEchoNext.textContent = forgeEchoState.next;\n  forgeEcho.classList.toggle(\'active\', forgeEchoState.active);\n  forgeEcho.setAttribute(\'aria-label\', `炉边回声：${forgeEchoState.line} ${forgeEchoState.next}`);\n  renderForgeBeat();\n}\n\nfunction setForgeEcho(line, next = \'\', active = true) {\n  forgeEchoState = {\n    active,\n    line,\n    next,\n  };\n  renderForgeEcho();\n}\n\nfunction getForgeBeatNextLabel() {\n  const nextKey = getNextTourKey();\n  if (nextKey) {\n    const station = TOUR_STOPS[nextKey];\n    return `去 ${station.title} 看${station.track}。`;\n  }\n  return \'四站已齐，看炉印或回火炉。\';\n}\n\nfunction renderForgeBeat() {\n  if (!forgeBeat || !forgeBeatNow || !forgeBeatEcho || !forgeBeatNext) return;\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const echoLine = forgeEchoState.active ? forgeEchoState.line : \'等你落第一锤。\';\n  const nextLine = (forgeEchoState.active && forgeEchoState.next ? forgeEchoState.next : getForgeBeatNextLabel())\n    .replace(/^(下一步|下一锤)：/, \'\');\n  forgeBeatNow.textContent = `${station.track} · ${station.title}`;\n  forgeBeatEcho.textContent = echoLine;\n  forgeBeatNext.textContent = nextLine;\n  forgeBeat.setAttribute(\n    \'aria-label\',\n    `炉前三拍：当前${station.track}，刚刚${echoLine} 下一步${nextLine}`\n  );\n}\n\nfunction getStationEcho(station, reason = \'station\') {\n  const nextKey = getNextTourKey();\n  if (reason === \'action\') {\n    return {\n      line: `刚敲：${station.actionLabel}。${station.takeaway}`,\n      next: nextKey ? `下一步：去${TOUR_STOPS[nextKey].title}看${TOUR_STOPS[nextKey].track}。` : \'下一步：四站已齐，可以看炉印或再锻一句。\',\n    };\n  }\n  return {\n    line: `刚到：${station.title}。${station.takeaway}`,\n    next: nextKey ? `下一锤：${TOUR_STOPS[nextKey].title} · ${TOUR_STOPS[nextKey].track}。` : \'四站已合炉：可以看回执或回火炉再试一次。\',\n  };\n}\n\nfunction setTourHarvestOpen(open, announce = false) {\n  tourHarvestOpen = !!open;\n  tourHarvestDetails.classList.toggle(\'show\', tourHarvestOpen);\n  tourHarvestToggle.setAttribute(\'aria-expanded\', tourHarvestOpen ? \'true\' : \'false\');\n  tourHarvestToggle.textContent = tourHarvestOpen ? \'收起袋\' : \'收获袋\';\n  const visitedCount = visitedTourStops.size;\n  tourHarvestToggle.setAttribute(\n    \'aria-label\',\n    `${tourHarvestOpen ? \'收起\' : \'展开\'}已收下的巡铺结论和炉印便签，当前已看 ${visitedCount} 站`\n  );\n  if (announce) {\n    showContextBubble(tourHarvestOpen ? \'收获袋展开：回看已收结论和四枚炉印。\' : \'收获袋收起：先保留当前这一锤。\', 2800);\n  }\n}\n\nfunction getNextTourKey() {\n  const currentIndex = Math.max(0, TOUR_ORDER.indexOf(activeTourType));\n  return TOUR_ORDER\n    .slice(currentIndex + 1)\n    .concat(TOUR_ORDER.slice(0, currentIndex))\n    .find(key => !visitedTourStops.has(key)) || null;\n}\n\nfunction getActiveArtifact() {\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const artifacts = station.artifacts || [];\n  const artifact = artifacts[activeArtifactIndex % Math.max(1, artifacts.length)];\n  return { station, artifact };\n}\n\nfunction renderTourReceipt() {\n  const stationNames = TOUR_ORDER\n    .filter(key => visitedTourStops.has(key))\n    .map(key => TOUR_STOPS[key].title)\n    .join(\' / \');\n  renderDialog({\n    name: \'巡铺炉印 · 四站回执\',\n    meta: `已看 ${visitedTourStops.size}/${TOUR_ORDER.length} · ${stationNames}`,\n    line: `${TOUR_RECEIPT_SUMMARY} 下面三条，是这趟巡铺最该带走的炉印。`,\n    details: TOUR_RECEIPT_DETAILS,\n    takeaway: \'四站合炉：认识主人、记住闭环、带着证据来开炉。\',\n    actions: [\n      { label: \'回炉再锻\', type: \'forge\' },\n      { label: \'重走一遍\', type: \'tour_restart\' },\n    ],\n    allowVoice: false,\n  });\n  selectedObjectKey = \'forge\';\n  activeKey = null;\n  setActiveNpcButton(null);\n  setForgeEcho(\'刚刚：看完四站炉印回执。\', \'收获：身份、方法、试火和反馈已经合成一枚可带走的炉印。\');\n  showContextBubble(\'四站炉印已合成，回炉再看一眼火候。\', 4600);\n}\n\nfunction inspectActiveArtifact() {\n  const { station, artifact } = getActiveArtifact();\n  if (!artifact) return;\n  setStationDetailsOpen(true);\n  activeKey = station.npc || null;\n  selectedObjectKey = station.object || null;\n  setActiveNpcButton(activeKey);\n  const stationActionType = activeTourType === \'forge\' ? \'forge\' : activeTourType;\n  renderDialog({\n    name: `物证鉴定 · ${artifact.name}`,\n    meta: `${station.step} · ${station.title} · ${artifact.label || \'铺内物证\'}`,\n    line: `是什么：${artifact.line} 说明老杨：${artifact.reading || station.cue} 下一步：${artifact.next || station.cue}`,\n    takeaway: station.mark,\n    actions: [\n      { label: stationActionType === \'forge\' ? \'再锻一句\' : \'看本站说明\', type: stationActionType },\n      { label: \'换一枚物证\', type: \'artifact_next\' },\n    ],\n    allowVoice: false,\n  });\n  setForgeEcho(`刚鉴定：${artifact.name}。`, artifact.next || station.takeaway);\n  showContextBubble(`${artifact.name}：${artifact.line}`, 4600);\n}\n\nfunction setActiveTourStop(type, options = {}) {\n  const previousType = activeTourType;\n  activeTourType = TOUR_STOPS[type] ? type : \'profile\';\n  applyStationTone(activeTourType);\n  if (activeTourType !== previousType || options.resetArtifact) {\n    activeArtifactIndex = 0;\n  }\n  visitedTourStops.add(activeTourType);\n  const nextKey = getNextTourKey();\n  tourStops.forEach(stop => {\n    const active = stop.dataset.tour === activeTourType;\n    const visited = visitedTourStops.has(stop.dataset.tour);\n    const next = stop.dataset.tour === nextKey;\n    stop.classList.toggle(\'active\', active);\n    stop.classList.toggle(\'next\', next);\n    stop.classList.toggle(\'visited\', visited);\n    stop.setAttribute(\'aria-current\', active ? \'step\' : \'false\');\n    const stopConfig = TOUR_STOPS[stop.dataset.tour];\n    stop.querySelector(\'.tour-track\').textContent = stopConfig.track;\n    const scent = stop.querySelector(\'.tour-scent\');\n    if (scent) scent.textContent = stopConfig.scent;\n    stop.setAttribute(\'aria-label\', `${stopConfig.step} ${stopConfig.title}，${stopConfig.track}，${stopConfig.scent}${visited ? \'，已看\' : \'\'}${next ? \'，下一锤\' : \'\'}`);\n  });\n  const station = TOUR_STOPS[activeTourType];\n  stationStep.textContent = station.step;\n  stationName.textContent = station.title;\n  stationLine.textContent = station.cue;\n  stationQuestion.textContent = station.question;\n  stationTakeaway.textContent = station.takeaway;\n  stationActionHint.textContent = station.actionHint;\n  stationAction.textContent = station.actionLabel;\n  stationRelayKicker.textContent = `锻出 · ${station.track}`;\n  stationRelayText.textContent = station.relay;\n  stationAction.setAttribute(\'aria-label\', `${station.step} ${station.title}：${station.actionHint}`);\n  pinStep.textContent = station.step;\n  pinTitle.textContent = station.title;\n  pinLine.textContent = station.pinLine;\n  const visitedCount = visitedTourStops.size;\n  const totalCount = TOUR_ORDER.length;\n  const nextText = visitedCount >= totalCount\n    ? \'巡铺完成：可以回火炉再锻一句\'\n    : `下一站：${TOUR_STOPS[nextKey].title}`;\n  tourProgressText.textContent = `已看 ${visitedCount}/${totalCount}`;\n  tourProgressBar.setAttribute(\'aria-valuenow\', String(visitedCount));\n  tourProgressBar.setAttribute(\'aria-valuetext\', `已看 ${visitedCount} 站，共 ${totalCount} 站`);\n  tourProgressFill.style.width = `${(visitedCount / totalCount) * 100}%`;\n  tourNextCue.textContent = nextText;\n  const complete = visitedCount >= totalCount;\n  if (complete && !tourSlateOpen) {\n    setTourSlateOpen(true);\n  }\n  tourReceipt.classList.toggle(\'show\', complete);\n  receiptSummary.textContent = TOUR_RECEIPT_SUMMARY;\n  receiptOpen.setAttribute(\'aria-label\', complete ? \'查看四站巡铺炉印回执\' : \'四站完成后查看炉印回执\');\n  renderTourGains();\n  renderTourStamps();\n  renderLeaveTicket(complete);\n  renderStationThread();\n  renderForgeBeat();\n  setTourSlateOpen(tourSlateOpen);\n  setTourHarvestOpen(tourHarvestOpen);\n  renderStationArtifact();\n  setStationDetailsOpen(stationDetailsOpen);\n  updateStationPinPosition();\n  updateStationHotspots();\n  updateStationFocusHalo();\n  updateTourPath();\n  if (options.sound !== false && (activeTourType !== previousType || options.soundReason)) {\n    StationSound?.strike?.(activeTourType, options.soundReason || \'station\');\n  }\n}\n\nfunction tourTypeForNpc(key) {\n  if (key === \'master\') return \'profile\';\n  if (key === \'yq\') return \'iloop\';\n  if (key === \'apprentice\') return \'latest\';\n  return null;\n}\n\nfunction tourTypeForGuide(type) {\n  return [\'profile\', \'iloop\', \'latest\', \'forge\'].includes(type) ? type : null;\n}\n\nfunction renderProcessSteps(activeKey) {\n  const holder = document.getElementById(\'processSteps\');\n  holder.innerHTML = \'\';\n  holder.classList.toggle(\'show\', currentProcessSteps.length > 0);\n  if (currentProcessSteps.length === 0) return;\n\n  currentProcessSteps.forEach(step => {\n    const btn = document.createElement(\'button\');\n    btn.type = \'button\';\n    btn.className = `process-step${step.key === activeKey ? \' active\' : \'\'}`;\n    btn.textContent = step.label;\n    btn.setAttribute(\'aria-pressed\', step.key === activeKey ? \'true\' : \'false\');\n    btn.addEventListener(\'click\', () => showProcessStep(step.key));\n    holder.appendChild(btn);\n  });\n}\n\nfunction showProcessStep(stepKey) {\n  const step = currentProcessSteps.find(item => item.key === stepKey);\n  if (!step) return;\n  document.getElementById(\'dlgLine\').textContent = step.line;\n  renderProcessSteps(step.key);\n  setForgeEcho(`刚看五锤：${step.label}。`, step.line);\n  showContextBubble(step.line, 4600);\n}\n\nfunction renderReceiptDetails(details = []) {\n  receiptDetails.innerHTML = \'\';\n  receiptDetails.classList.toggle(\'show\', details.length > 0);\n  details.forEach(detail => {\n    const item = document.createElement(\'div\');\n    item.className = \'receipt-detail\';\n    const label = document.createElement(\'strong\');\n    label.textContent = detail.label;\n    const text = document.createElement(\'span\');\n    text.textContent = detail.text;\n    item.append(label, text);\n    receiptDetails.appendChild(item);\n  });\n}\n\nfunction renderDialog({ name, meta = \'\', line, actions = [], steps = [], activeStep = \'\', details = [], takeaway = \'\', allowVoice = false }) {\n  document.getElementById(\'dlgName\').textContent = name;\n  const metaEl = document.getElementById(\'dlgMeta\');\n  metaEl.textContent = meta;\n  metaEl.classList.toggle(\'show\', !!meta);\n  document.getElementById(\'dlgLine\').textContent = line;\n  dlgTakeawayText.textContent = takeaway;\n  dlgTakeaway.classList.toggle(\'show\', !!takeaway);\n  dlgTakeaway.setAttribute(\'aria-label\', takeaway ? `匠印短句：${takeaway}` : \'匠印短句\');\n\n  dialogActions = actions;\n  currentProcessSteps = steps;\n  renderReceiptDetails(details);\n  renderProcessSteps(activeStep);\n  [document.getElementById(\'btnPrimary\'), document.getElementById(\'btnSecondary\')].forEach((btn, i) => {\n    const action = actions[i];\n    btn.textContent = action?.label || \'\';\n    btn.style.display = action ? \'\' : \'none\';\n  });\n  document.getElementById(\'btnPlay\').style.display = allowVoice ? \'\' : \'none\';\n  dialog.classList.add(\'show\');\n}\n\nfunction showContextBubble(line, duration = 3800) {\n  if (activeKey && npcs[activeKey]) {\n    showNPCBubble(activeKey, line, duration);\n  } else if (selectedObjectKey && interactiveObjects[selectedObjectKey]) {\n    showObjectBubble(selectedObjectKey, line, duration);\n  } else if (npcs.yq) {\n    showNPCBubble(\'yq\', line, duration);\n  }\n}\n\nfunction openGuideCard(type) {\n  if (type === \'forge\') {\n    forgeWelcome();\n    return;\n  }\n  if (type === \'yq_easter\') {\n    triggerYQEasterEgg();\n    return;\n  }\n  if (type === \'iloop_easter\') {\n    triggerILoopEasterEgg();\n    return;\n  }\n\n  const source = GUIDE_CARDS[type] || GUIDE_CARDS.profile;\n  const card = { ...source };\n  if (type === \'wander\') {\n    card.line = pickRandom([\n      GUIDE_CARDS.wander.line,\n      ...yqLines.slice(0, 8),\n      \'这里是铁匠铺，不是简历；简历负责证明过去，铁匠铺负责展示手感。\',\n    ]);\n  }\n  const tourType = tourTypeForGuide(type);\n  if (tourType) setActiveTourStop(tourType);\n  const station = TOUR_STOPS[tourType || activeTourType] || TOUR_STOPS.profile;\n  renderDialog({ ...card, takeaway: station.mark, allowVoice: false });\n  const nextKey = getNextTourKey();\n  setForgeEcho(\n    `刚打开：${card.name}。${station.takeaway}`,\n    nextKey ? `下一锤：去${TOUR_STOPS[nextKey].title}看${TOUR_STOPS[nextKey].track}。` : \'下一步：四站已齐，可以看炉印或再锻一句。\'\n  );\n  showContextBubble(card.line);\n}\n\nfunction runDialogAction(index) {\n  const action = dialogActions[index];\n  if (!action) return;\n  if (action.url) {\n    return;\n  }\n  if (action.type === \'artifact_next\') {\n    const artifacts = TOUR_STOPS[activeTourType]?.artifacts || [];\n    if (artifacts.length < 2) return;\n    activeArtifactIndex = (activeArtifactIndex + 1) % artifacts.length;\n    renderStationArtifact();\n    inspectActiveArtifact();\n    return;\n  }\n  if (action.type === \'tour_restart\') {\n    visitedTourStops.clear();\n    visitedTourStops.add(\'profile\');\n    activeArtifactIndex = 0;\n    goTourStop(\'profile\');\n    return;\n  }\n  openGuideCard(action.type);\n}\n\nfunction forgeWelcome() {\n  const line = pickRandom(WELCOME_LINES);\n  selectedObjectKey = \'forge\';\n  activeKey = null;\n  setActiveNpcButton(null);\n  setActiveTourStop(\'forge\', { sound: false });\n  applySceneMode(\'forge\');\n  StationSound?.strike?.(\'forge\', \'forge\');\n  forgePulseUntil = performance.now() + 1400;\n  renderDialog({\n    name: \'火炉 · 新欢迎语\',\n    meta: \'锻造完成\',\n    line,\n    takeaway: TOUR_STOPS.forge.mark,\n    actions: [\n      { label: \'再锻一句\', type: \'forge\' },\n      { label: \'看 iLoop\', type: \'iloop\' },\n    ],\n    allowVoice: false,\n  });\n  setForgeEcho(\'刚锻出：一条新的欢迎语。\', line);\n  showObjectBubble(\'forge\', line, 4600);\n}\n\nfunction triggerYQEasterEgg() {\n  const line = pickRandom(YQ_EASTER_LINES);\n  yqClickCount = 0;\n  activeKey = \'yq\';\n  selectedObjectKey = null;\n  setActiveNpcButton(\'yq\');\n  setActiveTourStop(\'iloop\');\n  applySceneMode(\'forge\');\n  forgePulseUntil = performance.now() + 1600;\n  renderDialog({\n    name: \'YQ 发疯模式\',\n    meta: \'连点彩蛋\',\n    line,\n    takeaway: TOUR_STOPS.iloop.mark,\n    actions: [\n      { label: \'看 iLoop\', type: \'iloop\' },\n      { label: \'再发疯\', type: \'yq_easter\' },\n    ],\n    allowVoice: false,\n  });\n  setForgeEcho(\'刚触发：YQ 连点彩蛋。\', line);\n  showNPCBubble(\'yq\', line, 5200);\n  respondNPC(\'yq\', true);\n}\n\nfunction triggerILoopEasterEgg() {\n  const line = \'闭环启动：📋 计划 → 🔍 取证 → 🔧 改动 → 🛠 构建 → ✅ 验证 → 📝 收口。\';\n  activeKey = \'yq\';\n  selectedObjectKey = null;\n  setActiveNpcButton(\'yq\');\n  setActiveTourStop(\'iloop\');\n  forgePulseUntil = performance.now() + 1800;\n  renderDialog({\n    name: \'iLoop 闭环启动\',\n    meta: \'隐藏指令 iLoop\',\n    line,\n    takeaway: TOUR_STOPS.iloop.mark,\n    actions: [\n      { label: \'看 iLoop\', type: \'iloop\' },\n      { label: \'锻造欢迎语\', type: \'forge\' },\n    ],\n    allowVoice: false,\n  });\n  setForgeEcho(\'刚触发：iLoop 闭环指令。\', line);\n  showNPCBubble(\'yq\', line, 5200);\n  respondNPC(\'yq\', true);\n}\n\nfunction triggerRandomAmbientTalk(force = false) {\n  if (dialog.classList.contains(\'show\')) return;\n\n  const now = performance.now();\n  if (!force && now - lastAutoTalkAt < 5000) return;\n  lastAutoTalkAt = now;\n\n  const allKeys = [\'master\', \'apprentice\', \'yq\'];\n  const key = pickRandom(allKeys);\n  const line = (key === \'yq\') ? pickRandom(yqLines) : NPC_CONFIG[key].line;\n\n  respondNPC(key);\n  showNPCBubble(key, line, 3600);\n\n  // 是否出声由当前场景模式决定:舒缓只冒泡,火炉才开口\n  const wantVoice = SCENE_PRESETS[SCENE_MODE]?.npcVoice;\n  if (wantVoice && !(currentAudio && !currentAudio.paused)) {\n    window.onNPCSelected(key, { auto: true });\n  }\n\n}\n\nfunction selectNPC(key) {\n  if (!npcs[key]?.root) return;\n  activeKey = key;\n  selectedObjectKey = null;\n  togglePanel(false);\n  setActiveNpcButton(key);\n  setActiveTourStop(tourTypeForNpc(key));\n\n  if (key === \'yq\') {\n    yqClickCount++;\n    if (yqClickCount >= 5) {\n      triggerYQEasterEgg();\n      return;\n    }\n  } else {\n    yqClickCount = 0;\n  }\n\n  const cfg = NPC_CONFIG[key];\n  renderDialog({\n    name: cfg.name,\n    meta: cfg.meta,\n    line: cfg.line,\n    actions: cfg.actions,\n    steps: key === \'yq\' ? GUIDE_CARDS.iloop.steps : [],\n    activeStep: key === \'yq\' ? GUIDE_CARDS.iloop.activeStep : \'\',\n    takeaway: TOUR_STOPS[activeTourType]?.mark || \'\',\n    allowVoice: !!voiceFiles[key],\n  });\n  const stationEcho = getStationEcho(TOUR_STOPS[activeTourType] || TOUR_STOPS.profile);\n  setForgeEcho(stationEcho.line, stationEcho.next);\n  showNPCBubble(key, cfg.line, 4200);\n  respondNPC(key, true);\n  focusOn(npcs[key].root);\n  onNPCSelected(key);\n}\n\nfunction selectObject(key) {\n  const entry = interactiveObjects[key];\n  const cfg = OBJECT_CONFIG[key];\n  if (!entry || !cfg) return;\n\n  activeKey = null;\n  selectedObjectKey = key;\n  yqClickCount = 0;\n  setActiveNpcButton(null);\n  stopCurrentAudio();\n\n  if (key === \'forge\') {\n    forgeWelcome();\n    return;\n  }\n  setActiveTourStop(key === \'forge\' ? \'forge\' : null);\n  renderDialog({\n    name: cfg.name,\n    meta: cfg.meta,\n    line: cfg.line,\n    actions: cfg.actions,\n    allowVoice: false,\n  });\n  showObjectBubble(key, cfg.line, 4200);\n  focusOn(entry.root);\n}\n\nfunction goTourStop(type) {\n  const stop = TOUR_STOPS[type];\n  if (!stop) return;\n  if (stop.npc) {\n    selectNPC(stop.npc);\n    return;\n  }\n  if (stop.object) {\n    selectObject(stop.object);\n  }\n}\n\nfunction goAdjacentTourStop(direction) {\n  const currentIndex = Math.max(0, TOUR_ORDER.indexOf(activeTourType));\n  const nextIndex = (currentIndex + direction + TOUR_ORDER.length) % TOUR_ORDER.length;\n  goTourStop(TOUR_ORDER[nextIndex]);\n}\n\nfunction runStationAction() {\n  const station = TOUR_STOPS[activeTourType] || TOUR_STOPS.profile;\n  const actionType = station.actionType || activeTourType;\n  if (actionType !== \'forge\') {\n    StationSound?.strike?.(activeTourType, \'action\');\n  }\n  openGuideCard(station.actionType || activeTourType);\n  if (actionType !== \'forge\') {\n    const stationEcho = getStationEcho(station, \'action\');\n    setForgeEcho(stationEcho.line, stationEcho.next);\n  }\n}\n\n// 暴露给外部接你现成的语音逻辑\nwindow.onNPCSelected = function(key, options = {}) {\n  const files = voiceFiles[key];\n  if (!files || files.length === 0) return; // YQ 无语音\n  if (currentAudio) {\n    currentAudio.pause();\n    currentAudio.currentTime = 0;\n  }\n  const url = pickRandom(files);\n  currentAudio = new Audio(url);\n  currentAudioKey = key;\n  currentAudio.addEventListener(\'ended\', () => {\n    if (currentAudioKey === key) {\n      currentAudio = null;\n      currentAudioKey = null;\n    }\n  }, { once: true });\n  currentAudio.play().catch(err => {\n    console.warn(\'语音播放失败:\', err);\n  });\n};\n\nfunction stopCurrentAudio() {\n  if (!currentAudio) return;\n  currentAudio.pause();\n  currentAudio.currentTime = 0;\n  currentAudio = null;\n  currentAudioKey = null;\n}\n\n// 相机平滑飞向某个 NPC\nfunction focusOn(target) {\n  const box = new THREE.Box3().setFromObject(target);\n  const center = box.getCenter(new THREE.Vector3());\n  const targetPos = center.clone();\n  targetPos.y = Math.max(1.15, center.y * 0.9);\n  animateCamera(getCameraPosition(7.2, targetPos), targetPos, reducedMotion ? 0 : 800);\n}\n\nlet cameraTween = 0;\ncontrols.addEventListener(\'start\', () => { cameraTween++; });\nfunction animateCamera(toPos, toTarget, duration) {\n  const tween = ++cameraTween;\n  if (duration <= 0) {\n    camera.position.copy(toPos);\n    controls.target.copy(toTarget);\n    controls.update();\n    return;\n  }\n  const fromPos = camera.position.clone();\n  const fromTarget = controls.target.clone();\n  const start = performance.now();\n  function step(now) {\n    if (tween !== cameraTween) return;\n    const t = Math.min(1, (now - start) / duration);\n    const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; // easeInOut\n    camera.position.lerpVectors(fromPos, toPos, e);\n    controls.target.lerpVectors(fromTarget, toTarget, e);\n    controls.update();\n    if (t < 1) requestAnimationFrame(step);\n  }\n  requestAnimationFrame(step);\n}\n\n// ============== 控件 ==============\npanelToggle.addEventListener(\'click\', (e) => {\n  e.stopPropagation();\n  togglePanel();\n});\n\ndocument.addEventListener(\'click\', (e) => {\n  if (!sidePanel.classList.contains(\'show\')) return;\n  if (sidePanel.contains(e.target) || panelToggle.contains(e.target)) return;\n  togglePanel(false);\n});\n\ndocument.querySelectorAll(\'.npc-btn[data-npc]\').forEach(b => {\n  b.addEventListener(\'click\', () => selectNPC(b.dataset.npc));\n});\ntourStops.forEach(stop => {\n  stop.addEventListener(\'click\', () => goTourStop(stop.dataset.tour));\n});\ntourPrev.addEventListener(\'click\', () => goAdjacentTourStop(-1));\ntourNext.addEventListener(\'click\', () => goAdjacentTourStop(1));\nfirstGuideStart.addEventListener(\'click\', startFirstGuide);\nfirstGuideSkip.addEventListener(\'click\', () => setFirstGuideVisible(false, true));\nstationAction.addEventListener(\'click\', runStationAction);\nstationDetailsToggle.addEventListener(\'click\', () => setStationDetailsOpen(!stationDetailsOpen, true));\ntourSlateToggle.addEventListener(\'click\', () => setTourSlateOpen(!tourSlateOpen, true));\nviewHome.addEventListener(\'click\', resetOverview);\ntourHarvestToggle.addEventListener(\'click\', () => setTourHarvestOpen(!tourHarvestOpen, true));\nreceiptOpen.addEventListener(\'click\', renderTourReceipt);\nartifactInspect.addEventListener(\'click\', inspectActiveArtifact);\nartifactNext.addEventListener(\'click\', () => {\n  const artifacts = TOUR_STOPS[activeTourType]?.artifacts || [];\n  if (artifacts.length < 2) return;\n  setStationDetailsOpen(true);\n  activeArtifactIndex = (activeArtifactIndex + 1) % artifacts.length;\n  renderStationArtifact();\n});\ntourRail.addEventListener(\'keydown\', e => {\n  if (e.key !== \'ArrowLeft\' && e.key !== \'ArrowRight\') return;\n  e.preventDefault();\n  goAdjacentTourStop(e.key === \'ArrowRight\' ? 1 : -1);\n  document.querySelector(`.tour-stop[data-tour="${activeTourType}"]`)?.focus({ preventScroll: true });\n});\ndocument.getElementById(\'btnPrimary\').addEventListener(\'click\', () => runDialogAction(0));\ndocument.getElementById(\'btnSecondary\').addEventListener(\'click\', () => runDialogAction(1));\ndocument.getElementById(\'btnClose\').addEventListener(\'click\', () => {\n  dialog.classList.remove(\'show\');\n  hideNPCBubble();\n  activeKey = null;\n  selectedObjectKey = null;\n  yqClickCount = 0;\n  dialogActions = [];\n  stopCurrentAudio();\n  setActiveNpcButton(null);\n  setActiveTourStop(\'profile\', { sound: false });\n});\ndocument.getElementById(\'btnPlay\').addEventListener(\'click\', () => {\n  if (activeKey) {\n    stopCurrentAudio();\n    window.onNPCSelected(activeKey);\n    respondNPC(activeKey, true);\n  }\n});\ndocument.addEventListener(\'keydown\', e => {\n  if (e.metaKey || e.ctrlKey || e.altKey || e.key.length !== 1) return;\n  typedSecret = (typedSecret + e.key.toLowerCase()).slice(-12);\n  if (typedSecret.endsWith(\'iloop\')) {\n    typedSecret = \'\';\n    triggerILoopEasterEgg();\n  }\n});\ndocument.getElementById(\'cameraDistance\').addEventListener(\'input\', e => {\n  const v = parseFloat(e.target.value);\n  setCameraDistance(v);\n});\ndocument.getElementById(\'fireIntensity\').addEventListener(\'input\', e => {\n  const v = parseFloat(e.target.value);\n  fireLight.intensity = v;\n  furnaceCoreLight.intensity = v * 0.65;\n  benchFillLight.intensity = Math.max(0.25, v * 0.3);\n});\ndocument.getElementById(\'resetView\').addEventListener(\'click\', () => {\n  resetOverview();\n});\n\nconst motionBtn = document.getElementById(\'motionToggle\');\nfunction refreshMotionBtn() {\n  document.body.classList.toggle(\'motion-reduced\', reducedMotion);\n  motionBtn.classList.toggle(\'active\', reducedMotion);\n  motionBtn.setAttribute(\'aria-pressed\', reducedMotion ? \'true\' : \'false\');\n  motionBtn.textContent = reducedMotion ? \'稳火开\' : \'稳火\';\n  motionBtn.title = reducedMotion ? \'稳火阅读已开启，持续动效已降低\' : \'降低持续动效\';\n}\nfunction setReducedMotion(value, announce = false) {\n  reducedMotion = !!value;\n  if (reducedMotion) {\n    forgePulseUntil = 0;\n  }\n  refreshMotionBtn();\n  if (announce) {\n    showContextBubble(reducedMotion ? \'稳火已开：火候和人物动效收住，适合慢读。\' : \'稳火已关：火候和人物动效恢复。\', 3200);\n  }\n}\nmotionBtn.addEventListener(\'click\', (e) => {\n  e.stopPropagation();\n  setReducedMotion(!reducedMotion, true);\n});\nreducedMotionQuery?.addEventListener?.(\'change\', event => setReducedMotion(event.matches));\nrefreshMotionBtn();\n\n// ============== 渲染循环 ==============\nconst clock = new THREE.Clock();\nfunction animate() {\n  requestAnimationFrame(animate);\n  const delta = clock.getDelta();\n  const t = clock.elapsedTime;\n  // 炉火轻微闪烁(基准强度随场景模式变化)\n  const motionFactor = reducedMotion ? 0 : 1;\n  fireLight.intensity += (Math.random() - 0.5) * 0.06 * motionFactor;\n  const fireMin = fireBaseIntensity * 0.55, fireMax = fireBaseIntensity * 1.25;\n  fireLight.intensity = Math.max(fireMin, Math.min(fireMax, fireLight.intensity));\n  // 火炉模式火苗跳得更欢\n  const flickerAmp = (SCENE_MODE === \'forge\' ? 0.22 : 0.12) * motionFactor;\n  furnaceCoreLight.intensity = fireBaseIntensity * 0.6 + Math.sin(t * 8.5) * flickerAmp + Math.random() * 0.08 * motionFactor;\n  const pulseLeft = Math.max(0, forgePulseUntil - performance.now());\n  const forgePulse = reducedMotion ? 0 : pulseLeft ? Math.sin((1 - pulseLeft / 1800) * Math.PI) : 0;\n  if (forgePulse) {\n    fireLight.intensity += forgePulse * 1.15;\n    furnaceCoreLight.intensity += forgePulse * 0.9;\n  }\n  if (activeTourType === \'forge\') {\n    furnaceCoreLight.intensity += reducedMotion ? 0.18 : 0.34;\n  }\n\n  // 炉膛火焰网格轻微形变 + 呼吸缩放，营造燃烧感\n  if (furnaceFireMesh) {\n    furnaceFireMesh.scale.x = 1 + Math.sin(t * 7.5) * 0.035 * motionFactor;\n    furnaceFireMesh.scale.y = 1 + Math.sin(t * 11.0) * 0.06 * motionFactor + forgePulse * 0.08;\n    furnaceFireMesh.scale.z = 1 + Math.cos(t * 6.3) * 0.03 * motionFactor;\n    furnaceFireMesh.position.y = 0;\n    // 性能：逐顶点形变只在火炉模式跑，且每 2 帧更新一次（减半 GPU 顶点上传）\n    fireVtxFrame = (fireVtxFrame + 1) & 1;\n    const posAttr = furnaceFireMesh.geometry?.attributes?.position;\n    if (!reducedMotion && SCENE_MODE === \'forge\' && posAttr && furnaceFireBasePositions && fireVtxFrame === 0) {\n      const arr = posAttr.array;\n      for (let i = 0; i < arr.length; i += 3) {\n        const baseX = furnaceFireBasePositions[i];\n        const baseY = furnaceFireBasePositions[i + 1];\n        const baseZ = furnaceFireBasePositions[i + 2];\n        const sway = Math.sin(t * 8 + baseY * 6 + baseX * 4) * 0.012;\n        const rise = Math.sin(t * 11 + baseX * 5 + baseZ * 4) * Math.max(0, baseY) * 0.01;\n        arr[i] = baseX + sway;\n        arr[i + 1] = baseY + rise;\n        arr[i + 2] = baseZ + Math.cos(t * 7 + baseY * 5) * 0.006;\n      }\n      posAttr.needsUpdate = true;\n    }\n    if (furnaceFireMesh.material && \'emissiveIntensity\' in furnaceFireMesh.material) {\n      furnaceFireMesh.material.emissiveIntensity = reducedMotion\n        ? 1.24\n        : 1.35 + Math.sin(t * 10.0) * 0.18 + Math.random() * 0.08;\n    }\n  }\n\n  // 骨骼待机保持脚底贴地；无动画模型才使用整体起伏。\n  Object.entries(npcs).forEach(([key, n], i) => {\n    if (n.motion) {\n      n.motion.update(delta * (reducedMotion ? 0.12 : 1), {\n        selected: activeKey === key && dialog.classList.contains(\'show\'),\n        hovered: !reducedMotion && hoverKey === `npc:${key}`,\n        camera,\n      });\n      n.root.position.y = n.baseY;\n    } else if (n.root) {\n      n.root.position.y = n.baseY + Math.sin(t * 1.4 + i * 1.7) * 0.012 * motionFactor;\n    }\n    // 头顶氛围光跟随轻微脉动(火炉模式更明显)\n    const halo = npcHaloLights[key];\n    if (halo) {\n      const pulseAmp = (SCENE_MODE === \'forge\' ? 0.18 : 0.06) * motionFactor;\n      const base = SCENE_PRESETS[SCENE_MODE].haloIntensity;\n      const focused = TOUR_STOPS[activeTourType]?.npc === key;\n      const focusBoost = focused ? (SCENE_MODE === \'forge\' ? 1.2 : 0.72) : 0;\n      halo.light.intensity = base + focusBoost + Math.sin(t * 2.2 + i * 2.1) * pulseAmp;\n    }\n  });\n  const tonePulse = Math.sin(t * 2.4) * 0.08 * motionFactor;\n  stationToneLight.intensity = (SCENE_MODE === \'forge\' ? 0.78 : 0.48) + tonePulse;\n  updateNPCBubblePosition();\n  updateStationPinPosition();\n  updateStationHotspots();\n  updateStationFocusHalo();\n  updateTourPath();\n  controls.update();\n  renderer.render(scene, camera);\n}\nanimate();\n\n/* ============================================================\n   背景音乐 · 专业双曲目\n   - calm   : Hearth And Hammer\n   - tavern : Hearthside Ales\n   音频文件已烘焙 5 秒尾部渐出；切换场景时再做 0.8 秒交叉淡化。\n   ============================================================ */\nconst BGM = (() => {\n  const TRACKS = {\n    calm: {\n      title: \'Hearth And Hammer\',\n      url: \'./assets/music/hearth-and-hammer.mp3\',\n      volume: 0.46,\n    },\n    tavern: {\n      title: \'Hearthside Ales\',\n      url: \'./assets/music/hearthside-ales.mp3\',\n      volume: 0.42,\n    },\n  };\n  const players = Object.fromEntries(\n    Object.entries(TRACKS).map(([key, track]) => {\n      const audio = new Audio(track.url);\n      audio.preload = \'auto\';\n      audio.loop = true;\n      audio.volume = 0;\n      audio.load();\n      return [key, audio];\n    }),\n  );\n  let style = \'calm\';\n  let playing = false;\n  let audible = false;\n\n  function startCurrent() {\n    const audio = players[style];\n    audio.volume = TRACKS[style].volume;\n    const playPromise = audio.play();\n    playPromise\n      ?.then(() => {\n        audible = true;\n        refreshBgmBtn?.();\n      })\n      .catch(() => {\n        audible = false;\n        refreshBgmBtn?.();\n      });\n  }\n\n  function play() {\n    playing = true;\n    startCurrent();\n  }\n\n  function pause() {\n    playing = false;\n    audible = false;\n    Object.values(players).forEach(audio => {\n      audio.pause();\n      audio.volume = 0;\n    });\n  }\n\n  function setStyle(name) {\n    if (!TRACKS[name] || name === style) return;\n    const previous = players[style];\n    style = name;\n    const next = players[style];\n    if (!playing) return;\n\n    audible = false;\n    previous.pause();\n    previous.volume = 0;\n    next.currentTime = 0;\n    startCurrent();\n  }\n\n  const api = {\n    toggle() {\n      playing ? pause() : play();\n      return playing;\n    },\n    play,\n    pause,\n    setStyle,\n    get playing() { return playing; },\n    get audible() { return audible && playing && !players[style].paused; },\n    get style() { return style; },\n    get title() { return TRACKS[style].title; },\n  };\n\n  window.__BGM_DEBUG__ = {\n    tracks: Object.fromEntries(\n      Object.entries(TRACKS).map(([key, track]) => [key, track.url]),\n    ),\n    state: () => ({\n      style,\n      playing,\n      audible: api.audible,\n      title: TRACKS[style].title,\n      paused: players[style].paused,\n      volume: players[style].volume,\n      readyState: players[style].readyState,\n      networkState: players[style].networkState,\n      error: players[style].error?.message || null,\n    }),\n  };\n  return api;\n})();\n\nconst StationSound = (() => {\n  let ctx = null;\n  let masterGain = null;\n\n  function getContext() {\n    const AudioContextClass = window.AudioContext || window.webkitAudioContext;\n    if (!AudioContextClass) return null;\n    if (!ctx) {\n      ctx = new AudioContextClass();\n      masterGain = ctx.createGain();\n      masterGain.gain.value = 0.22;\n      masterGain.connect(ctx.destination);\n    }\n    return ctx;\n  }\n\n  function canPlay() {\n    return aud