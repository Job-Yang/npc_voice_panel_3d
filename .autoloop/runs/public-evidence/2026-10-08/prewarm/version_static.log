onSoundType && audioUnlocked && !bgmUserMuted);\n  soundStatus.setAttribute(\'aria-label\', `炉声火候：${soundStatusLine.textContent}`);\n}\nfunction refreshBgmBtn() {\n  const waitingForUnlock = BGM.playing && !BGM.audible;\n  bgmBtn.title = BGM.playing\n    ? `${waitingForUnlock ? \'背景音乐待点亮\' : \'背景音乐\'} · ${BGM.title}${waitingForUnlock ? \'，点击点亮炉声\' : \'，点击静音\'}`\n    : `背景音乐已静音，点击恢复 ${BGM.title}`;\n  bgmBtn.setAttribute(\'aria-pressed\', BGM.playing ? \'true\' : \'false\');\n  if (BGM.playing) {\n    bgmBtn.textContent = waitingForUnlock ? \'🔈 待点\' : \'🔊 音乐\';\n    bgmBtn.classList.add(\'playing\');\n  } else {\n    bgmBtn.textContent = \'🔇 音乐\';\n    bgmBtn.classList.remove(\'playing\');\n  }\n  refreshSoundStatus();\n}\nbgmBtn.addEventListener(\'click\', (e) => {\n  e.stopPropagation();\n  const waitingForUnlock = BGM.playing && !BGM.audible;\n  audioUnlocked = true;\n  if (waitingForUnlock) {\n    BGM.play();\n  } else {\n    BGM.toggle();\n  }\n  bgmUserMuted = !BGM.playing;   // 用户手动操作后记录意图,不再被自动逻辑覆盖\n  refreshBgmBtn();\n  showContextBubble(BGM.playing ? getSoundStatusText() : \'炉声已收住：可以安静看铺。\', 3000);\n});\n\n// ============== BGM 默认开启(在浏览器自动播放策略允许范围内尽力而为)==============\n// 浏览器通常要求 click/pointerdown/keydown/touchstart 后才允许音频真正出声。\nlet bgmUserMuted = false;        // 用户是否主动静音过\nfunction startBgmDefault() {\n  if (bgmUserMuted) return;\n  BGM.play();\n  refreshBgmBtn();\n}\nfunction unlockBgm() {\n  detachUnlock();\n  audioUnlocked = true;\n  if (bgmUserMuted) return;\n  BGM.play();\n  refreshBgmBtn();\n}\nconst UNLOCK_EVENTS = [\'pointerdown\',\'click\',\'keydown\',\'touchstart\'];\nfunction detachUnlock() {\n  UNLOCK_EVENTS.forEach(ev => document.removeEventListener(ev, unlockBgm, true));\n}\n// 用 capture 阶段挂在 document 上:无论点页面任何角落(画布/按钮/空白处)都先解锁\nUNLOCK_EVENTS.forEach(ev => document.addEventListener(ev, unlockBgm, true));\n\n// ============== 场景模式切换按钮 ==============\nconst modeBtn = document.getElementById(\'modeToggle\');\nfunction refreshModeBtn() {\n  const 