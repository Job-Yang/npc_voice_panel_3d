================================= */\nconst BGM = (() => {\n  const TRACKS = {\n    calm: {\n      title: \'Hearth And Hammer\',\n      url: \'./assets/music/hearth-and-hammer.mp3\',\n      volume: 0.46,\n    },\n    tavern: {\n      title: \'Hearthside Ales\',\n      url: \'./assets/music/hearthside-ales.mp3\',\n      volume: 0.42,\n    },\n  };\n  const players = Object.fromEntries(\n    Object.entries(TRACKS).map(([key, track]) => {\n      const audio = new Audio(track.url);\n      audio.preload = \'auto\';\n      audio.loop = true;\n      audio.volume = 0;\n      audio.load();\n      return [key, audio];\n    }),\n  );\n  let style = \'calm\';\n  let playing = false;\n\n  function startCurrent() {\n    const audio = players[style];\n    audio.volume = TRACKS[style].volume;\n    const playPromise = audio.play();\n    playPromise?.catch(() => {});\n  }\n\n  function play() {\n    playing = true;\n    startCurrent();\n  }\n\n  function pause() {\n    playing = false;\n    Object.values(players).forEach(audio => {\n      audio.pause();\n      audio.volume = 0;\n    });\n  }\n\n  function setStyle(name) {\n    if (!TRACKS[name] || name === style) return;\n    const previous = players[style];\n    style = name;\n    const next = players[style];\n    if (!playing) return;\n\n    previous.pause();\n    previous.volume = 0;\n    next.currentTime = 0;\n    startCurrent();\n  }\n\n  const api = {\n    toggle() {\n      playing ? pause() : play();\n      return playing;\n    },\n    play,\n    pause,\n    setStyle,\n    get playing() { return playing; },\n    get style() { return style; },\n    get title() { return TRACKS[style].title; },\n  };\n\n  window.__BGM_DEBUG__ = {\n    tracks: Object.fromEntries(\n      Object.entries(TRACKS).map(([key, track]) => [key, track.url]),\n    ),\n    state: () => ({\n      style,\n      playing,\n      title: TRACKS[style].title,\n      paused: players[style].paused,\n      volume: players[style].volume,\n      readyState: players[style].readyState,\n      networkState: players[style].networkState,\n      error: players[style].error?.message || null,\n    }),\n  };\n  return api;\n})();\n\n/* ============================================================\n   场景模式管理器 · 像家里灯光场景一样整体切换\n   (预设 SCENE_PRESETS / SCENE_MODE / fireBaseIntensity 已在前面定义)\n   ============================================================ */\nfunction applySceneMode(mode, { animateLight = true } = {}) {\n  const p = SCENE_PRESETS[mode];\n  if (!p) return;\n  SCENE_MODE = mode;\n  fireBaseIntensity = p.fireBase;\n\n  // 平滑过渡灯光(简单 lerp 动画)\n  const from = {\n    ambient: ambient.intensity,\n    key: keyLight.intensity,\n    fire: fireLight.intensity,\n    furnace: furnaceCoreLight.intensity,\n    bench: benchFillLight.intensity,\n    halo: (Object.values(npcHaloLights)[0]?.light.intensity) ?? 0,\n    haloGlow: (Object.values(npcHaloLights)[0]?.glow.material.opacity) ?? 0,\n    bgR: scene.background.r, bgG: scene.background.g, bgB: scene.background.b,\n  };\n  const target = {\n    ambient: p.ambient, key: p.keyLight,\n    fire: p.fireBase, furnace: p.fireBase * p.furnaceFactor,\n    bench: Math.max(0.25, p.fireBase * 0.28),\n    halo: p.haloIntensity, haloGlow: p.haloGlow,\n    bg: new THREE.Color(p.bg),\n  };\n  const start = performance.now();\n  const dur = animateLight ? 900 : 0;\n  function lerpStep(now) {\n    const t = dur === 0 ? 1 : Math.min(1, (now - start) / dur);\n    const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;\n    ambient.intensity = from.ambient + (target.ambient - from.ambient) * e;\n    keyLight.intensity = from.key + (target.key - from.key) * e;\n    furnaceCoreLight.intensity = from.furnace + (target.furnace - from.furnace) * e;\n    benchFillLight.intensity = from.bench + (target.bench - from.bench) * e;\n    Object.values(npcHaloLights).forEach(h => {\n      h.light.intensity = from.halo + (target.halo - from.halo) * e;\n      h.glow.material.opacity = from.haloGlow + (target.haloGlow - from.haloGlow) * e;\n    });\n    scene.background.setRGB(\n      from.bgR + (target.bg.r - from.bgR) * e,\n      from.bgG + (target.bg.g - from.bgG) * e,\n      from.bgB + (target.bg.b - from.bgB) * e\n    );\n    if (scene.fog) scene.fog.color.copy(scene.background);\n    if (t < 1) requestAnimationFrame(lerpStep);\n  }\n  requestAnimationFrame(lerpStep);\n\n  // BGM 曲目\n  BGM.setStyle(p.bgmStyle);\n  refreshBgmBtn();\n\n  // 火炉模式立刻让大家热闹起来:强制触发一次说话\n  if (mode === \'forge\') {\n    setTimeout(() => triggerRandomAmbientTalk(true), 300);\n  } else {\n    // 切回舒缓:停掉正在播的语音,回归安静冒泡\n    stopCurrentAudio();\n  }\n\n  // 同步火光滑杆显示(若存在)\n  const fireSlider = document.getElementById(\'fireIntensity\');\n  if (fireSlider) fireSlider.value = p.fireBase;\n\n  refreshModeBtn();\n}\n\nconst bgmBtn = document.getElementById(\'bgmToggle\');\nfunction refreshBgmBtn() {\n  bgmBtn.title = `背景音乐 · ${BGM.title}`;\n  if (BGM.playing) {\n    bgmBtn.textContent = \'🔊 音乐\';\n    bgmBtn.classList.add(\'playing\');\n  } else {\n    bgmBtn.textContent = \'🔇 音乐\';\n    bgmBtn.classList.remove(\'playing\');\n  }\n}\nbgmBtn.addEventListener(\'click\', (e) => {\n  e.stopPropagation();\n  BGM.toggle();\n  bgmUserMuted = !BGM.playing;   // 用户手动操作后记录意图,不再被自动逻辑覆盖\n  refreshBgmBtn();\n});\n\n// ============== BGM 默认开启(在浏览器自动播放策略允许范围内尽力而为)==============\n// 浏览器通常要求 click/pointerdown/keydown/touchstart 后才允许音频真正出声。\nlet bgmUserMuted = false;        // 用户是否主动静音过\nfunction startBgmDefault() {\n  if (bgmUserMuted) return;\n  BGM.play();\n  refreshBgmBtn();\n}\nfunction unlockBgm() {\n  detachUnlock();\n  if (bgmUserMuted) return;\n  BGM.play();\n  refreshBgmBtn();\n}\nconst UNLOCK_EVENTS = [\'pointerdown\',\'click\',\'keydown\',\'touchstart\'];\nfunction detachUnlock() {\n  UNLOCK_EVENTS.forEach(ev => document.removeEventListener(ev, unlockBgm, true));\n}\n// 用 capture 阶段挂在 document 上:无论点页面任何角落(画布/按钮/空白处)都先解锁\nUNLOCK_EVENTS.forEach(ev => document.addEventListener(ev, unlockBgm, true));\n\n// ============== 场景模式