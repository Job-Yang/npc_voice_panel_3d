{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"sed -n '1080,1305p' index.html","aggregated_output":"  metaEl.textContent = meta;\n  metaEl.classList.toggle('show', !!meta);\n  document.getElementById('dlgLine').textContent = line;\n\n  dialogActions = actions;\n  [document.getElementById('btnPrimary'), document.getElementById('btnSecondary')].forEach((btn, i) => {\n    const action = actions[i];\n    btn.textContent = action?.label || '';\n    btn.style.display = action ? '' : 'none';\n  });\n  document.getElementById('btnPlay').style.display = allowVoice ? '' : 'none';\n  dialog.classList.add('show');\n}\n\nfunction showContextBubble(line, duration = 3800) {\n  if (activeKey && npcs[activeKey]) {\n    showNPCBubble(activeKey, line, duration);\n  } else if (selectedObjectKey && interactiveObjects[selectedObjectKey]) {\n    showObjectBubble(selectedObjectKey, line, duration);\n  } else if (npcs.yq) {\n    showNPCBubble('yq', line, duration);\n  }\n}\n\nfunction openGuideCard(type) {\n  if (type === 'forge') {\n    forgeWelcome();\n    return;\n  }\n  if (type === 'yq_easter') {\n    triggerYQEasterEgg();\n    return;\n  }\n  if (type === 'iloop_easter') {\n    triggerILoopEasterEgg();\n    return;\n  }\n\n  const source = GUIDE_CARDS[type] || GUIDE_CARDS.profile;\n  const card = { ...source };\n  if (type === 'wander') {\n    card.line = pickRandom([\n      GUIDE_CARDS.wander.line,\n      ...yqLines.slice(0, 8),\n      '这里是主页，不是简历；简历负责证明过去，铁匠铺负责展示手感。',\n    ]);\n  }\n  renderDialog({ ...card, allowVoice: false });\n  showContextBubble(card.line);\n}\n\nfunction runDialogAction(index) {\n  const action = dialogActions[index];\n  if (!action) return;\n  if (action.url) {\n    window.open(action.url, '_blank', 'noopener');\n    return;\n  }\n  openGuideCard(action.type);\n}\n\nfunction forgeWelcome() {\n  const line = pickRandom(WELCOME_LINES);\n  selectedObjectKey = 'forge';\n  activeKey = null;\n  setActiveNpcButton(null);\n  applySceneMode('forge');\n  forgePulseUntil = performance.now() + 1400;\n  renderDialog({\n    name: '火炉 · 新欢迎语',\n    meta: '锻造完成',\n    line,\n    actions: [\n      { label: '再锻一句', type: 'forge' },\n      { label: '看 iLoop', type: 'iloop' },\n    ],\n    allowVoice: false,\n  });\n  showObjectBubble('forge', line, 4600);\n}\n\nfunction triggerYQEasterEgg() {\n  const line = pickRandom(YQ_EASTER_LINES);\n  yqClickCount = 0;\n  activeKey = 'yq';\n  selectedObjectKey = null;\n  setActiveNpcButton('yq');\n  applySceneMode('forge');\n  forgePulseUntil = performance.now() + 1600;\n  renderDialog({\n    name: 'YQ 发疯模式',\n    meta: '连点彩蛋',\n    line,\n    actions: [\n      { label: '看 iLoop', type: 'iloop' },\n      { label: '再发疯', type: 'yq_easter' },\n    ],\n    allowVoice: false,\n  });\n  showNPCBubble('yq', line, 5200);\n  bounceNPC('yq');\n  talkMotionNPC('yq', 2600);\n}\n\nfunction triggerILoopEasterEgg() {\n  const line = '闭环启动：📋 计划 → 🔍 取证 → 🔧 改动 → 🛠 构建 → ✅ 验证 → 📝 收口。';\n  activeKey = 'yq';\n  selectedObjectKey = null;\n  setActiveNpcButton('yq');\n  forgePulseUntil = performance.now() + 1800;\n  renderDialog({\n    name: 'iLoop 闭环启动',\n    meta: '隐藏指令 iLoop',\n    line,\n    actions: [\n      { label: '看 iLoop', type: 'iloop' },\n      { label: '锻造欢迎语', type: 'forge' },\n    ],\n    allowVoice: false,\n  });\n  showNPCBubble('yq', line, 5200);\n  talkMotionNPC('yq', 3000);\n}\n\nfunction triggerRandomAmbientTalk(force = false) {\n  if (dialog.classList.contains('show') && !force) return;\n\n  const now = performance.now();\n  if (!force && now - lastAutoTalkAt < 5000) return;\n  lastAutoTalkAt = now;\n\n  const allKeys = ['master', 'apprentice', 'yq'];\n  const key = pickRandom(allKeys);\n  const line = (key === 'yq') ? pickRandom(yqLines) : NPC_CONFIG[key].line;\n\n  setActiveNpcButton(key);\n  activeKey = key;\n  selectedObjectKey = null;\n  bounceNPC(key);\n  talkMotionNPC(key, 2200);\n  showNPCBubble(key, line, 3600);\n\n  // 是否出声由当前场景模式决定:舒缓只冒泡,火炉才开口\n  const wantVoice = SCENE_PRESETS[SCENE_MODE]?.npcVoice;\n  if (wantVoice && !(currentAudio && !currentAudio.paused)) {\n    window.onNPCSelected(key, { auto: true });\n  }\n\n  setTimeout(() => {\n    if (activeKey === key) activeKey = null;\n    setActiveNpcButton(null);\n  }, 3600);\n}\n\nfunction scheduleAutoTalk() {\n  clearTimeout(autoTalkTimer);\n  autoTalkTimer = setTimeout(() => {\n    triggerRandomAmbientTalk();\n    scheduleAutoTalk();\n  }, getRandomTalkDelay());\n}\n\nfunction kickOffAutoTalk() {\n  setTimeout(() => {\n    triggerRandomAmbientTalk(true);\n    scheduleAutoTalk();\n  }, 1200);\n}\n\nfunction selectNPC(key) {\n  activeKey = key;\n  selectedObjectKey = null;\n  setActiveNpcButton(key);\n\n  if (key === 'yq') {\n    yqClickCount++;\n    if (yqClickCount >= 5) {\n      triggerYQEasterEgg();\n      return;\n    }\n  } else {\n    yqClickCount = 0;\n  }\n\n  const cfg = NPC_CONFIG[key];\n  renderDialog({\n    name: cfg.name,\n    meta: cfg.meta,\n    line: cfg.line,\n    actions: cfg.actions,\n    allowVoice: !!voiceFiles[key],\n  });\n  showNPCBubble(key, cfg.line, 4200);\n  bounceNPC(key);\n  talkMotionNPC(key, 1800);\n  focusOn(npcs[key].root);\n  onNPCSelected(key);\n}\n\nfunction selectObject(key) {\n  const entry = interactiveObjects[key];\n  const cfg = OBJECT_CONFIG[key];\n  if (!entry || !cfg) return;\n\n  activeKey = null;\n  selectedObjectKey = key;\n  yqClickCount = 0;\n  setActiveNpcButton(null);\n  stopCurrentAudio();\n\n  if (key === 'forge') {\n    forgeWelcome();\n    return;\n  }\n\n  renderDialog({\n    name: cfg.name,\n    meta: cfg.meta,\n    line: cfg.line,\n    actions: cfg.actions,\n    allowVoice: false,\n  });\n  showObjectBubble(key, cfg.line, 4200);\n  focusOn(entry.root);\n}\n\n","exit_code":0,"status":"completed"}}
