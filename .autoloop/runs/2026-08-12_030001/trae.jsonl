{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"sed -n '620,920p' index.html","aggregated_output":"};\nlet SCENE_MODE = 'calm';\nlet fireBaseIntensity = SCENE_PRESETS.calm.fireBase;   // 给火光闪烁动画当基准\n\n// ============== 地面（在背景 GLB 没加载前的兜底）==============\nconst ground = new THREE.Mesh(\n  new THREE.CircleGeometry(8, 64),\n  new THREE.MeshStandardMaterial({ color: 0x2a1a10, roughness: 0.9, metalness: 0.05 })\n);\nground.rotation.x = -Math.PI / 2;\nground.receiveShadow = true;\nscene.add(ground);\n\n// ============== 加载器 ==============\n// Draco 几何解压（压缩脚本 compress.sh 会用到 draco）\nconst dracoLoader = new DRACOLoader();\ndracoLoader.setDecoderPath('https://www.gstatic.com/draco/v1/decoders/');\n// KTX2 贴图解压（如果之后启用 ktx2 压缩，提前接好）\nconst ktx2Loader = new KTX2Loader();\nktx2Loader.setTranscoderPath('https://unpkg.com/three@0.160.0/examples/jsm/libs/basis/');\nktx2Loader.detectSupport(renderer);\n\nconst loader = new GLTFLoader();\nloader.setDRACOLoader(dracoLoader);\nloader.setKTX2Loader(ktx2Loader);\nloader.setMeshoptDecoder(MeshoptDecoder);\n\nconst npcs = {}; // { key: { root, originalEmissive, config } }\nconst interactiveObjects = {}; // { key: { root, config } }\nlet loadCount = 0;\nconst TOTAL = Object.keys(NPC_CONFIG).length + 1; // +1 for bg\ncreateHotspot('forge', [0, FLOOR_Y + 0.7, 1.05], [1.8, 1.5, 1.3]);\nconst loopBoard = makeProp('loopboard', [1.35, 0, 2.65]);\nloopBoard.position.y += FLOOR_Y;\nregisterInteractive(loopBoard, 'loopboard');\nscene.add(loopBoard);\n\nfunction tickLoad() {\n  loadCount++;\n  if (loadCount >= TOTAL) {\n    document.getElementById('loader').classList.add('hide');\n    // 全部模型就位后渲一次阴影并冻结（静态场景无需逐帧更新阴影贴图）\n    renderer.shadowMap.needsUpdate = true;\n  }\n}\n\n// 加载背景\nloader.load(BG_URL, gltf => {\n  const bg = gltf.scene;\n  bgRoot = bg;\n  bg.traverse(o => { if (o.isMesh) { o.receiveShadow = true; o.castShadow = true; }});\n  const box = new THREE.Box3().setFromObject(bg);\n  const size = box.getSize(new THREE.Vector3());\n  bgFitBase = { x: size.x, z: size.z, minY: box.min.y };\n  const scale = DEFAULT_BG_SCALE / Math.max(size.x, size.z);\n  bg.scale.setScalar(scale);\n  bg.position.y = -box.min.y * scale;\n  scene.add(bg);\n  hideCoalPiles();\n  ground.visible = false;\n  tickLoad();\n}, undefined, () => {\n  console.warn('背景 GLB 未找到，使用兜底地面');\n  tickLoad();\n});\n\nfunction setCameraDistance(distance) {\n  camera.position.copy(getCameraPosition(distance, controls.target.clone()));\n  controls.update();\n}\n\nfunction resetOverview() {\n  animateCamera(getCameraPosition(DEFAULT_CAMERA_DISTANCE, DEFAULT_CAMERA_TARGET), DEFAULT_CAMERA_TARGET.clone(), 600);\n}\n\nfunction hideCoalPiles() {\n  if (!bgRoot) return;\n  bgRoot.traverse(o => {\n    if (!o.isMesh) return;\n    const name = (o.name || '').toLowerCase();\n    const matName = (o.material?.name || '').toLowerCase();\n    if (/coal|char|rock|stone|ember|pile/.test(name) || /coal|char|rock|stone|ember|pile/.test(matName)) {\n      o.visible = false;\n    }\n    if (!furnaceFireMesh && /fire|flame|ember|burn|lava/.test(name + ' ' + matName)) {\n      furnaceFireMesh = o;\n      if (o.geometry?.attributes?.position) {\n        furnaceFireBasePositions = o.geometry.attributes.position.array.slice();\n      }\n      if (o.material) {\n        o.material = o.material.clone();\n        if ('emissiveIntensity' in o.material) o.material.emissiveIntensity = 1.6;\n      }\n    }\n  });\n}\n\n// ============== T-pose 修正 ==============\n// 通过 bone 名字匹配两侧的\"上臂\",把手臂从水平 T 字旋转到自然下垂\nfunction fixTPose(root) {\n  const armKeywords = /(shoulder|upperarm|arm_l|arm_r|l_arm|r_arm|leftarm|rightarm|clavicle|hombro|arm$|shoulder_l|shoulder_r)/i;\n  let found = 0;\n  root.traverse(o => {\n    if (o.isBone && armKeywords.test(o.name)) {\n      // 大致把手臂沿 Z 轴向下转 70 度\n      const sign = /\\b(l|left|izq)/i.test(o.name) ? -1 : 1;\n      o.rotation.z += sign * Math.PI * 0.42;\n      found++;\n    }\n  });\n  return found > 0;\n}\n\n// ============== 道具：用基础几何体盖住手部 ==============\nfunction makeProp(type, npcPos) {\n  const g = new THREE.Group();\n  if (type === 'anvil') {\n    // 铁砧：黑铁色梯形 + 木墩\n    const base = new THREE.Mesh(\n      new THREE.CylinderGeometry(0.32, 0.4, 0.7, 12),\n      new THREE.MeshStandardMaterial({ color: 0x3a2818, roughness: 0.95 })\n    );\n    base.position.y = 0.35;\n    const anvil = new THREE.Mesh(\n      new THREE.BoxGeometry(0.9, 0.25, 0.35),\n      new THREE.MeshStandardMaterial({ color: 0x1a1a1e, roughness: 0.5, metalness: 0.7 })\n    );\n    anvil.position.y = 0.82;\n    g.add(base, anvil);\n    // 放在 NPC 前方挡住手\n    g.position.set(npcPos[0] + 0.6, 0, npcPos[2] + 0.5);\n    g.rotation.y = -Math.PI / 6;\n  } else if (type === 'bucket') {\n    // 水桶 + 抹布\n    const bucket = new THREE.Mesh(\n      new THREE.CylinderGeometry(0.22, 0.18, 0.4, 16),\n      new THREE.MeshStandardMaterial({ color: 0x5a3a1e, roughness: 0.9 })\n    );\n    bucket.position.y = 0.2;\n    const rag = new THREE.Mesh(\n      new THREE.SphereGeometry(0.12, 8, 6),\n      new THREE.MeshStandardMaterial({ color: 0x885533, roughness: 1.0 })\n    );\n    rag.position.set(0.1, 0.42, 0);\n    rag.scale.set(1.2, 0.4, 1.2);\n    g.add(bucket, rag);\n    g.position.set(npcPos[0] - 0.5, 0, npcPos[2] + 0.4);\n  } else if (type === 'desk') {\n    // 工作台 + 笔记本电脑\n    const desk = new THREE.Mesh(\n      new THREE.BoxGeometry(1.4, 0.08, 0.7),\n      new THREE.MeshStandardMaterial({ color: 0x4a2e1a, roughness: 0.85 })\n    );\n    desk.position.y = 0.9;\n    const leg = new THREE.MeshStandardMaterial({ color: 0x2e1a0e, roughness: 0.9 });\n    [[-0.6,-0.3],[0.6,-0.3],[-0.6,0.3],[0.6,0.3]].forEach(([x,z])=>{\n      const l = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.9,0.08), leg);\n      l.position.set(x, 0.45, z);\n      g.add(l);\n    });\n    const laptopBase = new THREE.Mesh(\n      new THREE.BoxGeometry(0.5, 0.03, 0.35),\n      new THREE.MeshStandardMaterial({ color: 0x1a1a1e, roughness: 0.4, metalness: 0.6 })\n    );\n    laptopBase.position.set(0, 0.96, 0);\n    const laptopScreen = new THREE.Mesh(\n      new THREE.BoxGeometry(0.5, 0.32, 0.02),\n      new THREE.MeshStandardMaterial({ color: 0x222226, emissive: 0x4488ff, emissiveIntensity: 0.4, roughness: 0.3 })\n    );\n    laptopScreen.position.set(0, 1.13, -0.16);\n    laptopScreen.rotation.x = -0.15;\n    g.add(desk, laptopBase, laptopScreen);\n    g.position.set(npcPos[0], 0, npcPos[2] + 0.5);\n    g.rotation.y = Math.PI; // 桌子面朝相机\n  } else if (type === 'loopboard') {\n    // 闭环卷轴：把 iLoop 的“计划-取证-验证”做成可点击的场景线索\n    const boardMat = new THREE.MeshStandardMaterial({ color: 0x6b4727, roughness: 0.82 });\n    const paperMat = new THREE.MeshStandardMaterial({ color: 0xc59b62, roughness: 0.9 });\n    const emberMat = new THREE.MeshStandardMaterial({ color: 0xffb05a, emissive: 0xff7a22, emissiveIntensity: 0.45, roughness: 0.55 });\n    const ironMat = new THREE.MeshStandardMaterial({ color: 0x20242a, metalness: 0.45, roughness: 0.5 });\n\n    const stand = new THREE.Mesh(new THREE.BoxGeometry(0.76, 0.08, 0.08), boardMat);\n    stand.position.y = 0.52;\n    const post = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.78, 0.08), boardMat);\n    post.position.y = 0.91;\n    const board = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.58, 0.06), paperMat);\n    board.position.y = 1.25;\n    board.position.z = -0.02;\n    g.add(stand, post, board);\n\n    [[-0.28, 1.33], [0, 1.18], [0.28, 1.33]].forEach(([x, y], i) => {\n      const node = new THREE.Mesh(new THREE.CylinderGeometry(0.065, 0.065, 0.028, 18), emberMat);\n      node.rotation.x = Math.PI / 2;\n      node.position.set(x, y, 0.035);\n      g.add(node);\n      if (i > 0) {\n        const link = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.025, 0.025), ironMat);\n        link.position.set(x - 0.14, y + (i === 1 ? 0.075 : -0.075), 0.03);\n        link.rotation.z = i === 1 ? -0.44 : 0.44;\n        g.add(link);\n      }\n    });\n\n    const pin = new THREE.Mesh(new THREE.SphereGeometry(0.045, 12, 8), emberMat);\n    pin.position.set(0, 1.52, 0.04);\n    g.add(pin);\n    g.position.set(npcPos[0], 0, npcPos[2]);\n    g.rotation.y = -0.28;\n  }\n  g.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; }});\n  return g;\n}\n\nfunction registerInteractive(root, key, config = OBJECT_CONFIG[key]) {\n  if (!root || !config) return root;\n  root.userData.interactiveKey = key;\n  root.traverse?.(o => {\n    if (o.isMesh || o.isGroup) o.userData.interactiveKey = key;\n  });\n  interactiveObjects[key] = { root, config };\n  return root;\n}\n\nfunction createHotspot(key, position, size) {\n  const hit = new THREE.Mesh(\n    new THREE.BoxGeometry(size[0], size[1], size[2]),\n    new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.0, depthWrite: false })\n  );\n  hit.position.set(position[0], position[1], position[2]);\n  hit.visible = true;\n  scene.add(hit);\n  return registerInteractive(hit, key);\n}\n\n// 加载 NPC\nfunction loadNPC(key, cfg) {\n  loader.load(cfg.url, gltf => {\n    const root = gltf.scene;\n    // 1. 归一化高度到 1.8m\n    let box = new THREE.Box3().setFromObject(root);\n    const size = box.getSize(new THREE.Vector3());\n    const scale = (1.8 / size.y) * cfg.scale;\n    root.scale.setScalar(scale);\n\n    // 2. 尝试修正 T-pose（如果模型有骨骼）\n    const rigged = fixTPose(root);\n    if (!rigged) {\n      // 没骨骼的兜底：整体微微前倾 3 度\n      root.rotation.x = 0.05;\n    }\n\n    // 3. 朝向\n    if (cfg.rotY !== undefined) root.rotation.y = cfg.rotY;\n\n    // 4. 重新计算 box 并把脚底贴地（FLOOR_Y 是背景地板的高度）\n    box = new THREE.Box3().setFromObject(root);\n    root.position.set(cfg.position[0], FLOOR_Y - box.min.y, cfg.position[2]);\n    root.userData.npcKey = key;\n    root.traverse(o => {\n      if (o.isMesh) {\n        o.castShadow = true;\n        o.receiveShadow = true;\n        o.userData.npcKey = key;\n      }\n    });\n    scene.add(root);\n\n    // 5. 加道具遮挡手部（只有 cfg.prop 非 null 时）\n    if (cfg.prop) {\n      const prop = makeProp(cfg.prop, cfg.position);\n      prop.position.y += FLOOR_Y; // 道具也抬到地板上\n      registerInteractive(prop, cfg.prop);\n      scene.add(prop);\n    }\n\n    npcs[key] = { root, config: cfg, baseY: root.position.y };\n    tickLoad();\n  }, undefined, () => {\n    console.warn(`${cfg.name} GLB 未找到,使用占位胶囊`);\n    const mesh = new THREE.Mesh(\n      new THREE.CapsuleGeometry(0.35, 1.0, 8, 16),\n      new THREE.MeshStandardMaterial({ color: cfg.color, roughness: 0.6 })\n    );\n    mesh.position.set(cfg.position[0], FLOOR_Y + 0.9, cfg.position[2]);\n    mesh.castShadow = true;\n    mesh.userData.npcKey = key;\n    scene.add(mesh);\n    if (cfg.prop) {\n      const prop = makeProp(cfg.prop, cfg.position);\n      prop.position.y += FLOOR_Y;\n      registerInteractive(prop, cfg.prop);\n      scene.add(prop);\n    }\n    npcs[key] = { root: mesh, config: cfg, baseY: mesh.position.y };\n    tickLoad();\n  });\n}\nObject.entries(NPC_CONFIG).forEach(([k, v]) => loadNPC(k, v));\n\n// ============== 交互：射线检测 hover/click ==============\nconst raycaster = new THREE.Raycaster();\n","exit_code":0,"status":"completed"}}
