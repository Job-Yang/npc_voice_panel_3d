这个铁匠铺放的不是正式简历，是我更真实的工作方式：把混乱问题锻造成能跑的工具。',\n    actions: [\n      { label: '看最近项目', type: 'projects' },\n      { label: '看 iLoop', type: 'iloop' },\n    ],\n  },\n  projects: {\n    name: '最近在锻造',\n    meta: '项目集',\n    line: '主线是 iLoop：让 iOS Agent 从“会写代码”变成“能在本机工程持续交付”。旁边还放着包体积治理、无用代码收窄、LinkMap 分析和自动化验证这些铁块。',\n    actions: [\n      { label: '锻造欢迎语', type: 'forge' },\n      { label: '找我协作', type: 'contact' },\n    ],\n  },\n  iloop: {\n    name: 'iLoop',\n    meta: 'i + 反馈闭环 Loop',\n    line: 'iLoop 的核心很简单：先定目标，再用编译、日志、截图、UI 层级这些证据闭环推进。结论必须有证据，做完必须能验。',\n    actions: [\n      { label: '启动闭环彩蛋', type: 'iloop_easter' },\n      { label: '看最近项目', type: 'projects' },\n    ],\n  },\n  contact: {\n    name: '找老杨协作',\n    meta: '怎么开始',\n    line: '最省事的方式：直接带着目标、截图、链接或报错来。需求可以粗糙，证据最好具体；剩下的交给铁匠铺慢慢敲。',\n    actions: [\n      { label: '老杨是谁', type: 'profile' },\n      { label: '随便逛逛', type: 'wander' },\n    ],\n  },\n  wander: {\n    name: '随便逛逛',\n    meta: '随机吐槽',\n    line: '水桶里没有水，只有上次排查问题时留下的冷汗。点点 NPC、铁砧、火炉和桌子，会冒出不一样的入口。',\n    actions: [\n      { label: '再来一句', type: 'wander' },\n      { label: '锻造欢迎语', type: 'forge' },\n    ],\n  },\n};\n\nconst WELCOME_LINES = [\n  '欢迎来到老杨的铁匠铺，需求放这里，bug 也放这里，别放我脑子里。',\n  '这里不写长篇自我介绍，这里直接开炉。',\n  '如果一个问题值得反复解释，它就值得被做成工具。',\n  '进门先别急着夸 AI，先看它有没有把活跑通。',\n  '老杨也可以叫老羊，反正都是负责把硬东西一点点磨顺。',\n];\n\nconst YQ_EASTER_LINES = [\n  '你连点我五次，是想触发彩蛋，还是在复现线上事故？',\n  'YQ 已进入发疯模式：计划、取证、改动、构建、验证、收口，一个都别少。',\n  '别问我为什么知道你会连点，做工具的人都懂这种手痒。',\n];\n\nconst OBJECT_CONFIG = {\n  anvil: {\n    name: '铁砧 · 项目集',\n    meta: '点击物件',\n    line: '铁砧上敲过的东西：iLoop、自闭环流水线、包体积治理、无用代码收窄、LinkMap 分析。硬问题先上砧，别上嘴。',\n    actions: [\n      { label: '看最近项目', type: 'projects' },\n      { label: '锻造欢迎语', type: 'forge' },\n    ],\n  },\n  bucket: {\n    name: '水桶 · 随便逛逛',\n    meta: '点击物件',\n    line: '水桶负责冷却过热的脑子，也负责装一些没地方放的吐槽。你可以把它当成随机入口。',\n    actions: [\n      { label: '随机吐槽', type: 'wander' },\n      { label: '老杨是谁', type: 'profile' },\n    ],\n  },\n  desk: {\n    name: '工作台 · 文档入口',\n    meta: '点击物件',\n    line: '这张桌子是飞书主页的影子：正式文档放外面，入口和上下文放这里。想了解合作方式，从这里开始。',\n    actions: [\n      { label: '找我协作', type: 'contact' },\n      { label: '看 iLoop', type: 'iloop' },\n    ],\n  },\n  forge: {\n    name: '火炉 · 欢迎语锻造机',\n    meta: '点击物件',\n    line: '火炉不讲道理，只负责把一句普通欢迎语烧得更像老杨。',\n    actions: [\n      { label: '锻造一句', type: 'forge' },\n      { label: '看 iLoop', type: 'iloop' },\n    ],\n  },\n};\n\nfunction pickRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }\n\nlet currentAudio = null;\nlet currentAudioKey = null;\nlet autoTalkTimer = null;\nlet bubbleTimer = null;\nlet bubbleKey = null;\nlet bubbleRoot = null;\nlet lastAutoTalkAt = 0;\nlet bgRoot = null;\nlet bgFitBase = null;\nlet furnaceFireMesh = null;\nlet fireVtxFrame = 0;   // 火焰顶点动画隔帧计数器（性能）\nlet furnaceFireBasePositions = null;\nlet forgePulseUntil = 0;\nlet dialogActions = [];\nlet selectedObjectKey = null;\nlet yqClickCount = 0;\nlet typedSecret = '';\n\nconst NPC_CONFIG = {\n  master:     { name: '老杨是谁', url: './assets/npc_master.glb',     position: [-3.15, 0, 2.95], scale: 1.0, color: 0x884422,\n                line: '欢迎来到老杨的铁匠铺，也可以叫我老羊。这里不写长篇介绍，直接看我怎么打铁。',\n                meta: '个人主页入口',\n                actions: [\n                  { label: '老杨是谁', type: 'profile' },\n                  { label: '看项目集', type: 'projects' },\n                ],\n                rotY: 0.05,                // 往前挪并更朝向镜头，避免被铁砧和底座挡住\n                prop: 'anvil' },\n  apprentice: { name: '最近在做什么',   url: './assets/npc_apprentice.glb', position: [2.2, 0, 1.0],   scale: 0.9, color: 0xaa6633,\n                line: '最近主要在搬 iLoop、iOS Agent、自闭环验证和工程治理这些砖。火候不一定优雅，但都得能跑。',\n                meta: '当前项目',\n                actions: [\n                  { label: '看最近项目', type: 'projects' },\n                  { label: '找我协作', type: 'contact' },\n                ],\n                rotY: -0.6,                // 侧身朝炉火\n                prop: 'bucket' },\n  yq:         { name: 'iLoop / YQ',         url: './assets/npc_yq.glb',         position: [0.3, 0, 3.2],   scale: 1.0, color: 0x2266aa,\n                line: '我负责把“AI 帮我看看”升级成“AI 自己跑证据闭环”。连点我几下可能会出事。',\n                meta: 'Agent 工作流',\n                actions: [\n                  { label: '看 iLoop', type: 'iloop' },\n                  { label: '触发彩蛋', type: 'yq_easter' },\n                ],\n                rotY: -0.2,                // 微微侧身\n                prop: 'desk' }             // 工作台承载主页/文档入口\n};\nconst BG_URL = './assets/bg_smithy.glb'; // 铁匠铺背景\n\n// ============== 基础场景 ==============\nconst canvas = document.getElementById('viewer');\nconst renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });\n// 性能：像素比封顶 1.75，避免 Retina/高分屏下 4~9 倍像素填充拖慢帧率（嵌入小窗时尤其无谓）\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.1;\nrenderer.outputColorSpace = THREE.SRGBColorSpace;\nrenderer.shadowMap.enabled = true;\n// 性能：基础 PCF 软阴影即可，PCFSoft 在小窗里几乎看不出差别但开销翻倍\nrenderer.shadowMap.type = THREE.PCFShadowMap;\nrenderer.shadowMap.autoUpdate = false;   // 静态场景：阴影只渲一次，之后冻结\nrenderer.shadowMap.needsUpdate = true;\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x0d0905);\nscene.fog = new THREE.Fog(0x0d0905, 8, 20);\n\n// 环境反射（让 PBR 材质有反射）\nconst pmrem = new THREE.PMREMGenerator(renderer);\nscene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;\n\nconst camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 100);\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"sed -n '500,900p' index.html","aggregated_output":"\nfunction getCameraPosition(distance = DEFAULT_CAMERA_DISTANCE, target = DEFAULT_CAMERA_TARGET) {\n  const x = target.x + Math.sin(CAMERA_YAW) * distance;\n  const z = target.z + Math.cos(CAMERA_YAW) * distance;\n  const y = target.y + Math.sin(CAMERA_PITCH) * distance * 0.6;\n  return new THREE.Vector3(x, y, z);\n}\n\ncamera.position.copy(getCameraPosition());\n\nconst controls = new OrbitControls(camera, canvas);\ncontrols.target.copy(DEFAULT_CAMERA_TARGET);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.08;\ncontrols.minDistance = 6;\ncontrols.maxDistance = 14;\ncontrols.enablePan = false;\ncontrols.minAzimuthAngle = -Infinity;\ncontrols.maxAzimuthAngle = Infinity;\ncontrols.minPolarAngle = 0.68;\ncontrols.maxPolarAngle = 1.42;\ncontrols.update();\n\n// ============== 灯光（铁匠铺炉火氛围）==============\nconst ambient = new THREE.AmbientLight(0xffaa66, 0.4);\nscene.add(ambient);\n\n// 主光：从前上方的暖黄\nconst keyLight = new THREE.DirectionalLight(0xffd9a0, 1.35);\nkeyLight.position.set(3, 5, 4);\nkeyLight.castShadow = true;\nkeyLight.shadow.mapSize.set(1024, 1024);\nkeyLight.shadow.camera.near = 1;\nkeyLight.shadow.camera.far = 20;\nkeyLight.shadow.camera.left = -5; keyLight.shadow.camera.right = 5;\nkeyLight.shadow.camera.top = 5;   keyLight.shadow.camera.bottom = -5;\nscene.add(keyLight);\n\n// 炉火光：主炉正前方的橙红\nconst fireLight = new THREE.PointLight(0xff6a2a, 2.2, 10, 1.7);\nfireLight.position.set(0, 1.75, 1.25);\nscene.add(fireLight);\n\n// 炉膛内部补一盏更集中的暖光\nconst furnaceCoreLight = new THREE.PointLight(0xffaa55, 1.4, 4.5, 2.0);\nfurnaceCoreLight.position.set(0, 1.45, 0.95);\nscene.add(furnaceCoreLight);\n\n// 右侧工作台补一点暖反射，避免只有中间亮\nconst benchFillLight = new THREE.PointLight(0xff8a45, 0.65, 6, 2.0);\nbenchFillLight.position.set(2.8, 1.2, 0.8);\nscene.add(benchFillLight);\n\n// 补光：背后冷蓝（拉对比）\nconst rimLight = new THREE.DirectionalLight(0x4477aa, 0.22);\nrimLight.position.set(-2, 3, -4);\nscene.add(rimLight);\n\n// ============== NPC 头顶氛围光（真 3D 光源，随模式调强弱）==============\n// 每个 NPC 头顶一盏暖色 PointLight；光源本身不可见，避免误读成对白气泡。\nconst npcHaloLights = {};   // key -> { light, glow }\nfunction createNpcHalo(key, position) {\n  const x = position[0], z = position[2];\n  const y = FLOOR_Y + 2.35;  // 头顶上方\n  const light = new THREE.PointLight(0xffb060, 0.0, 4.2, 2.0);\n  light.position.set(x, y, z);\n  scene.add(light);\n\n  // 保留占位 mesh 兼容模式切换逻辑，但不渲染出来。\n  const glow = new THREE.Mesh(\n    new THREE.SphereGeometry(0.07, 16, 16),\n    new THREE.MeshBasicMaterial({ color: 0xffcf8a, transparent: true, opacity: 0.0 })\n  );\n  glow.visible = false;\n  glow.position.set(x, y, z);\n  scene.add(glow);\n\n  npcHaloLights[key] = { light, glow };\n}\nObject.entries(NPC_CONFIG).forEach(([k, v]) => createNpcHalo(k, v.position));\n\n/* ============================================================\n   场景模式预设(状态定义需早于 animate() 渲染循环,避免 TDZ)\n   - calm  舒缓: 温馨柔光、弱火、NPC 静音(只冒泡)、舒缓 BGM、头顶柔和暖光\n   - forge 火炉: 强暖光、旺火、NPC 开口说话、酒馆 BGM、头顶强亮暖光\n   ============================================================ */\nconst SCENE_PRESETS = {\n  calm: {\n    label: '🕯️ 舒缓',\n    ambient: 0.34,\n    keyLight: 1.05,\n    fireBase: 1.3,        // 火光基准强度\n    furnaceFactor: 0.5,\n    haloIntensity: 0.85,  // 头顶氛围光\n    haloGlow: 0.0,\n    bg: 0x0d0905,\n    npcVoice: false,      // 静音,只冒泡\n    bgmStyle: 'calm',\n  },\n  forge: {\n    label: '🔥 火炉',\n    ambient: 0.52,\n    keyLight: 1.6,\n    fireBase: 2.7,\n    furnaceFactor: 0.75,\n    haloIntensity: 2.2,\n    haloGlow: 0.0,\n    bg: 0x140a05,\n    npcVoice: true,       // 开口说话\n    bgmStyle: 'tavern',\n  },\n};\nlet SCENE_MODE = 'calm';\nlet fireBaseIntensity = SCENE_PRESETS.calm.fireBase;   // 给火光闪烁动画当基准\n\n// ============== 地面（在背景 GLB 没加载前的兜底）==============\nconst ground = new THREE.Mesh(\n  new THREE.CircleGeometry(8, 64),\n  new THREE.MeshStandardMaterial({ color: 0x2a1a10, roughness: 0.9, metalness: 0.05 })\n);\nground.rotation.x = -Math.PI / 2;\nground.receiveShadow = true;\nscene.add(ground);\n\n// ============== 加载器 ==============\n// Draco 几何解压（压缩脚本 compress.sh 会用到 draco）\nconst dracoLoader = new DRACOLoader();\ndracoLoader.setDecoderPath('https://www.gstatic.com/draco/v1/decoders/');\n// KTX2 贴图解压（如果之后启用 ktx2 压缩，提前接好）\nconst ktx2Loader = new KTX2Loader();\nktx2Loader.setTranscoderPath('https://unpkg.com/three@0.160.0/examples/jsm/libs/basis/');\nktx2Loader.detectSupport(renderer);\n\nconst loader = new GLTFLoader();\nloader.setDRACOLoader(dracoLoader);\nloader.setKTX2Loader(ktx2Loader);\nloader.setMeshoptDecoder(MeshoptDecoder);\n\nconst npcs = {}; // { key: { root, originalEmissive, config } }\nconst interactiveObjects = {}; // { key: { root, config } }\nlet loadCount = 0;\nconst TOTAL = Object.keys(NPC_CONFIG).length + 1; // +1 for bg\ncreateHotspot('forge', [0, FLOOR_Y + 0.7, 1.05], [1.8, 1.5, 1.3]);\n\nfunction tickLoad() {\n  loadCount++;\n  if (loadCount >= TOTAL) {\n    document.getElementById('loader').classList.add('hide');\n    // 全部模型就位后渲一次阴影并冻结（静态场景无需逐帧更新阴影贴图）\n    renderer.shadowMap.needsUpdate = true;\n  }\n}\n\n// 加载背景\nloader.load(BG_URL, gltf => {\n  const bg = gltf.scene;\n  bgRoot = bg;\n  bg.traverse(o => { if (o.isMesh) { o.receiveShadow = true; o.castShadow = true; }});\n  const box = new THREE.Box3().setFromObject(bg);\n  const size = box.getSize(new THREE.Vector3());\n  bgFitBase = { x: size.x, z: size.z, minY: box.min.y };\n  const scale = DEFAULT_BG_SCALE / Math.max(size.x, size.z);\n  bg.scale.setScalar(scale);\n  bg.position.y = -box.min.y * scale;\n  scene.add(bg);\n  hideCoalPiles();\n  ground.visible = false;\n  tickLoad();\n}, undefined, () => {\n  console.warn('背景 GLB 未找到，使用兜底地面');\n  tickLoad();\n});\n\nfunction setCameraDistance(distance) {\n  camera.position.copy(getCameraPosition(distance, controls.target.clone()));\n  controls.update();\n}\n\nfunction resetOverview() {\n  animateCamera(getCameraPosition(DEFAULT_CAMERA_DISTANCE, DEFAULT_CAMERA_TARGET), DEFAULT_CAMERA_TARGET.clone(), 600);\n}\n\nfunction hideCoalPiles() {\n  if (!bgRoot) return;\n  bgRoot.traverse(o => {\n    if (!o.isMesh) return;\n    const name = (o.name || '').toLowerCase();\n    const matName = (o.material?.name || '').toLowerCase();\n    if (/coal|char|rock|stone|ember|pile/.test(name) || /coal|char|rock|stone|ember|pile/.test(matName)) {\n      o.visible = false;\n    }\n    if (!furnaceFireMesh && /fire|flame|ember|burn|lava/.test(name + ' ' + matName)) {\n      furnaceFireMesh = o;\n      if (o.geometry?.attributes?.position) {\n        furnaceFireBasePositions = o.geometry.attributes.position.array.slice();\n      }\n      if (o.material) {\n        o.material = o.material.clone();\n        if ('emissiveIntensity' in o.material) o.material.emissiveIntensity = 1.6;\n      }\n    }\n  });\n}\n\n// ============== T-pose 修正 ==============\n// 通过 bone 名字匹配两侧的\"上臂\",把手臂从水平 T 字旋转到自然下垂\nfunction fixTPose(root) {\n  const armKeywords = /(shoulder|upperarm|arm_l|arm_r|l_arm|r_arm|leftarm|rightarm|clavicle|hombro|arm$|shoulder_l|shoulder_r)/i;\n  let found = 0;\n  root.traverse(o => {\n    if (o.isBone && armKeywords.test(o.name)) {\n      // 大致把手臂沿 Z 轴向下转 70 度\n      const sign = /\\b(l|left|izq)/i.test(o.name) ? -1 : 1;\n      o.rotation.z += sign * Math.PI * 0.42;\n      found++;\n    }\n  });\n  return found > 0;\n}\n\n// ============== 道具：用基础几何体盖住手部 ==============\nfunction makeProp(type, npcPos) {\n  const g = new THREE.Group();\n  if (type === 'anvil') {\n    // 铁砧：黑铁色梯形 + 木墩\n    const base = new THREE.Mesh(\n      new THREE.CylinderGeometry(0.32, 0.4, 0.7, 12),\n      new THREE.MeshStandardMaterial({ color: 0x3a2818, roughness: 0.95 })\n    );\n    base.position.y = 0.35;\n    const anvil = new THREE.Mesh(\n      new THREE.BoxGeometry(0.9, 0.25, 0.35),\n      new THREE.MeshStandardMaterial({ color: 0x1a1a1e, roughness: 0.5, metalness: 0.7 })\n    );\n    anvil.position.y = 0.82;\n    g.add(base, anvil);\n    // 放在 NPC 前方挡住手\n    g.position.set(npcPos[0] + 0.6, 0, npcPos[2] + 0.5);\n    g.rotation.y = -Math.PI / 6;\n  } else if (type === 'bucket') {\n    // 水桶 + 抹布\n    const bucket = new THREE.Mesh(\n      new THREE.CylinderGeometry(0.22, 0.18, 0.4, 16),\n      new THREE.MeshStandardMaterial({ color: 0x5a3a1e, roughness: 0.9 })\n    );\n    bucket.position.y = 0.2;\n    const rag = new THREE.Mesh(\n      new THREE.SphereGeometry(0.12, 8, 6),\n      new THREE.MeshStandardMaterial({ color: 0x885533, roughness: 1.0 })\n    );\n    rag.position.set(0.1, 0.42, 0);\n    rag.scale.set(1.2, 0.4, 1.2);\n    g.add(bucket, rag);\n    g.position.set(npcPos[0] - 0.5, 0, npcPos[2] + 0.4);\n  } else if (type === 'desk') {\n    // 工作台 + 笔记本电脑\n    const desk = new THREE.Mesh(\n      new THREE.BoxGeometry(1.4, 0.08, 0.7),\n      new THREE.MeshStandardMaterial({ color: 0x4a2e1a, roughness: 0.85 })\n    );\n    desk.position.y = 0.9;\n    const leg = new THREE.MeshStandardMaterial({ color: 0x2e1a0e, roughness: 0.9 });\n    [[-0.6,-0.3],[0.6,-0.3],[-0.6,0.3],[0.6,0.3]].forEach(([x,z])=>{\n      const l = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.9,0.08), leg);\n      l.position.set(x, 0.45, z);\n      g.add(l);\n    });\n    const laptopBase = new THREE.Mesh(\n      new THREE.BoxGeometry(0.5, 0.03, 0.35),\n      new THREE.MeshStandardMaterial({ color: 0x1a1a1e, roughness: 0.4, metalness: 0.6 })\n    );\n    laptopBase.position.set(0, 0.96, 0);\n    const laptopScreen = new THREE.Mesh(\n      new THREE.BoxGeometry(0.5, 0.32, 0.02),\n      new THREE.MeshStandardMaterial({ color: 0x222226, emissive: 0x4488ff, emissiveIntensity: 0.4, roughness: 0.3 })\n    );\n    laptopScreen.position.set(0, 1.13, -0.16);\n    laptopScreen.rotation.x = -0.15;\n    g.add(desk, laptopBase, laptopScreen);\n    g.position.set(npcPos[0], 0, npcPos[2] + 0.5);\n    g.rotation.y = Math.PI; // 桌子面朝相机\n  }\n  g.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; }});\n  return g;\n}\n\nfunction registerInteractive(root, key, config = OBJECT_CONFIG[key]) {\n  if (!root || !config) return root;\n  root.userData.interactiveKey = key;\n  root.traverse?.(o => {\n    if (o.isMesh || o.isGroup) o.userData.interactiveKey = key;\n  });\n  interactiveObjects[key] = { root, config };\n  return root;\n}\n\nfunction createHotspot(key, position, size) {\n  const hit = new THREE.Mesh(\n    new THREE.BoxGeometry(size[0], size[1], size[2]),\n    new THREE.MeshBasicMaterial({ transparent: true, opacity: 0.0, depthWrite: false })\n  );\n  hit.position.set(position[0], position[1], position[2]);\n  hit.visible = true;\n  scene.add(hit);\n  return registerInteractive(hit, key);\n}\n\n// 加载 NPC\nfunction loadNPC(key, cfg) {\n  loader.load(cfg.url, gltf => {\n    const root = gltf.scene;\n    // 1. 归一化高度到 1.8m\n    let box = new THREE.Box3().setFromObject(root);\n    const size = box.getSize(new THREE.Vector3());\n    const scale = (1.8 / size.y) * cfg.scale;\n    root.scale.setScalar(scale);\n\n    // 2. 尝试修正 T-pose（如果模型有骨骼）\n    const rigged = fixTPose(root);\n    if (!rigged) {\n      // 没骨骼的兜底：整体微微前倾 3 度\n      root.rotation.x = 0.05;\n    }\n\n    // 3. 朝向\n    if (cfg.rotY !== undefined) root.rotation.y = cfg.rotY;\n\n    // 4. 重新计算 box 并把脚底贴地（FLOOR_Y 是背景地板的高度）\n    box = new THREE.Box3().setFromObject(root);\n    root.position.set(cfg.position[0], FLOOR_Y - box.min.y, cfg.position[2]);\n    root.userData.npcKey = key;\n    root.traverse(o => {\n      if (o.isMesh) {\n        o.castShadow = true;\n        o.receiveShadow = true;\n        o.userData.npcKey = key;\n      }\n    });\n    scene.add(root);\n\n    // 5. 加道具遮挡手部（只有 cfg.prop 非 null 时）\n    if (cfg.prop) {\n      const prop = makeProp(cfg.prop, cfg.position);\n      prop.position.y += FLOOR_Y; // 道具也抬到地板上\n      registerInteractive(prop, cfg.prop);\n      scene.add(prop);\n    }\n\n    npcs[key] = { root, config: cfg, baseY: root.position.y };\n    tickLoad();\n  }, undefined, () => {\n    console.warn(`${cfg.name} GLB 未找到,使用占位胶囊`);\n    const mesh = new THREE.Mesh(\n      new THREE.CapsuleGeometry(0.35, 1.0, 8, 16),\n      new THREE.MeshStandardMaterial({ color: cfg.color, roughness: 0.6 })\n    );\n    mesh.position.set(cfg.position[0], FLOOR_Y + 0.9, cfg.position[2]);\n    mesh.castShadow = true;\n    mesh.userData.npcKey = key;\n    scene.add(mesh);\n    if (cfg.prop) {\n      const prop = makeProp(cfg.prop, cfg.position);\n      prop.position.y += FLOOR_Y;\n      registerInteractive(prop, cfg.prop);\n      scene.add(prop);\n    }\n    npcs[key] = { root: mesh, config: cfg, baseY: mesh.position.y };\n    tickLoad();\n  });\n}\nObject.entries(NPC_CONFIG).forEach(([k, v]) => loadNPC(k, v));\n\n// ============== 交互：射线检测 hover/click ==============\nconst raycaster = new THREE.Raycaster();\nconst pointer = new THREE.Vector2();\nlet hoverKey = null;\nlet activeKey = null;\nconst hoverLabel = document.getElementById('hoverLabel');\nconst dialog = document.getElementById('dialog');\nconst npcBubble = document.getElementById('npcBubble');\nconst sidePanel = document.getElementById('sidePanel');\nconst panelToggle = document.getElementById('panelToggle');\n\nfunction pickTarget(event) {\n  pointer.x = (event.clientX / innerWidth) * 2 - 1;\n  pointer.y = -(event.clientY / innerHeight) * 2 + 1;\n  raycaster.setFromCamera(pointer, camera);\n  const roots = [\n    ...Object.values(npcs).map(n => n.root),\n    ...Object.values(interactiveObjects).map(o => o.root),\n  ].filter(Boolean);\n  const hits = raycaster.intersectObjects(roots, true);\n  for (const h of hits) {\n    let o = h.object;\n    while (o && !o.userData.npcKey && !o.userData.interactiveKey) o = o.parent;\n    if (o?.userData.npcKey) {\n      const key = o.userData.npcKey;\n      return { type: 'npc', key, label: NPC_CONFIG[key].name };\n    }\n    if (o?.userData.interactiveKey) {\n      const key = o.userData.interactiveKey;\n","exit_code":0,"status":"completed"}}
